---
import Ring from '../ui/Ring.astro';

interface Props {
  label: string;
  value: string;
  status: string;
  animate?: boolean;
  class?: string;
}
const { label, value, status, animate = false, class: cls } = Astro.props;
---

<!-- A real athlete-app component rendered in HTML, with fictional values. -->
<div class:list={['rcard', cls]}>
  <div class="rcard__head">
    <p class="rcard__label">{label}</p>
  </div>
  <div class="rcard__body">
    <p class="rcard__value num" data-countup={animate ? value : undefined}>{value}</p>
    <Ring value={Number(value)} size={72} stroke={8} animate={animate} duration={900} />
  </div>
  <p class="rcard__status"><span class="rcard__dot" aria-hidden="true"></span>{status}</p>
</div>

<style>
  .rcard {
    width: 252px;
    padding: 18px 22px 20px;
    border: 1px solid var(--pop-border);
    border-radius: var(--radius-card);
    background: var(--bg);
    box-shadow: var(--shadow-pop);
  }
  .rcard__label {
    color: var(--ink-2);
    font-size: 14px;
    line-height: 20px;
    font-weight: 500;
  }
  .rcard__body {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 4px;
  }
  .rcard__value {
    color: var(--ink);
    font-size: 56px;
    line-height: 64px;
    font-weight: 600;
    letter-spacing: -0.02em;
  }
  .rcard__status {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 4px;
    color: var(--ink-2);
    font-size: 15px;
    line-height: 20px;
  }
  .rcard__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--mint);
  }
</style>
