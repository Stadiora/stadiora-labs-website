---
interface Props {
  size?: number;
  class?: string;
}
const { size = 20, class: cls } = Astro.props;
---

<!-- The Stadiora mark, simplified: stadium ring, cyan orbit, one violet and two cyan dots. -->
<svg class={cls} viewBox="0 0 48 48" width={size} height={size} fill="none" aria-hidden="true" focusable="false">
  <ellipse cx="24" cy="24" rx="19" ry="10" transform="rotate(-24 24 24)" stroke="#00BEF3" stroke-width="2.5"></ellipse>
  <ellipse cx="24" cy="23" rx="9" ry="5.5" stroke="currentColor" stroke-width="4"></ellipse>
  <circle cx="39" cy="9" r="3.6" fill="#00BEF3"></circle>
  <circle cx="8" cy="30" r="3.6" fill="#8B5CF6"></circle>
  <circle cx="30" cy="36.5" r="3.2" fill="#00BEF3"></circle>
</svg>
