    | 'sun'
    | 'moon'
    | 'menu'
    | 'x'
    | 'plus'
    | 'minus'
    | 'sparkle'
    | 'send'
    | 'check'
    | 'pause'
    | 'play'
    | 'heart'
    | 'activity'
