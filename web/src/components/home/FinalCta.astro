---
import { useDict, type Locale } from '../../i18n';
import { site } from '../../data/site';
import StoreSheet from './StoreSheet.astro';

interface Props {
  locale: Locale;
  // Replaces the coach button, e.g. "Talk to us" on the custom-branded apps page.
  middle?: { label: string; href: string };
  // Replaces the booking link on the "Book a call for your school" button.
  callHref?: string;
}
const { locale, middle, callHref } = Astro.props;
const t = useDict(locale);
const c = t.cta;
---

<section class="band cta" aria-labelledby="cta-title">
  <div class="container cta__row">
    <h2 id="cta-title" class="cta__title h-lane">{c.title}</h2>
    <div class="cta__actions">
      <a class="btn btn--lg btn--white" href="#get-app" data-open-sheet>{c.download}</a>
      <a class="btn btn--lg btn--on-band" href={middle?.href ?? site.signUp}>{middle?.label ?? c.coach}</a>
      <a class="btn btn--lg btn--on-band" href={callHref ?? site.booking} rel={callHref ? undefined : 'noopener'}>{c.school}</a>
    </div>
  </div>

  <StoreSheet locale={locale} />
</section>

<style>
  .cta {
    padding-block: 72px 64px;
    background: var(--band);
    color: var(--band-ink);
  }
  .cta__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px 48px;
  }
  .cta__title {
    flex: 1 1 380px;
    color: var(--band-ink);
    font-size: clamp(34px, 4vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }

  @media (max-width: 720px) {
    .cta {
      padding-block: 56px 48px;
    }
    .cta__actions {
      width: 100%;
      flex-direction: column;
    }
    .cta__actions .btn {
      width: 100%;
    }
  }
</style>
