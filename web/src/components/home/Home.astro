---
import type { Locale } from '../../i18n';
import Hero from './Hero.astro';
import LogoStrip from './LogoStrip.astro';
import AiProgram from './AiProgram.astro';
import Pillars from './Pillars.astro';
import PopOut from './PopOut.astro';
import Messaging from './Messaging.astro';
import BrandMoment from './BrandMoment.astro';
import BrandedApps from './BrandedApps.astro';
import Testimonials from './Testimonials.astro';
import FinalCta from './FinalCta.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Hero locale={locale} />
<LogoStrip locale={locale} />
<AiProgram locale={locale} />
<Pillars locale={locale} />
<section class="section engage" aria-labelledby="messaging-title">
  <div class="container engage__grid">
    <PopOut locale={locale} />
    <Messaging locale={locale} />
  </div>
</section>
<BrandMoment locale={locale} />
<BrandedApps locale={locale} />
<Testimonials locale={locale} />
<FinalCta locale={locale} />

<style>
  .engage__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr);
    gap: clamp(40px, 5vw, 88px);
    align-items: start;
  }
  @media (max-width: 1180px) {
    .engage__grid {
      grid-template-columns: 1fr;
      gap: 72px;
    }
  }
</style>
