---
import type { Locale } from '../../i18n';
import Hero from './Hero.astro';
import AiProgram from './AiProgram.astro';
import Pillars from './Pillars.astro';
import BrandStrip from './BrandStrip.astro';
import Showcase from './Showcase.astro';
import Proof from './Proof.astro';
import FinalReel from './FinalReel.astro';
import StoreSheet from './StoreSheet.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Hero locale={locale} />
<AiProgram locale={locale} />
<Pillars locale={locale} />
<BrandStrip locale={locale} />
<Showcase locale={locale} />
<Proof locale={locale} />
<FinalReel locale={locale} />
<StoreSheet locale={locale} />

<script>
  import '../../scripts/home';
</script>
