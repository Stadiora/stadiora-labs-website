---
import { useDict, type Locale } from '../../i18n';
import Phone from '../ui/Phone.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const m = t.messaging;
const tabs = ['chat', 'feed', 'broadcast', 'announcements'] as const;
---

<div class="msg" data-tabs data-reveal style="--reveal-i:1">
  <h2 id="messaging-title" class="h-lane">{m.title}</h2>
  <p class="msg__sub">{m.sub}</p>

  <div class="tabs msg__tabs" role="tablist" aria-label={m.tabsLabel}>
    {
      tabs.map((id, i) => (
        <button
          class="tab"
          type="button"
          role="tab"
          id={`msg-tab-${id}`}
          aria-controls={`msg-panel-${id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          data-text={m.tabs[id]}
        >
          {m.tabs[id]}
        </button>
      ))
    }
    <span class="tabs__lane" aria-hidden="true"></span>
  </div>

  <Phone class="msg__phone" decorative={false}>
    <div class="msg__track">
      <div class="msg__screen" role="tabpanel" id="msg-panel-chat" aria-labelledby="msg-tab-chat">
        <div class="chat__head">
          <Icon name="chevron-left" size={16} />
          <span class="avatar">D</span>
          <div>
            <p class="chat__name">{m.chat.name}</p>
            <p class="chat__status">{m.chat.status}</p>
          </div>
        </div>
        <div class="chat__body">
          <p class="chat__day">{m.chat.today}</p>
          <div class="bubble bubble--in"><p>{m.chat.m1}</p><span>8:12 AM</span></div>
          <div class="bubble bubble--out"><p>{m.chat.m2}</p><span>8:15 AM</span></div>
          <div class="bubble bubble--in"><p>{m.chat.m3}</p><span>8:17 AM</span></div>
        </div>
        <div class="chat__input">
          <span class="chat__plus"><Icon name="plus" size={14} /></span>
          <span class="chat__field">{m.chat.placeholder}</span>
          <Icon name="send" size={16} />
        </div>
      </div>

      <div class="msg__screen" role="tabpanel" id="msg-panel-feed" aria-labelledby="msg-tab-feed" inert>
        <div class="chat__head">
          <Icon name="chevron-left" size={16} />
          <p class="chat__name">{m.feed.team}</p>
        </div>
        <article class="post">
          <header class="post__head">
            <span class="avatar">D</span>
            <div>
              <p class="chat__name">{m.feed.author}</p>
              <p class="chat__status">{m.feed.time}</p>
            </div>
          </header>
          <p class="post__text">{m.feed.post}</p>
          <div class="post__photo" role="img" aria-label={m.feed.photoAlt}>
            <i></i><i></i><i></i><i></i>
          </div>
          <p class="post__react"><Icon name="heart" size={16} /><span class="num">{m.feed.likes}</span></p>
        </article>
      </div>

      <div class="msg__screen" role="tabpanel" id="msg-panel-broadcast" aria-labelledby="msg-tab-broadcast" inert>
        <div class="chat__head">
          <Icon name="chevron-left" size={16} />
          <p class="chat__name">{m.broadcast.to}</p>
        </div>
        <div class="chat__body">
          <div class="bubble bubble--out bubble--lg"><p>{m.broadcast.message}</p></div>
          <p class="sent"><Icon name="check" size={14} />{m.broadcast.sent}</p>
        </div>
      </div>

      <div class="msg__screen" role="tabpanel" id="msg-panel-announcements" aria-labelledby="msg-tab-announcements" inert>
        <div class="chat__head">
          <Icon name="chevron-left" size={16} />
          <p class="chat__name">{m.tabs.announcements}</p>
        </div>
        <article class="notice">
          <p class="notice__pin"><Icon name="pin" size={14} />{m.announcements.pinned}</p>
          <h3 class="notice__title">{m.announcements.title}</h3>
          <p class="notice__body">{m.announcements.body}</p>
          <p class="notice__from">{m.announcements.from}</p>
        </article>
      </div>
    </div>
  </Phone>
  <p class="demo-note msg__note">{m.demoNote}</p>
</div>

<style>
  .msg {
    min-width: 0;
  }
  .msg__sub {
    margin-top: 12px;
    color: var(--ink-2);
    font-size: 22px;
    line-height: 32px;
  }
  .msg__tabs {
    margin-top: 28px;
  }
  .msg__tabs :global(.tab) {
    padding-inline: 10px;
    font-size: 16px;
  }
  .msg :global(.msg__phone) {
    --phone-w: clamp(272px, 24vw, 328px);
    margin: 28px auto 0;
  }
  .msg :global(.phone__screen) {
    background: var(--bg);
  }
  .msg__track {
    display: flex;
    flex: 1;
    width: 400%;
    min-height: 0;
    transform: translateX(calc(var(--tab-i, 0) * -25%));
    transition: transform 0.25s var(--ease-out);
  }
  .msg__screen {
    display: flex;
    flex-direction: column;
    width: 25%;
    min-width: 0;
    height: 100%;
    padding: 0 0.9em 0.9em;
  }
  html:not(.js) .msg .tabs {
    display: none;
  }

  .chat__head {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.7em 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9em;
  }
  .chat__name {
    font-weight: 600;
    font-size: 0.95em;
    line-height: 1.2;
  }
  .chat__status {
    color: var(--ink-2);
    font-size: 0.8em;
  }
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    background: var(--cyan-tint);
    color: var(--cyan-ink);
    font-size: 0.85em;
    font-weight: 700;
  }
  .chat__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.7em;
    padding-top: 0.9em;
    min-height: 0;
  }
  .chat__day {
    align-self: center;
    color: var(--ink-3);
    font-size: 0.78em;
  }
  .bubble {
    max-width: 82%;
    font-size: 0.86em;
  }
  .bubble p {
    padding: 0.6em 0.8em;
    border-radius: 0.9em;
  }
  .bubble span {
    display: block;
    margin-top: 0.2em;
    color: var(--ink-3);
    font-size: 0.8em;
  }
  .bubble--in {
    align-self: flex-start;
  }
  .bubble--in p {
    background: var(--surface);
  }
  .bubble--out {
    align-self: flex-end;
    text-align: right;
  }
  .bubble--out p {
    background: var(--cyan-tint);
    text-align: left;
  }
  .bubble--lg {
    max-width: 90%;
    font-size: 1em;
  }
  .sent {
    display: flex;
    align-items: center;
    gap: 0.4em;
    align-self: flex-end;
    color: var(--mint-ink);
    font-size: 0.8em;
    font-weight: 500;
  }
  .chat__input {
    display: flex;
    align-items: center;
    gap: 0.6em;
    color: var(--ink-3);
    font-size: 0.78em;
  }
  .chat__plus {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.2em;
    height: 2.2em;
    border: 1px solid var(--line);
    border-radius: 50%;
  }
  .chat__field {
    flex: 1;
    padding: 0.7em 1em;
    border: 1px solid var(--line);
    border-radius: 2em;
    background: var(--surface);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .post {
    display: grid;
    gap: 0.7em;
    margin-top: 0.9em;
    padding: 0.8em;
    border: 1px solid var(--line);
    border-radius: 0.9em;
    font-size: 0.9em;
  }
  .post__head {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }
  .post__photo {
    position: relative;
    height: 7.4em;
    overflow: hidden;
    border-radius: 0.7em;
    background: linear-gradient(160deg, #c9794e, #a95a36);
  }
  /* Track lanes drawn in CSS: a stand-in for the team photo. */
  .post__photo i {
    position: absolute;
    left: -10%;
    right: -10%;
    height: 2px;
    background: rgb(255 255 255 / 0.7);
    transform: rotate(-12deg);
  }
  .post__photo i:nth-child(1) {
    top: 20%;
  }
  .post__photo i:nth-child(2) {
    top: 42%;
  }
  .post__photo i:nth-child(3) {
    top: 64%;
  }
  .post__photo i:nth-child(4) {
    top: 86%;
  }
  .post__react {
    display: flex;
    align-items: center;
    gap: 0.4em;
    color: var(--ink-2);
  }
  .post__react :global(svg) {
    color: #e0457b;
  }

  .notice {
    margin-top: 0.9em;
    padding: 1em;
    border: 1px solid var(--cyan);
    border-radius: 0.9em;
    background: var(--cyan-tint);
    font-size: 0.9em;
  }
  .notice__pin {
    display: flex;
    align-items: center;
    gap: 0.4em;
    color: var(--cyan-ink);
    font-size: 0.8em;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }
  .notice__title {
    margin-top: 0.5em;
    font-family: var(--font-display);
    font-size: 1.15em;
    line-height: 1.2;
    font-weight: 600;
  }
  .notice__body {
    margin-top: 0.5em;
    line-height: 1.4;
  }
  .notice__from {
    margin-top: 0.8em;
    color: var(--ink-3);
    font-size: 0.8em;
  }
  .msg__note {
    text-align: center;
  }
  @media (max-width: 720px) {
    .msg__sub {
      font-size: 18px;
      line-height: 26px;
    }
  }
</style>

<script>
  import '../../scripts/tabs';
</script>
