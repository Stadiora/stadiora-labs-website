---
import '../../styles/home/hero.css';
import type { Locale } from '../../i18n';
import { site } from '../../data/site';
import LogoMarquee from '../ui/LogoMarquee.astro';
import { contactHref } from '../../lib/links';
import { homeHero } from '../../i18n/pages/home-hero';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = homeHero[locale];

const IMG = '/home/img/';
const MEDIA = '/home/media/';
const slugs = ['hero1-coaches', 'hero2-high-school-teams', 'hero3-soccer-academies', 'hero4-track-and-field', 'hero5-gyms-and-studios', 'hero6-nutrition-coaches', 'hero7-universities'];

// Centre lane: [clone of the last block] + 7 blocks + [clones of the first two], so the step after the last word keeps going down.
const blocks = [slugs.length - 1, ...slugs.map((_, i) => i), 0, 1];
const ACTIVE = 1;

// Side lanes loop three copies of their tiles (the run moves by exactly one copy). The only clip is the chalk tile in copy 0;
// every other tile of it shows the poster, so at most one clip decodes in the hero.
interface SideTile {
  src: string;
  shape: 'sq' | 'p45';
  w: number;
  h: number;
  clip?: string;
  tag?: boolean;
}
const laneA: SideTile[] = [
  { src: `${IMG}bd-coach-cyan-800.webp`, shape: 'p45', w: 800, h: 1200 },
  { src: `${IMG}cv-bowl-flash-480.webp`, shape: 'sq', w: 480, h: 480 },
  { src: `${MEDIA}tile-chalk.webp`, shape: 'p45', w: 480, h: 600, clip: 'tile-chalk', tag: true },
  { src: `${IMG}hero5-gyms-and-studios-tile-1x1-480.webp`, shape: 'sq', w: 480, h: 480 },
  { src: `${IMG}bd-soccer-mint-800.webp`, shape: 'p45', w: 800, h: 1200 },
  { src: `${IMG}hero6-nutrition-coaches-tile-1x1-480.webp`, shape: 'sq', w: 480, h: 480 },
];
const laneB: SideTile[] = [
  { src: `${IMG}cv-spikes-480.webp`, shape: 'sq', w: 480, h: 720 },
  { src: `${IMG}bd-sprinter-violet-800.webp`, shape: 'p45', w: 800, h: 1200 },
  { src: `${IMG}hero2-high-school-teams-tile-1x1-480.webp`, shape: 'sq', w: 480, h: 480 },
  { src: `${MEDIA}tile-hurdler.webp`, shape: 'p45', w: 480, h: 600 },
  { src: `${IMG}hero3-soccer-academies-tile-1x1-480.webp`, shape: 'sq', w: 480, h: 480 },
  { src: `${IMG}bd-jumper-flare-800.webp`, shape: 'p45', w: 800, h: 1200 },
];
const copies = [0, 1, 2];

// The first word, split into letters exactly the way hero.ts builds the next ones (letter index k colours the word along the gradient).
function split(word: string) {
  let k = 0;
  const parts = word.split(' ').map((part, i) => {
    const sp = i > 0 ? k : -1;
    const letters = [...part].map((ch) => ({ ch, k: k++ }));
    return { sp, letters };
  });
  return { m: Math.max(k - 1, 1), parts };
}
const first = split(t.words[0]);
---

<section class="hero impact" id="hero" data-section aria-labelledby="hero-h">
  <div class="mesh" aria-hidden="true">
    <i class="b b5"></i><i class="b b1"></i><i class="b b2"></i><i class="b b3"></i><i class="b b4"></i><i class="vig"></i>
  </div>
  <div class="orbits" aria-hidden="true">
    <svg viewBox="0 0 1600 800"><ellipse cx="800" cy="400" rx="760" ry="250"></ellipse><ellipse class="dash" cx="800" cy="400" rx="620" ry="190"></ellipse><ellipse cx="800" cy="400" rx="470" ry="140"></ellipse></svg>
  </div>

  <div class="hero-cv" aria-hidden="true" data-hero-cv>
    <div class="hero-lane" data-clip-window="y">
      <div class="hero-run">
        {
          copies.map((c) =>
            laneA.map((tile, i) => (
              <div class={`hero-tile ${tile.shape}`}>
                {tile.clip && c === 0 ? (
                  <video muted playsinline loop preload="none" data-clip data-ap-within="#hero .hero-copy" poster={tile.src} width={tile.w} height={tile.h}>
                    <source src={`${MEDIA}${tile.clip}.webm`} type="video/webm" />
                    <source src={`${MEDIA}${tile.clip}.mp4`} type="video/mp4" />
                  </video>
                ) : (
                  <img src={tile.src} alt="" width={tile.w} height={tile.h} loading={c === 0 && i < 2 ? 'eager' : 'lazy'} decoding="async" />
                )}
                {tile.tag && <span class="hero-tag">● {t.live}</span>}
              </div>
            )),
          )
        }
      </div>
    </div>
    <div class="hero-lane hero-mid" data-clip-window="y">
      <div class="hero-col" data-hero-col>
        {
          blocks.map((j, bi) => (
            <>
              <div class:list={['hero-tile', 'sm', 'sq', { on: bi === ACTIVE }]}>
                <img src={`${IMG}${slugs[j]}-tile-1x1-480.webp`} alt="" width="480" height="480" loading={bi === ACTIVE ? 'eager' : 'lazy'} decoding="async" />
              </div>
              <div class:list={['hero-tile', 'big', { on: bi === ACTIVE }]} data-big>
                <img
                  src={`${IMG}${slugs[j]}-big-560.webp`}
                  alt=""
                  width="560"
                  height="700"
                  loading={bi === ACTIVE || bi === ACTIVE + 1 ? 'eager' : 'lazy'}
                  fetchpriority={bi === ACTIVE ? 'high' : undefined}
                  decoding="async"
                />
                <i class="hero-sweep"></i>
              </div>
              <div class:list={['hero-tile', 'sm', 'p45', { on: bi === ACTIVE }]}>
                <img src={`${IMG}${slugs[j]}-tile-4x5-480.webp`} alt="" width="480" height="600" loading={bi === ACTIVE ? 'eager' : 'lazy'} decoding="async" />
              </div>
            </>
          ))
        }
      </div>
    </div>
    <div class="hero-lane" data-clip-window="y">
      <div class="hero-run down">
        {
          copies.map((c) =>
            laneB.map((tile, i) => (
              <div class={`hero-tile ${tile.shape}`}>
                <img src={tile.src} alt="" width={tile.w} height={tile.h} loading={c === 0 && i < 2 ? 'eager' : 'lazy'} decoding="async" />
              </div>
            )),
          )
        }
      </div>
    </div>
  </div>

  <div class="hero-chip hero-chip--ready pop" data-depth="18" aria-hidden="true">
    <div class="hero-ready">
      <div class="dring" style="--v:82"></div>
      <div>
        <small>{t.ready.label}</small>
        <div class="big fnum"><span class="count" style="--to:82;--cd:1.6s"></span></div>
        <div class="st"><i class="dot-live"></i>{t.ready.status}</div>
      </div>
    </div>
  </div>
  <div class="hero-chip hero-chip--toast glass" data-depth="30" aria-hidden="true">
    <div class="hero-toast">
      <span class="ic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg></span>
      <div class="tx" data-toast data-toasts={JSON.stringify(t.toasts)}><b>{t.toasts[0].title}</b><span>{t.toasts[0].text}</span></div>
    </div>
  </div>

  <div class="wrap hero-grid">
    <div class="hero-copy" data-hero-copy>
      <p class="eyebrow">{t.eyebrow}</p>
      <h1 class="d hero-h1" id="hero-h">
        <span class="sr">{t.title}</span>
        <span aria-hidden="true">
          <span class="hero-ln">{t.lead[0]}</span>
          <span class="hero-ln">{t.lead[1]}</span>
          <span class="hero-slot" data-hero-words data-hero-count={t.words.length} data-words={JSON.stringify(t.words)}>
            <span class="hero-w" data-hero-word data-word-index="0" data-active style={`--m:${first.m}`}>
              {
                first.parts.map((p) => (
                  <>
                    {p.sp >= 0 && <span class="hero-sp" style={`--k:${p.sp}`}>{'\u00a0'}</span>}
                    <span class="hero-part">
                      {p.letters.map((l) => (
                        <span class="hero-ch" style={`--k:${l.k}`}>
                          {l.ch}
                        </span>
                      ))}
                    </span>
                  </>
                ))
              }
            </span>
          </span>
        </span>
      </h1>
      <p class="lead">{t.sub}</p>
      <div class="hero-ctas">
        <a class="btn btn--white btn--lg" href={site.signUp}>{t.start} <span class="arr" aria-hidden="true">→</span></a>
        <a class="btn btn--ghost btn--lg" href={contactHref(locale, 'call')}>{t.call}</a>
      </div>
      <p class="hero-note"><i class="dot-live"></i>{t.note}</p>
    </div>
  </div>

  <div class="hero-band">
    <div class="wrap hero-band-in">
      <div class="hero-cp"><small>{t.customers.label}</small></div>
      <LogoMarquee class="hero-logos" label={t.customers.listLabel} />
    </div>
  </div>
</section>
