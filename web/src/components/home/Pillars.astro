---
import '../../styles/home/pillars.css';
import '../../styles/home/stage.css';
import type { Locale } from '../../i18n';
import { hrefFor } from '../../data/nav';
import { homePillars } from '../../i18n/pages/home-pillars';
import PillarScenes from './PillarScenes.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = homePillars[locale];

const pillars = [
  { key: 'training', route: 'programs', color: '#00BEF3' },
  { key: 'nutrition', route: 'nutrition', color: '#34D399' },
  { key: 'readiness', route: 'readiness', color: '#8B5CF6' },
  { key: 'team', route: 'teams', color: '#FF4D5E' },
] as const;
---

<section class="sec pillars" id="pillars" data-section aria-labelledby="pil-h">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow rv">{t.eyebrow}</p>
        <h2 class="d d2 lines" id="pil-h">
          {
            t.title.map((line, i) => (
              <>
                <span>
                  <span style={`--i:${i}`}>{line}</span>
                </span>{' '}
              </>
            ))
          }
        </h2>
      </div>
    </div>

    <div class="pil-grid" data-autotabs data-at="7000">
      <div class="pil-list">
        <div class="pil-tabs" role="tablist" aria-orientation="vertical" aria-label={t.tablistLabel}>
          {
            pillars.map((p, k) => (
              <button
                type="button"
                class="pil-tab"
                role="tab"
                id={`pil-tab-${k}`}
                aria-selected={k === 0 ? 'true' : 'false'}
                aria-controls={`pil-panel-${k}`}
                tabindex={k === 0 ? 0 : -1}
                data-color={p.color}
                style={`--k:${k}`}
              >
                <span class="at-bar" aria-hidden="true"><i></i></span>
                <span class="hd">
                  <em aria-hidden="true">{`0${k + 1}`}</em>
                  <strong>{t.items[k].tab}</strong>
                </span>
              </button>
            ))
          }
        </div>
        {
          pillars.map((p, k) => (
            <div class={`pil-panel${k === 0 ? ' on' : ''}`} role="tabpanel" id={`pil-panel-${k}`} aria-labelledby={`pil-tab-${k}`} style={`--k:${k}`}>
              <div>
                <p>{t.items[k].text}</p>
                <a class="link-arrow" href={hrefFor(p.route, locale)}>
                  {t.learnMore}
                  <span class="sr">{`: ${t.items[k].tab}`}</span>
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </div>
          ))
        }
      </div>
      <div class="pil-media rv" style="--pc:#00BEF3" aria-hidden="true">
        {
          pillars.map((p, k) => (
            <div class={`pil-clip${k === 0 ? ' on' : ''}`} data-panel>
              <video muted playsinline loop preload="none" data-clip data-poster={`/home/media/pillar-${p.key}.webp`} tabindex="-1">
                <source src={`/home/media/pillar-${p.key}.webm`} type="video/webm" />
                <source src={`/home/media/pillar-${p.key}.mp4`} type="video/mp4" />
              </video>
            </div>
          ))
        }
        <div class="stage-fit" data-fit="1280">
          <div class="stage pm-stage">
            <PillarScenes t={t} />
          </div>
        </div>
      </div>
    </div>
    <p class="dnote">{t.demoNote}</p>
  </div>
</section>
