---
import { useDict, type Locale } from '../../i18n';
import { hrefFor } from '../../data/nav';
import { retroSlots } from '../../data/photos';
import Photo from '../ui/Photo.astro';
import Mark from '../ui/Mark.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const b = t.brand;

// Where the mark sits in each square print, as a horizontal object-position for the portrait crop.
const focus = [70, 50, 40, 70, 25, 60, 35, 35];
---

<section class="section brand" aria-labelledby="brand-title">
  <div class="brand__grid container">
    <div class="brand__copy" data-reveal>
      <h2 id="brand-title" class="brand__title">
        <span>{b.lines[0]}</span>
        <span class="lane-under">{b.lines[1]}</span>
        <span>{b.lines[2]}</span>
      </h2>
      <p class="brand__sub">{b.sub}</p>
      <a class="fit" href={hrefFor('solutions', locale)}>
        <span class="fit__label">
          <Mark size={20} class="fit__mark" />
          {b.cta}
        </span>
        <span class="fit__arrow" aria-hidden="true"><Icon name="arrow-right" size={20} /></span>
      </a>
    </div>

    <div class="brand__stack" data-reveal style="--reveal-i:1">
      <div class="retro" role="group" aria-label={b.stackLabel} data-retro>
        {
          retroSlots.map((slot, i) => (
            <figure class="retro__card" data-pos={i} style={`--fx:${focus[i]}%`}>
              <div class="retro__paper">
                <div class="retro__img">
                  <Photo slot={slot} ratio="4/7" sizes="(max-width: 720px) 62vw, 440px" widths={[480, 720, 960]} />
                </div>
              </div>
            </figure>
          ))
        }
      </div>
      <button
        class="retro__pause"
        type="button"
        aria-pressed="false"
        aria-label={t.a11y.pauseStack}
        data-label-pause={t.a11y.pauseStack}
        data-label-play={t.a11y.playStack}
        data-retro-pause
      >
        <Icon name="pause" size={18} class="retro__pause-pause" />
        <Icon name="play" size={18} class="retro__pause-play" />
      </button>
    </div>
  </div>
</section>

<style>
  .brand {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--surface);
  }
  /* Paper grain: a tiny tiled noise PNG at 4% opacity. */
  .brand::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: url('../../assets/brand/noise.png') repeat;
    opacity: 0.04;
    pointer-events: none;
  }
  :root[data-theme='dark'] .brand::before {
    filter: invert(1);
  }
  .brand__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(20px, 2vw, 32px);
    align-items: center;
  }
  .brand__title {
    font-size: clamp(44px, 5.9vw, 86px);
    line-height: 1.02;
    letter-spacing: -0.03em;
  }
  .brand__title span {
    display: block;
    width: fit-content;
  }
  .brand__sub {
    margin-top: 28px;
    max-width: 30em;
    color: var(--ink-2);
    font-size: 22px;
    line-height: 32px;
  }

  .fit {
    display: inline-flex;
    align-items: stretch;
    margin-top: 36px;
    min-height: 60px;
    border-radius: var(--radius-ctl);
    color: var(--ink);
    font-size: 20px;
    font-weight: 600;
    text-decoration: none;
    overflow: hidden;
    box-shadow: 0 0 0 1.5px var(--ink) inset;
  }
  .fit__label {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 0 26px;
    background: linear-gradient(var(--cyan), var(--cyan)) no-repeat left / 0% 100%;
    transition:
      background-size 0.35s var(--ease-out),
      color 0.2s;
  }
  .fit :global(.fit__mark) {
    color: var(--ink);
    transition:
      transform 0.35s var(--ease-out),
      color 0.2s;
  }
  .fit__arrow {
    display: grid;
    place-items: center;
    width: 64px;
    background: var(--btn-bg);
    color: var(--btn-ink);
  }
  .fit__arrow :global(svg) {
    transition: transform 0.2s var(--ease-out);
  }
  .fit:hover .fit__label,
  .fit:focus-visible .fit__label {
    background-size: 100% 100%;
    color: #08132b;
  }
  .fit:hover :global(.fit__mark),
  .fit:focus-visible :global(.fit__mark) {
    color: #08132b;
    transform: rotate(12deg);
  }
  .fit:hover .fit__arrow :global(svg),
  .fit:focus-visible .fit__arrow :global(svg) {
    transform: translateX(4px);
  }

  /* Retro stack: five portrait cream cards fanned to the right, as in the mock. data-pos 0 is the front card.
     Offsets are in card widths (--x) and card heights (--y); --k compresses the fan on narrow screens. */
  .brand__stack {
    position: relative;
    justify-self: end;
    width: 100%;
    max-width: 940px;
    /* Let the fan run to the viewport edge, like the mock. */
    margin-right: calc(16px - (100vw - min(100vw - 2 * var(--gutter), var(--content-max))) / 2);
    --k: 1;
  }
  .retro {
    position: relative;
    aspect-ratio: 1.5 / 1;
  }
  .retro__card {
    position: absolute;
    left: 1%;
    top: 7%;
    width: 33.5%;
    margin: 0;
    transform: translate(calc(var(--x) * var(--k) * 100%), calc(var(--y) * 100%)) rotate(var(--rot));
    z-index: calc(10 - var(--p));
    opacity: var(--o, 1);
    transition:
      transform 0.4s var(--ease-out),
      opacity 0.4s ease;
  }
  .retro__card[data-pos='0'] {
    --p: 0;
    --x: 0;
    --y: 0.04;
    --rot: -8deg;
  }
  .retro__card[data-pos='1'] {
    --p: 1;
    --x: 0.58;
    --y: 0.03;
    --rot: 1deg;
  }
  .retro__card[data-pos='2'] {
    --p: 2;
    --x: 0.9;
    --y: -0.02;
    --rot: 6deg;
  }
  .retro__card[data-pos='3'] {
    --p: 3;
    --x: 1.43;
    --y: 0.07;
    --rot: 11deg;
  }
  .retro__card[data-pos='4'] {
    --p: 4;
    --x: 1.95;
    --y: 0.1;
    --rot: 14deg;
  }
  .retro__card[data-pos='5'],
  .retro__card[data-pos='6'],
  .retro__card[data-pos='7'] {
    --p: 5;
    --x: 1.95;
    --y: 0.1;
    --rot: 14deg;
    --o: 0;
  }
  .retro__card.is-lift {
    --y: -0.06;
    --rot: -3deg;
    transition-duration: 0.2s;
  }
  .retro__paper {
    padding: 4.5%;
    border-radius: 8px;
    background:
      radial-gradient(circle at 20% 15%, rgb(120 90 40 / 0.1), transparent 55%),
      radial-gradient(circle at 85% 90%, rgb(120 90 40 / 0.14), transparent 50%), #f1e6cf;
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 18px 40px rgb(8 19 43 / 0.24);
  }
  :root[data-theme='dark'] .retro__paper {
    outline: 1px solid var(--line);
  }
  .retro__img {
    position: relative;
    overflow: hidden;
    border-radius: 2px;
  }
  /* The prints carry their own cream border; scaling trims it so only the card paper shows. */
  .retro__img :global(img) {
    transform: scale(1.06);
    object-position: var(--fx, 50%) 50%;
  }
  /* Halftone dots over the print. */
  .retro__img::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(rgb(60 40 10 / 0.16) 0.6px, transparent 0.8px) 0 0 / 4px 4px;
    mix-blend-mode: multiply;
    pointer-events: none;
  }

  .retro__pause {
    position: absolute;
    right: 0;
    bottom: 0;
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--bg);
    color: var(--ink-2);
    cursor: pointer;
  }
  .retro__pause:hover {
    color: var(--ink);
  }
  .retro__pause :global(.retro__pause-play),
  .retro__pause[aria-pressed='true'] :global(.retro__pause-pause) {
    display: none;
  }
  .retro__pause[aria-pressed='true'] :global(.retro__pause-play) {
    display: block;
  }
  html:not(.js) .retro__pause {
    display: none;
  }

  /* Reduced motion keeps the fan static: all five cards stay put, nothing cycles. */
  @media (prefers-reduced-motion: reduce) {
    .retro__card {
      transition: none;
    }
    .retro__pause {
      display: none;
    }
  }

  @media (max-width: 900px) {
    .brand__grid {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .brand__stack {
      justify-self: center;
      margin-right: 0;
      max-width: 720px;
    }
  }
  @media (max-width: 720px) {
    .brand__sub {
      font-size: 18px;
      line-height: 26px;
    }
    .brand__stack {
      --k: 0.62;
    }
    .retro {
      aspect-ratio: 1.1 / 1;
    }
    .retro__card {
      left: 2%;
      width: 46%;
    }
  }
</style>

<script>
  import '../../scripts/retro';
</script>
