---
import '../../styles/home/stage.css';
import '../../styles/home/ai.css';
import type { Locale } from '../../i18n';
import { homeAi } from '../../i18n/pages/home-ai';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = homeAi[locale];
const s = t.stage;

type SessionKey = keyof typeof s.sessions;
interface Session {
  id: string;
  key: SessionKey;
  sets: number;
  metres: number;
  color: string;
  day: number;
}
// Two weeks of the Sprint group calendar. Day 0 is Monday.
const plan: Session[][] = [
  [
    { id: 's1', key: 'acceleration', sets: 6, metres: 30, color: '#00BEF3', day: 0 },
    { id: 's2', key: 'tempo', sets: 6, metres: 200, color: '#34D399', day: 1 },
    { id: 's3', key: 'speedEndurance', sets: 3, metres: 300, color: '#8B5CF6', day: 3 },
    { id: 's4', key: 'raceModel', sets: 2, metres: 350, color: '#FF4D5E', day: 5 },
  ],
  [
    { id: 's5', key: 'acceleration', sets: 6, metres: 40, color: '#00BEF3', day: 0 },
    { id: 's6', key: 'tempo', sets: 7, metres: 200, color: '#34D399', day: 1 },
    { id: 's7', key: 'speedEndurance', sets: 3, metres: 320, color: '#8B5CF6', day: 3 },
    { id: 's8', key: 'raceModel', sets: 2, metres: 370, color: '#FF4D5E', day: 5 },
  ],
];
const draft = plan[0].map((x, k) => ({ ...x, id: `r${k + 1}` }));
// Initials are 10px text, so each chip pairs its fill with an ink that reaches AA (the phone avatars in phone.css use the same fills).
const avatars = [
  { ini: 'VA', color: '#0077A8', ink: '#fff' },
  { ini: 'DM', color: '#7C4DE8', ink: '#fff' },
  { ini: 'JR', color: '#34D399', ink: '#04101F' },
  { ini: '+15', color: '#D6263A', ink: '#fff' },
];
---

<section class="sec ai" id="ai" data-section aria-labelledby="ai-h">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow rv">{t.eyebrow}</p>
        <h2 class="d d2 lines" id="ai-h">
          {
            t.title.map((line, i) => (
              <>
                <span>
                  <span style={`--i:${i}`}>{line}</span>
                </span>{' '}
              </>
            ))
          }
        </h2>
      </div>
      <p class="lead rv" style="--i:2">{t.lead}</p>
    </div>

    <div class="media-frame ai-frame rv" data-tl-host="ai">
      <video muted playsinline loop preload="none" data-clip data-poster="/home/media/ai-bg.webp" aria-hidden="true" tabindex="-1">
        <source src="/home/media/ai-bg.webm" type="video/webm" />
        <source src="/home/media/ai-bg.mp4" type="video/mp4" />
      </video>
      <div class="vid-shade"></div>
      <p class="sr">{t.story}</p>
      <div class="stage-fit" data-fit="1000" data-fit-h="562">
        <div class="stage ai-stage" aria-hidden="true">
          <div class="ai-cal" data-el="cal">
            <div class="cal-hd">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#08132B" stroke-width="2"><rect x="3" y="5" width="18" height="16" rx="3"></rect><path d="M3 10h18M8 3v4M16 3v4"></path></svg>
              <b>{s.calendarTitle}</b>
              <span class="sp">
                <span class="avs">
                  {avatars.map((a) => <i style={`--c:${a.color};color:${a.ink}`}>{a.ini}</i>)}
                </span>
                <span class="seg">
                  <span>{s.range[0]}</span><span class="on">{s.range[1]}</span><span>{s.range[2]}</span>
                </span>
              </span>
            </div>
            <div class="cal-grid">
              <span></span>
              {s.days.map((d) => <span class="dh">{d}</span>)}
              {
                plan.map((week, w) => (
                  <>
                    <span class="wk">{s.weeks[w]}</span>
                    {[0, 1, 2, 3, 4, 5, 6].map((d) => {
                      const ses = week.find((x) => x.day === d);
                      return (
                        <div class="cal-cell">
                          {ses && (
                            <div class="sess" data-el={ses.id} style={`--sc:${ses.color}`}>
                              <b>{s.sessions[ses.key]}</b>
                              <span>{`${ses.sets} × ${ses.metres} m`}</span>
                            </div>
                          )}
                        </div>
                      );
                    })}
                  </>
                ))
              }
            </div>
            <div class="ai-flash" data-el="flash"></div>
            <div class="ai-shock" data-el="shock"></div>
          </div>

          <div class="ai-ask" data-el="ask">
            <span class="hd">✦ {s.askBadge}</span>
            <div class="orb" data-el="orb"><i class="halo"></i></div>
            <h4>{s.askTitle}</h4>
            <p>{s.askText}</p>
            <div class="ai-input">
              <span class="ty" data-el="ty1">{s.prompt[0]}</span>
              <span class="ty" data-el="ty2">{s.prompt[1]}<i class="caret"></i></span>
              <span class="ai-gen" data-el="gen">✦ {s.generate}</span>
            </div>
          </div>

          <div class="ai-prog" data-el="prog">
            <div class="t"><em>{s.programAccent}</em> {s.programTitle}</div>
            <div class="meta">{s.programMeta[0]} <i></i> {s.programMeta[1]} <i></i> {s.programMeta[2]}</div>
            <div class="ai-rows">
              {
                draft.map((r) => (
                  <div class="ai-row" data-el={r.id}>
                    <span class="day">{s.days[r.day]}</span>
                    <b>{s.sessions[r.key]}</b>
                    <span class="reps">{`${r.sets}×${r.metres} m`}</span>
                  </div>
                ))
              }
            </div>
            <div class="ai-add" data-el="add">{s.addToCalendar} →</div>
          </div>

          <div class="ai-toast" data-el="toast"><span class="ck">✓</span>{s.toast}</div>
        </div>
      </div>
    </div>

    <ol class="ai-steps" data-steps="ai" aria-label={t.stepsLabel}>
      {
        t.steps.map((step, k) => (
          <li class="ai-step">
            <div class="at-bar" aria-hidden="true"><i></i></div>
            <strong class="ai-step-t"><em aria-hidden="true">{`0${k + 1}`}</em>{step.title}</strong>
            <span class="ai-step-d">{step.text}</span>
          </li>
        ))
      }
    </ol>
  </div>
</section>
