---
import type { Locale } from '../../i18n';
import { useEngage } from '../../i18n/pages/engage';
import { hrefFor } from '../../data/nav';
import { site } from '../../data/site';
import Photo from '../ui/Photo.astro';
import Phone from '../ui/Phone.astro';
import FinalCta from '../home/FinalCta.astro';
import FeatureHero from './FeatureHero.astro';
import AlsoInAria from './AlsoInAria.astro';
import ConsentStrip from './ConsentStrip.astro';
import InfoTile from './InfoTile.astro';
import EIcon from './EIcon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const e = useEngage(locale);
const g = e.guardian;
const c = e.common;
const left = g.cards.slice(0, 2);
const right = g.cards.slice(2);
const tabIcons = ['home', 'calendar', 'chat', 'file'] as const;
---

<FeatureHero
  eyebrow={g.eyebrow}
  title={g.title}
  sub={g.sub}
  ctas={[
    { label: g.ctaPrimary, href: site.booking },
    { label: g.ctaSecondary, href: '#how', kind: 'secondary' },
  ]}
>
  <div slot="media" class="fh__fill" style="--focus:45% 50%">
    <Photo
      slot="f6-guardian"
      ratio="3/2"
      sizes="(max-width: 1024px) 94vw, 720px"
      widths={[480, 800, 1200]}
      alt={g.photoAlt}
      eager
      priority="high"
      locale={locale}
    />
  </div>
</FeatureHero>

<section class="section how" id="how" aria-labelledby="how-title">
  <div class="container">
    <div class="section-head how__head">
      <h2 id="how-title" class="h-lane">{g.seeTitle}</h2>
    </div>

    <div class="how__stage" data-tabs>
      <div class="tabs how__tabs" role="tablist" aria-label={g.switcherLabel}>
        {
          g.children.map((ch, i) => (
            <button
              class="tab"
              type="button"
              role="tab"
              id={`kid-tab-${i}`}
              aria-controls={`kid-panel-${i}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-text={ch.name}
            >
              {ch.name}
            </button>
          ))
        }
        <span class="tabs__lane" aria-hidden="true"></span>
      </div>

      <div class="how__grid">
        <ul class="how__col how__col--left">
          {left.map((card, i) => (<li data-reveal style={`--reveal-i:${i}`}><InfoTile icon={card.icon as 'calendar'} title={card.title} body={card.body} /></li>))}
        </ul>

        <div class="how__phone">
          <Phone class="gp" decorative={false}>
            <div class="gp__app">
              <p class="gp__brand"><span class="gp__logo" aria-hidden="true"></span>{g.appName}</p>
              <div class="gp__track">
                {
                  g.children.map((ch, i) => (
                    <div class="gp__screen" role="tabpanel" id={`kid-panel-${i}`} aria-labelledby={`kid-tab-${i}`} inert={i !== 0}>
                      <p class="gp__kid"><span class="avatar">{ch.name[0]}</span>{ch.name}</p>
                      <div class="gp__card gp__card--week">
                        <EIcon name="calendar" size={16} />
                        <div>
                          <p class="gp__strong">{ch.week}</p>
                          <p class="gp__muted">{ch.weekDetail}</p>
                        </div>
                      </div>
                      <div class="gp__card gp__card--msg">
                        <span class="avatar">{ch.coach.split(' ')[1][0]}</span>
                        <div>
                          <p class="gp__strong">{ch.coach} <span class="gp__muted">· {ch.day}</span></p>
                          <p class="gp__text">{ch.message}</p>
                        </div>
                      </div>
                      <div class="gp__card gp__card--form">
                        <EIcon name="file" size={16} />
                        <div>
                          <p class="gp__strong">{ch.form}</p>
                          <p class="gp__muted">{ch.formDetail}</p>
                        </div>
                        <EIcon name={ch.signed ? 'check' : 'pencil'} size={16} class={ch.signed ? 'gp__ok' : 'gp__todo'} />
                      </div>
                    </div>
                  ))
                }
              </div>
              <ul class="gp__bar" aria-hidden="true">
                {g.phoneTabs.map((label, i) => (<li class:list={[i === 0 && 'is-on']}><EIcon name={tabIcons[i]} size={16} /><span>{label}</span></li>))}
              </ul>
            </div>
          </Phone>
        </div>

        <ul class="how__col how__col--right">
          {right.map((card, i) => (<li data-reveal style={`--reveal-i:${i + 2}`}><InfoTile icon={card.icon as 'calendar'} title={card.title} body={card.body} /></li>))}
        </ul>
      </div>
      <p class="demo-note how__note">{c.demoNote}</p>
    </div>
  </div>
</section>

<section class="section section--surface consent" aria-label={g.consentLabel}>
  <div class="container">
    <ConsentStrip label={g.consentLabel} items={g.consent} tone="surface" />
  </div>
</section>

<section class="price" aria-label={g.pricing.title}>
  <div class="container price__row">
    <div>
      <h2 class="price__title">{g.pricing.title}</h2>
      <p class="price__body">{g.pricing.body}</p>
    </div>
    <div class="price__links">
      <a class="link link-arrow" href={hrefFor('pricing', locale)}>{g.pricing.see}<EIcon name="arrow-right" size={18} /></a>
      <a class="link link-arrow" href={hrefFor('contact', locale)}>{g.pricing.talk}<EIcon name="arrow-right" size={18} /></a>
    </div>
  </div>
</section>

<AlsoInAria locale={locale} items={g.also} />
<FinalCta locale={locale} />

<style>
  .how {
    padding-bottom: clamp(48px, 6vw, 72px);
  }
  .how__stage {
    margin-top: 32px;
  }
  .how__tabs {
    justify-content: center;
    max-width: 460px;
    margin-inline: auto;
  }
  .how__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    margin-top: 32px;
  }
  .how__col {
    display: grid;
    gap: 28px;
  }
  .how__col--left {
    justify-items: end;
  }
  .how__col--right {
    justify-items: start;
    margin-top: 56px;
  }
  .how__col li {
    width: min(100%, 360px);
  }
  .how__phone {
    display: flex;
    justify-content: center;
  }
  .how :global(.gp) {
    --phone-w: 296px;
  }
  .how__note {
    text-align: center;
  }
  html:not(.js) .how__tabs {
    display: none;
  }

  .gp__app {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
  }
  .gp__brand {
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.4em 1em 0.7em;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: 0.95em;
    font-weight: 600;
  }
  .gp__logo {
    width: 1.1em;
    height: 1.1em;
    border-radius: 0.3em;
    background: var(--cyan);
  }
  .gp__track {
    display: flex;
    flex: 1;
    width: 200%;
    min-height: 0;
    transform: translateX(calc(var(--tab-i, 0) * -50%));
    transition: transform 0.25s var(--ease-out);
  }
  .gp__screen {
    display: grid;
    align-content: start;
    gap: 0.7em;
    width: 50%;
    min-width: 0;
    padding: 0.9em 0.9em 0;
  }
  .gp__kid {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-display);
    font-size: 1.05em;
    font-weight: 600;
  }
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2em;
    height: 2em;
    border-radius: 50%;
    background: var(--cyan-tint);
    color: var(--cyan-ink);
    font-size: 0.85em;
    font-weight: 700;
  }
  .gp__card {
    display: flex;
    align-items: flex-start;
    gap: 0.7em;
    padding: 0.75em 0.8em;
    border: 1px solid var(--line);
    border-radius: 0.9em;
    background: var(--surface);
    font-size: 0.88em;
    line-height: 1.3;
  }
  .gp__card > :global(svg) {
    flex: none;
    margin-top: 0.1em;
    color: var(--cyan-ink);
  }
  .gp__card > div {
    flex: 1;
    min-width: 0;
  }
  .gp__strong {
    font-weight: 600;
  }
  .gp__muted {
    color: var(--ink-2);
    font-weight: 400;
  }
  .gp__text {
    margin-top: 0.2em;
    color: var(--ink);
  }
  .gp__card--form > :global(svg:last-child) {
    margin-top: 0.1em;
  }
  .gp__card :global(.gp__ok) {
    color: var(--mint-ink);
  }
  .gp__card :global(.gp__todo) {
    color: var(--amber-ink);
  }
  .gp__bar {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    margin-top: auto;
    padding: 0.5em 0.4em 0.9em;
    border-top: 1px solid var(--line);
    background: var(--bg);
  }
  .gp__bar li {
    display: grid;
    justify-items: center;
    gap: 0.15em;
    color: var(--ink-3);
    font-size: 0.7em;
  }
  .gp__bar li.is-on {
    color: var(--cyan-ink);
    font-weight: 600;
  }

  .consent {
    padding-block: 32px;
  }
  .price {
    padding-block: 48px 0;
  }
  .price__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 40px;
  }
  .price__title {
    font-size: 28px;
    line-height: 34px;
  }
  .price__body {
    margin-top: 6px;
    color: var(--ink-2);
    font-size: 19px;
    line-height: 28px;
  }
  .price__links {
    display: flex;
    flex-wrap: wrap;
    gap: 12px 32px;
  }

  @media (max-width: 1024px) {
    .how__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
    }
    .how__phone {
      order: -1;
    }
    .how__col {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      justify-items: stretch;
      margin-top: 0;
    }
    .how__col li {
      width: auto;
    }
  }
  @media (max-width: 640px) {
    .how__col {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }
  }
</style>

<script>
  import '../../scripts/tabs';
</script>
