---
import '../../styles/engage/home-phone.css';
import '../../styles/engage/guardian.css';
import type { Locale } from '../../i18n';
import { useEngage } from '../../i18n/pages/engage';
import { hrefFor } from '../../data/nav';
import { contactHref } from './links';
import EngageHero from './EngageHero.astro';
import EngageFinal from './EngageFinal.astro';
import AlsoInAria from './AlsoInAria.astro';
import EIcon from './EIcon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const e = useEngage(locale);
const g = e.guardian;
const c = e.common;
const first = g.children[0];
const left = g.cards.slice(0, 2);
const right = g.cards.slice(2);
const tabIcons = ['home', 'calendar', 'chat', 'file'] as const;
const coachInitial = (coach: string) => coach.split(' ')[1][0];
---

<EngageHero
  eyebrow={g.eyebrow}
  title={g.title}
  sub={g.sub}
  ctas={[
    { label: g.ctaPrimary, href: contactHref(locale, 'demo') },
    { label: g.ctaSecondary, href: '#how' },
  ]}
>
  <div slot="media" class="media-frame eg-gh">
    <video muted playsinline loop preload="none" data-clip data-poster="/home/media/tile-hurdler.webp" aria-hidden="true" tabindex="-1">
      <source src="/home/media/tile-hurdler.webm" type="video/webm" />
      <source src="/home/media/tile-hurdler.mp4" type="video/mp4" />
    </video>
    <div class="vid-shade"></div>
    <div class="eg-gh__cards" aria-hidden="true">
      <div class="pop eg-gc eg-gc--week" data-el="c1">
        <span class="eg-gc__ic"><EIcon name="calendar" size={18} /></span>
        <div><b>{first.week}</b><small>{first.weekDetail}</small></div>
      </div>
      <div class="pop eg-gc eg-gc--msg" data-el="c2">
        <span class="eg-gc__av">{coachInitial(first.coach)}</span>
        <div><b>{first.coach} <small>· {first.day}</small></b><p>{first.message}</p></div>
      </div>
      <div class="pop eg-gc eg-gc--form" data-el="c3">
        <span class="eg-gc__ic"><EIcon name="file" size={18} /></span>
        <div><b>{first.form}</b><small>{first.formDetail}</small></div>
        <span class="eg-gc__ok" data-el="c4"><EIcon name="check" size={18} /></span>
      </div>
    </div>
    <span class="badge-demo">{c.demoNote}</span>
  </div>
</EngageHero>

<section class="show impact eg-stage eg-how" id="how" data-section aria-labelledby="how-title">
  <div class="wrap">
    <h2 class="d d3 eg-stage-title lines" id="how-title"><span><span>{g.seeTitle}</span></span></h2>

    <div class="how__stage" data-autotabs data-at="6400">
      <div class="eg-kids" role="tablist" aria-label={g.switcherLabel}>
        {
          g.children.map((ch, i) => (
            <button class="eg-kid" type="button" role="tab" id={`kid-tab-${i}`} aria-controls={`kid-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
              <span class="hd"><span class="eg-kid__av">{ch.name[0]}</span><strong>{ch.name}</strong></span>
              <span class="at-bar"><i /></span>
            </button>
          ))
        }
      </div>

      <div class="eg-how__grid">
        <ul class="eg-how__col eg-how__col--l" data-tilt>
          {left.map((card, i) => (<li class="eg-tile rv" style={`--i:${i}`}><span class="eg-tile__ic"><EIcon name={card.icon as 'calendar'} size={22} /></span><h3>{card.title}</h3><p>{card.body}</p></li>))}
        </ul>

        <div class="eg-how__phone">
          <div class="dphone eg-gp" role="group" aria-label={g.seeLabel}>
            <div class="scr">
              <i class="island"></i>
              <div class="sb"><span>9:41</span><span>●●● ▮</span></div>
              <p class="eg-gp__brand"><span class="eg-gp__logo" aria-hidden="true"></span>{g.appName}</p>
              {
                g.children.map((ch, i) => (
                  <div class:list={['ph-scn', 'eg-gp__scn', { on: i === 0 }]} data-panel role="tabpanel" id={`kid-panel-${i}`} aria-labelledby={`kid-tab-${i}`} inert={i !== 0}>
                    <p class="eg-gp__kid" data-el="k"><span class="eg-gp__avatar">{ch.name[0]}</span>{ch.name}</p>
                    <div class="eg-gp__card" data-el="w">
                      <EIcon name="calendar" size={16} />
                      <div><b>{ch.week}</b><small>{ch.weekDetail}</small></div>
                    </div>
                    <div class="eg-gp__card" data-el="m">
                      <span class="eg-gp__avatar eg-gp__avatar--coach">{coachInitial(ch.coach)}</span>
                      <div><b>{ch.coach} <small>· {ch.day}</small></b><p>{ch.message}</p></div>
                    </div>
                    <div class="eg-gp__card" data-el="f">
                      <EIcon name="file" size={16} />
                      <div><b>{ch.form}</b><small>{ch.formDetail}</small></div>
                      <span class:list={['eg-gp__st', { ok: ch.signed }]} data-el="s"><EIcon name={ch.signed ? 'check' : 'pencil'} size={16} /></span>
                    </div>
                  </div>
                ))
              }
              <ul class="eg-gp__bar" aria-hidden="true">
                {g.phoneTabs.map((label, i) => (<li class:list={[i === 0 && 'is-on']}><EIcon name={tabIcons[i]} size={16} /><span>{label}</span></li>))}
              </ul>
            </div>
          </div>
        </div>

        <ul class="eg-how__col eg-how__col--r" data-tilt>
          {right.map((card, i) => (<li class="eg-tile rv" style={`--i:${i + 2}`}><span class="eg-tile__ic"><EIcon name={card.icon as 'calendar'} size={22} /></span><h3>{card.title}</h3><p>{card.body}</p></li>))}
        </ul>
      </div>
      <p class="eg-note">{c.demoNote}</p>
    </div>
  </div>
</section>

<section class="sec eg-consent" aria-label={g.consentLabel}>
  <div class="wrap">
    <h2 class="t-title rv">{g.consentLabel}</h2>
    <ul class="eg-consent__list">
      {g.consent.map((item, i) => (<li class="rv" style={`--i:${i}`}><span class="eg-consent__ic"><EIcon name="shield" size={22} /></span><span>{item}</span></li>))}
    </ul>
  </div>
</section>

<section class="eg-price" aria-label={g.pricing.title}>
  <div class="wrap eg-price__row">
    <div>
      <h2 class="t-title rv">{g.pricing.title}</h2>
      <p class="lead rv" style="--i:1">{g.pricing.body}</p>
    </div>
    <div class="eg-price__links rv" style="--i:2">
      <a class="eg-link" href={hrefFor('pricing', locale)}>{g.pricing.see}<EIcon name="arrow-right" size={18} /></a>
      <a class="eg-link" href={contactHref(locale, 'question')}>{g.pricing.talk}<EIcon name="arrow-right" size={18} /></a>
    </div>
  </div>
</section>

<AlsoInAria locale={locale} items={g.also} />
<EngageFinal locale={locale} demoHref={contactHref(locale, 'demo')} />

<script>
  import '../../scripts/engage/guardian';
</script>
