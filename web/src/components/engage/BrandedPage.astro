---
import { Image } from 'astro:assets';
import { useDict, type Locale } from '../../i18n';
import { useEngage } from '../../i18n/pages/engage';
import { hrefFor } from '../../data/nav';
import { contactHref } from './links';
import FinalCta from '../home/FinalCta.astro';
import FeatureHero from './FeatureHero.astro';
import AlsoInAria from './AlsoInAria.astro';
import StepFlow from './StepFlow.astro';
import BrandPhones from './BrandPhones.astro';
import EIcon from './EIcon.astro';
import runIcon from '../../assets/apps/app-run.webp';
import aria12Icon from '../../assets/apps/app-aria12.webp';
import liftIcon from '../../assets/apps/app-lift.webp';
import fitmgIcon from '../../assets/apps/app-fitmg.webp';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const e = useEngage(locale);
const b = e.branded;
const contact = contactHref(locale, 'question');
const pricing = hrefFor('pricing', locale);
const same = [
  { key: 'run', src: runIcon },
  { key: 'aria12', src: aria12Icon },
  { key: 'lift', src: liftIcon },
  { key: 'fitmg', src: fitmgIcon },
] as const;
---

<FeatureHero
  variant="fan"
  eyebrow={b.eyebrow}
  title={b.title}
  sub={b.sub}
  ctas={[
    { label: b.ctaPrimary, href: contact },
    { label: b.ctaSecondary, href: pricing, kind: 'secondary' },
  ]}
>
  <div slot="media" class="fan-wrap" role="group" aria-label={b.fanLabel}>
    <BrandPhones locale={locale} />
  </div>
</FeatureHero>

<section class="section section--surface make" aria-labelledby="make-title">
  <div class="container make__grid">
    <article class="card" data-reveal>
      <h2 id="make-title" class="card__title">{b.makeTitle}</h2>
      <div class="make__body">
        <ul class="make__list">
          {b.makeItems.map((it) => (<li><EIcon name={it.icon as 'pencil'} size={24} /><span>{it.label}</span></li>))}
        </ul>
        <div class="demo">
          <div class="demo__left">
            <span class="demo__icon" role="img" aria-label={b.demoGym.iconLabel}><EIcon name="dumbbell" size={44} /></span>
            <p class="demo__name">{b.demoGym.name}</p>
            <span class="demo__dots" role="img" aria-label={b.demoGym.colours}><i style="background:#08132b"></i><i style="background:#00bef3"></i><i style="background:#c3ccd9"></i></span>
          </div>
          <div class="demo__phone" aria-hidden="true">
            <span class="demo__time">9:41</span>
            <span class="demo__mark"><EIcon name="dumbbell" size={34} /></span>
            <p class="demo__brand">{b.demoGym.name}</p>
            <p class="demo__tag">{b.demoGym.tagline}</p>
            <span class="demo__cta">{b.demoGym.cta}</span>
          </div>
        </div>
      </div>
      <p class="demo-note">{b.demoNote}</p>
    </article>

    <article class="card" data-reveal style="--reveal-i:1">
      <h2 class="card__title">{b.howTitle}</h2>
      <div class="how">
        <StepFlow steps={b.steps} label={b.howTitle} />
      </div>
      <div class="addon">
        <p class="addon__text num">{b.addon}</p>
        <a class="link link-arrow" href={pricing}>{b.seePricing}<EIcon name="arrow-right" size={18} /></a>
      </div>
    </article>
  </div>
</section>

<section class="section same" aria-labelledby="same-title">
  <div class="container same__grid">
    <div>
      <h2 id="same-title" class="h-lane">{b.sameTitle}</h2>
      <p class="same__body">{b.sameBody}</p>
    </div>
    <ul class="same__icons">
      {
        same.map((s) => (
          <li>
            <Image src={s.src} alt="" width={72} height={72} widths={[72, 144, 216]} sizes="72px" loading="lazy" decoding="async" />
            <span>{t.nav.apps[s.key].name}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<AlsoInAria locale={locale} items={b.also} />
<FinalCta locale={locale} middle={{ label: e.common.talkToUs, href: contact }} demoHref={contactHref(locale, 'demo')} />

<style>
  .fan-wrap {
    width: 100%;
    padding-block: 8px 0;
  }
  .make {
    padding-block: clamp(40px, 5vw, 64px);
  }
  .make__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 24px;
  }
  .card {
    padding: clamp(24px, 3vw, 36px);
    border-radius: var(--radius-card);
    background: var(--bg);
  }
  .card__title {
    font-size: 34px;
    line-height: 40px;
  }
  .make__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 24px;
    align-items: center;
    margin-top: 24px;
  }
  .make__list {
    display: grid;
    gap: 18px;
    padding-right: 20px;
    border-right: 1px solid var(--line);
  }
  .make__list li {
    display: flex;
    align-items: center;
    gap: 16px;
    color: var(--ink-2);
    font-size: 18px;
  }
  .make__list :global(svg) {
    flex: none;
    color: var(--cyan-ink);
  }
  .demo {
    display: flex;
    align-items: flex-end;
    justify-content: center;
    gap: 20px;
  }
  .demo__left {
    display: grid;
    justify-items: center;
    gap: 12px;
    padding-bottom: 8px;
  }
  .demo__icon {
    display: grid;
    place-items: center;
    width: 84px;
    height: 84px;
    border-radius: 20px;
    background: #08132b;
    color: #ffffff;
  }
  .demo__name {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
  }
  .demo__dots {
    display: flex;
    gap: 10px;
  }
  .demo__dots i {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    border: 1px solid var(--line);
  }
  .demo__phone {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 8px;
    width: 150px;
    height: 220px;
    margin-bottom: -2px;
    padding: 12px 12px 16px;
    border-radius: 22px 22px 0 0;
    background: linear-gradient(170deg, #1c2f55, #08132b 70%);
    color: #ffffff;
    text-align: center;
  }
  .demo__time {
    align-self: start;
    justify-self: start;
    font-size: 11px;
    font-weight: 600;
  }
  .demo__mark {
    color: #ffffff;
  }
  .demo__brand {
    font-family: var(--font-display);
    font-size: 17px;
    font-weight: 600;
  }
  .demo__tag {
    font-size: 11px;
    line-height: 15px;
    opacity: 0.9;
  }
  .demo__cta {
    width: 100%;
    margin-top: 10px;
    padding: 8px;
    border-radius: 8px;
    background: #ffffff;
    color: #08132b;
    font-size: 12px;
    font-weight: 600;
  }
  .how {
    margin-top: 32px;
  }
  .addon {
    display: grid;
    gap: 10px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }
  .addon__text {
    font-family: var(--font-body);
    font-size: 20px;
    line-height: 28px;
  }

  .same {
    padding-block: clamp(48px, 6vw, 72px) 8px;
  }
  .same__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 32px 64px;
    align-items: center;
  }
  .same__body {
    max-width: 34em;
    margin-top: 12px;
    color: var(--ink-2);
    font-size: 20px;
    line-height: 30px;
  }
  .same__icons {
    display: flex;
    flex-wrap: wrap;
    gap: 20px 28px;
  }
  .same__icons li {
    display: grid;
    justify-items: center;
    gap: 8px;
    width: 96px;
    text-align: center;
    font-size: 14px;
    line-height: 18px;
    color: var(--ink-2);
  }
  .same__icons :global(img) {
    width: 72px;
    height: 72px;
    border-radius: 16px;
    box-shadow: 0 0 0 1px var(--line);
  }

  @media (max-width: 1180px) {
    .make__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 720px) {
    .make__body {
      grid-template-columns: minmax(0, 1fr);
    }
    .make__list {
      padding: 0 0 20px;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .card__title {
      font-size: 28px;
      line-height: 34px;
    }
    .same__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
