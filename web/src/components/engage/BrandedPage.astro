---
import '../../styles/engage/home-phone.css';
import '../../styles/engage/home-showcase.css';
import '../../styles/engage/branded.css';
import { Image } from 'astro:assets';
import { useDict, type Locale } from '../../i18n';
import { useEngage } from '../../i18n/pages/engage';
import { hrefFor } from '../../data/nav';
import { addOns, usd } from '../../data/prices';
import { fill } from '../../lib/template';
import { contactHref } from './links';
import EngageHero from './EngageHero.astro';
import EngageFinal from './EngageFinal.astro';
import AlsoInAria from './AlsoInAria.astro';
import BrandPhones from './BrandPhones.astro';
import EIcon from './EIcon.astro';
import runIcon from '../../assets/apps/app-run.webp';
import aria12Icon from '../../assets/apps/app-aria12.webp';
import liftIcon from '../../assets/apps/app-lift.webp';
import fitmgIcon from '../../assets/apps/app-fitmg.webp';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useDict(locale);
const e = useEngage(locale);
const b = e.branded;
const contact = contactHref(locale, 'question');
const addon = fill(b.addon, { monthly: usd(addOns.brandedApp.monthly), setup: usd(addOns.brandedApp.setup) });
const pricing = hrefFor('pricing', locale);
const same = [
  { key: 'run', src: runIcon },
  { key: 'aria12', src: aria12Icon },
  { key: 'lift', src: liftIcon },
  { key: 'fitmg', src: fitmgIcon },
] as const;
// The morphing phone re-skins through Your Gym and the four apps. Colours are deep enough for white type (AA).
const img = (id: string) => `url(/home/img/${id}.webp)`;
const brands = [
  { n: b.gym.name, m: b.gym.mark, c: '#0b1f4a', i: img('night-huddle-800') },
  { n: t.nav.apps.run.name, m: 'R', c: '#006f9c', i: img('A1-athletes-sprinter-800') },
  { n: t.nav.apps.aria12.name, m: '12', c: '#047857', i: img('hero3-soccer-academies-big-800') },
  { n: t.nav.apps.lift.name, m: 'L', c: '#6d28d9', i: img('hero5-gyms-and-studios-big-800') },
  { n: t.nav.apps.fitmg.name, m: 'FM', c: '#c81e3a', i: img('bd-jumper-flare-800') },
];
const first = brands[0];
const left = brands[brands.length - 1];
const right = brands[1];
---

<EngageHero
  variant="split"
  eyebrow={b.eyebrow}
  title={b.title}
  sub={b.sub}
  ctas={[
    { label: b.ctaPrimary, href: contact },
    { label: b.ctaSecondary, href: pricing },
  ]}
>
  <div slot="media" class="media-frame eg-bh" aria-hidden="true">
    <div class="eg-bh__glow"></div>
    <div class="ap-stage eg-bh__stage" data-ap-stage data-brands={JSON.stringify(brands)}>
      <div class="ap-side l1">
        <div class="s">
          <div class="app-scr" style={`--bc:${left.c}`}>
            <div class="mk">{left.m}</div>
            <div class="an">{left.n}</div>
            <div class="hl" style={`--img:${left.i}`}></div>
          </div>
        </div>
      </div>
      <div class="ap-side r1">
        <div class="s">
          <div class="app-scr" style={`--bc:${right.c}`}>
            <div class="mk">{right.m}</div>
            <div class="an">{right.n}</div>
            <div class="hl" style={`--img:${right.i}`}></div>
          </div>
        </div>
      </div>
      <div class="dphone" data-morph>
        <div class="scr">
          <i class="island"></i>
          <div class="app-scr" data-app style={`--bc:${first.c}`}>
            <div class="mk" data-app-mk>{first.m}</div>
            <div class="an" data-app-name>{first.n}</div>
            <div class="hl" data-app-img style={`--img:${first.i}`}></div>
            <div class="tc"><i class="sk sk--60"></i><i class="sk sk--90"></i></div>
            <div class="tc tc-ready">
              <div class="dring" style="--v:82;--rs:40px"></div>
              <div class="eg-bh__sk"><i class="sk sk--90"></i><i class="sk sk--50"></i></div>
            </div>
          </div>
        </div>
      </div>
      <div class="flychip fc1" data-depth="20"><i></i>{b.makeItems[0].label}</div>
      <div class="flychip fc2" data-depth="34"><i></i>{b.makeItems[1].label}</div>
      <div class="flychip fc3" data-depth="26"><i></i>{b.makeItems[2].label}</div>
    </div>
  </div>
</EngageHero>

<section class="show impact eg-stage eg-make" data-section aria-labelledby="make-title">
  <div class="wrap">
    <h2 id="make-title" class="d d3 eg-stage-title lines"><span><span>{b.makeTitle}</span></span></h2>
    <div class="eg-make__grid">
      <ul class="eg-make__list" data-tilt>
        {
          b.makeItems.map((it, i) => (
            <li class="eg-tile rv" style={`--i:${i}`}>
              <span class="eg-tile__ic"><EIcon name={it.icon as 'pencil'} size={22} /></span>
              <h3>{it.label}</h3>
            </li>
          ))
        }
      </ul>
      <div class="eg-dg rv" style="--i:2">
        <div class="eg-dg__top">
          <span class="eg-dg__icon" role="img" aria-label={b.gym.iconLabel}><EIcon name="dumbbell" size={40} /></span>
          <div>
            <p class="eg-dg__name">{b.gym.name}</p>
            <span class="eg-dg__dots" role="img" aria-label={b.gym.colours}><i style="background:#08132b"></i><i style="background:#00bef3"></i><i style="background:#c3ccd9"></i></span>
          </div>
        </div>
        <div class="eg-dg__scr" aria-hidden="true">
          <span class="eg-dg__mark"><EIcon name="dumbbell" size={30} /></span>
          <p class="eg-dg__brand">{b.gym.name}</p>
          <p class="eg-dg__tag">{b.gym.tagline}</p>
          <span class="eg-dg__cta">{b.gym.cta}</span>
        </div>
      </div>
    </div>

    <div class="eg-how">
      <h2 class="d d3 eg-stage-title lines" id="how-title"><span><span>{b.howTitle}</span></span></h2>
      <ol class="eg-steps rv" aria-labelledby="how-title">
        {b.steps.map((s) => (<li><span>{s}</span></li>))}
      </ol>
      <div class="eg-addon rv" style="--i:2">
        <p class="addon__text num" data-addon>{addon}</p>
        <a class="eg-link" href={pricing}>{b.seePricing}<EIcon name="arrow-right" size={18} /></a>
      </div>
    </div>

    <article class="panel reading eg-same rv" aria-labelledby="same-title">
      <div class="eg-same__hd">
        <div>
          <h2 id="same-title" class="t-title">{b.sameTitle}</h2>
          <p class="lead">{b.sameBody}</p>
        </div>
        <ul class="eg-same__icons">
          {
            same.map((s) => (
              <li>
                <Image src={s.src} alt="" width={72} height={72} widths={[72, 144, 216]} sizes="72px" loading="lazy" decoding="async" />
                <span>{t.nav.apps[s.key].name}</span>
              </li>
            ))
          }
        </ul>
      </div>
      <div class="eg-same__fan" role="group" aria-label={b.fanLabel}>
        <BrandPhones locale={locale} />
      </div>
    </article>
  </div>
</section>

<AlsoInAria locale={locale} items={b.also} />
<EngageFinal locale={locale} middle={{ label: e.common.talkToUs, href: contact }} callHref={contactHref(locale, 'call')} />

<script>
  import '../../scripts/engage/branded';
</script>
