---
import '../../styles/engage/base.css';
import { useDict, type Locale } from '../../i18n';
import { useEngage } from '../../i18n/pages/engage';
import { hrefFor } from '../../data/nav';
import type { ItemId } from '../../data/site';
import EIcon from './EIcon.astro';

interface Props {
  locale: Locale;
  items: readonly string[];
}
const { locale, items } = Astro.props;
const t = useDict(locale);
const e = useEngage(locale);
const icons: Record<string, 'chat' | 'users' | 'heart' | 'file' | 'calendar' | 'link' | 'dumbbell' | 'chart'> = {
  messaging: 'chat',
  guardian: 'users',
  teams: 'calendar',
  readiness: 'heart',
  branded: 'file',
  integrations: 'link',
  programs: 'chart',
  powerlab: 'dumbbell',
};
---

<section class="sec eg-also" aria-labelledby="also-title">
  <div class="wrap">
    <h2 id="also-title" class="t-title rv">{e.common.alsoTitle}</h2>
    <ul class="eg-also__grid">
      {
        items.map((id, i) => {
          const item = t.nav.items[id as ItemId];
          return (
            <li class="rv" style={`--i:${i}`}>
              <a class="eg-also__card" href={hrefFor(id as ItemId, locale)}>
                <span class="eg-also__icon"><EIcon name={icons[id] ?? 'link'} size={22} /></span>
                <span class="eg-also__text">
                  <span class="eg-also__name">{item.name}</span>
                  <span class="eg-also__desc">{item.desc}</span>
                </span>
                <EIcon name="arrow-right" size={18} class="eg-also__arrow" />
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</section>
