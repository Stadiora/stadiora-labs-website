---
import '../../styles/engage/teams.css';
import type { Locale } from '../../i18n';
import { useEngage } from '../../i18n/pages/engage';
import { hrefFor } from '../../data/nav';
import { education, usd } from '../../data/prices';
import { segments } from '../../lib/template';
import { contactHref } from './links';
import EngageHero from './EngageHero.astro';
import EngageFinal from './EngageFinal.astro';
import AlsoInAria from './AlsoInAria.astro';
import EIcon from './EIcon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const e = useEngage(locale);
const t = e.teams;
const rowIcons = ['run', 'ball', 'ball', 'ball', 'dumbbell'] as const;
const sidebarIcons = ['home', 'users', 'user', 'calendar', 'file'] as const;
// The HTML always holds the US rate; the script below swaps in the visitor's region (same table as /pricing).
const highSchool = education.us.find((r) => r.key === 'highSchool')!;
const schoolValues: Record<string, string> = { price: usd(highSchool.monthly), athletes: String(highSchool.athletes) };
// Skeleton planner behind the card: 5 weeks of 7 days, with event bars (row, first day, span, colour).
const events = [
  [0, 0, 3, 0], [0, 4, 2, 1], [1, 1, 2, 2], [1, 5, 2, 3], [2, 0, 2, 1], [2, 3, 3, 0], [3, 2, 2, 3], [3, 5, 2, 2], [4, 0, 3, 2], [4, 4, 3, 1],
] as const;
---

<EngageHero
  variant="overlap"
  eyebrow={t.eyebrow}
  title={t.title}
  sub={t.sub}
  ctas={[
    { label: t.ctaPrimary, href: contactHref(locale, 'call') },
    { label: t.ctaSecondary, href: hrefFor('pricing', locale) },
  ]}
>
  <div slot="media" class="media-frame eg-th">
    <video muted playsinline loop preload="none" data-clip data-poster="/home/media/night-stadium.webp" aria-hidden="true" tabindex="-1">
      <source src="/home/media/night-stadium.webm" type="video/webm" />
      <source src="/home/media/night-stadium.mp4" type="video/mp4" />
    </video>
    <div class="vid-shade"></div>
    <div class="eg-plan" aria-hidden="true">
      <div class="eg-plan__hd"><i></i><i></i><i></i><i class="eg-plan__sp"></i><i></i></div>
      <div class="eg-plan__grid">
        {Array.from({ length: 35 }, () => <i></i>)}
        {events.map(([r, d, s, k]) => (<b class={`ev ev${k}`} style={`grid-row:${r + 1};grid-column:${d + 1} / span ${s}`}></b>))}
      </div>
    </div>
  </div>

  <div slot="below" class="wrap eg-tp">
    <div class="eg-org rv" role="group" aria-label={t.panelLabel}>
      <aside class="eg-org__side" aria-hidden="true">
        <ul>
          {t.sidebar.map((label, i) => (<li class:list={[i === 0 && 'is-on']}><EIcon name={sidebarIcons[i]} size={18} />{label}</li>))}
        </ul>
      </aside>
      <div class="eg-org__main">
        <header class="eg-org__head">
          <h2>{t.school}</h2>
          <p aria-hidden="true"><EIcon name="search" size={18} /><span class="eg-org__av">{t.initials}</span>{t.coach}</p>
        </header>
        <ul class="eg-org__tabs" aria-hidden="true">
          {t.tabs.map((label, i) => (<li class:list={[i === 0 && 'is-on']}>{label}</li>))}
        </ul>
        <ul class="eg-org__stats">
          {
            t.stats.map((s) => (
              <li>
                <span class="eg-org__sic"><EIcon name={s.icon as 'users'} size={22} /></span>
                <span><b><span class="sr-only">{s.value}</span><span class="count fnum" aria-hidden="true" style={`--to:${s.value}`}></span></b><small>{s.label}</small></span>
              </li>
            ))
          }
        </ul>
        <div class="eg-org__tbl">
          <table>
            <caption class="sr-only">{t.table.caption}</caption>
            <thead>
              <tr>{t.table.head.map((h) => (<th scope="col">{h}</th>))}</tr>
            </thead>
            <tbody>
              {
                t.table.rows.map((r, i) => (
                  <tr style={`--k:${i}`}>
                    <td><span class="eg-org__team"><EIcon name={rowIcons[i]} size={18} />{r.team}</span></td>
                    <td class="fnum">{r.athletes}</td>
                    <td>{r.coach}</td>
                    <td class="eg-org__st"><i aria-hidden="true"></i>{t.table.active}</td>
                  </tr>
                ))
              }
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <div class="eg-tp__pops">
      <section class="pop eg-pc rv" aria-labelledby="staff-title" style="--i:1">
        <h3 id="staff-title"><EIcon name="users" size={22} />{t.staff.title}</h3>
        <ul>{t.staff.roles.map((r) => (<li>{r}</li>))}</ul>
      </section>
      <section class="pop eg-pc rv" aria-labelledby="rep-title" style="--i:2">
        <h3 id="rep-title"><EIcon name="file" size={22} />{t.reports.title}</h3>
        <ul>{t.reports.items.map((r) => (<li>{r}</li>))}</ul>
        <span class="eg-pc__btn">{t.reports.export}</span>
      </section>
    </div>
  </div>
</EngageHero>

<section class="show impact eg-stage eg-jobs" data-section aria-labelledby="jobs-title">
  <div class="wrap">
    <h2 class="d d3 eg-stage-title lines" id="jobs-title"><span><span>{t.jobsTitle}</span></span></h2>
    <ul class="eg-jobs__grid" data-tilt>
      {
        t.jobs.map((j, i) => (
          <li class="eg-tile rv" id={i === 2 ? 'reports' : undefined} style={`--i:${i}`}>
            <span class="eg-tile__ic"><EIcon name={j.icon as 'users'} size={22} /></span>
            <h3>{j.title}</h3>
            <p>{j.body}</p>
          </li>
        ))
      }
    </ul>

    <div class="marquee eg-rail" style="--dur:48s" data-clip-window="x" tabindex="0" role="group" aria-label={t.table.caption}>
      <div class="marquee-track">
        {
          [false, true].map((dup) => (
            <div class="eg-rail__set" aria-hidden={dup ? 'true' : undefined} inert={dup}>
              {t.table.rows.map((r, i) => (
                <div class="eg-rcard">
                  <span class="eg-rcard__ic"><EIcon name={rowIcons[i]} size={20} /></span>
                  <b>{r.team}</b>
                  <small>{r.coach}</small>
                  <span class="eg-rcard__n"><span class="fnum">{r.athletes}</span> <i aria-hidden="true"></i>{t.table.active}</span>
                </div>
              ))}
            </div>
          ))
        }
      </div>
    </div>
    <p class="eg-note eg-notes">{t.consent}</p>
  </div>
</section>

<section class="sec eg-schools" aria-labelledby="schools-title">
  <div class="wrap eg-schools__row">
    <div>
      <h2 id="schools-title" class="t-title rv">{t.schools.title}</h2>
      <p class="lead rv" style="--i:1">{segments(t.schools.body).map((s) => ('token' in s ? (s.token === 'price' ? <strong class="fnum" data-school={s.token}>{schoolValues[s.token]}</strong> : <span data-school={s.token}>{schoolValues[s.token]}</span>) : s.text))}</p>
    </div>
    <a class="eg-link rv" style="--i:2" href={hrefFor('pricing', locale)}>{t.schools.see}<EIcon name="arrow-right" size={18} /></a>
  </div>
</section>

<AlsoInAria locale={locale} items={t.also} />
<EngageFinal locale={locale} callHref={contactHref(locale, 'call')} />

<script>
  import '../../scripts/engage/teams';
</script>
