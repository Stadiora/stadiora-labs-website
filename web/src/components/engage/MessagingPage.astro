---
import '../../styles/engage/home-phone.css';
import '../../styles/engage/home-showcase.css';
import '../../styles/engage/messaging.css';
import type { Locale } from '../../i18n';
import { useEngage } from '../../i18n/pages/engage';
import { hrefFor } from '../../data/nav';
import { site } from '../../data/site';
import { contactHref } from './links';
import EngageHero from './EngageHero.astro';
import EngageFinal from './EngageFinal.astro';
import AlsoInAria from './AlsoInAria.astro';
import EIcon from './EIcon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const e = useEngage(locale);
const m = e.messaging;
const c = e.common;

const scenes = ['chat', 'feed', 'bc', 'ann'] as const;
const tabs = [m.chat.title, m.feed.title, m.broadcast.title, m.announcements.title];
const bubblePos = { chat: 'a', feed: 'b', bc: 'c', ann: 'd' } as const;
const bubbleDepth = { chat: 24, feed: 30, bc: 20, ann: 26 } as const;
// The bubbles outside the phone repeat strings the phone already shows.
const bubbles = {
  chat: [m.chat.name, m.chat.m3],
  feed: [m.feed.author, m.feed.post],
  bc: [m.broadcast.group, m.broadcast.message],
  ann: [m.announcements.label, m.announcements.progress],
} as const;
// "18 of 24 read": the number counts up, the rest stays put.
const [, readNum, readRest] = m.announcements.progress.match(/^(\d+)(.*)$/) ?? ['', '0', m.announcements.progress];
const initials = (name: string) => name.split(' ').map((w) => w[0]).join('').slice(0, 2);
---

<EngageHero
  eyebrow={m.eyebrow}
  title={m.title}
  sub={m.sub}
  ctas={[
    { label: c.startFree, href: site.signUp },
    { label: c.bookDemo, href: contactHref(locale, 'demo') },
  ]}
>
  <div slot="media" class="eg-live" data-autotabs data-at="7600">
    <div class="media-frame eg-live__frame">
      <video muted playsinline loop preload="none" data-clip data-poster="/home/media/engage-bg.webp" aria-hidden="true" tabindex="-1">
        <source src="/home/media/engage-bg.webm" type="video/webm" />
        <source src="/home/media/engage-bg.mp4" type="video/mp4" />
      </video>
      <div class="vid-shade"></div>
      <div class="dphone">
        <div class="scr">
          <i class="island" aria-hidden="true"></i>
          <div class="sb" aria-hidden="true"><span>9:41</span><span>●●● ▮</span></div>
          <div class="ph-scn on" data-panel data-scn="chat" role="tabpanel" id="eg-p0" aria-labelledby="eg-t0">
            <div class="ph-top"><span class="av av-violet" aria-hidden="true">{initials(m.chat.name)}</span><div><b>{m.chat.name}</b><small>{m.chat.status}</small></div></div>
            <div class="ph-body">
              <div class="dmsg in" data-el="m1">{m.chat.m1}</div>
              <div class="typing" data-el="t1" aria-hidden="true"><i></i><i></i><i></i></div>
              <div class="dmsg me" data-el="m2">{m.chat.m2}</div>
              <div class="typing" data-el="t2" aria-hidden="true"><i></i><i></i><i></i></div>
              <div class="dmsg in" data-el="m3">{m.chat.m3}</div>
            </div>
            <div class="ph-input" aria-hidden="true">{m.chat.placeholder}</div>
          </div>
          <div class="ph-scn" data-panel data-scn="feed" role="tabpanel" id="eg-p1" aria-labelledby="eg-t1">
            <div class="ph-top"><span class="av av-cyan" aria-hidden="true">{initials(m.feed.group)}</span><div><b>{m.feed.screenTitle}</b><small>{m.feed.group}</small></div></div>
            <div class="ph-body">
              <div class="post" data-el="p1">
                <div class="ph" style="--img:url(/home/img/night-huddle-800.webp)" aria-hidden="true"></div>
                <div class="pb">
                  <b>{m.feed.author} · {m.feed.time}</b>{m.feed.post}
                  <div class="reacts">
                    <span data-el="rc1"><EIcon name="heart" size={12} /> <b class="tn fnum" style={`--to:${m.feed.likes}`}></b></span>
                    <span><EIcon name="chat" size={12} /> {m.feed.comments}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="ph-scn" data-panel data-scn="bc" role="tabpanel" id="eg-p2" aria-labelledby="eg-t2">
            <div class="ph-top"><span class="av av-mint" aria-hidden="true">{initials(m.broadcast.group)}</span><div><b>{m.broadcast.window}</b><small>{m.broadcast.to} {m.broadcast.group}</small></div></div>
            <div class="ph-body">
              <div class="bc-card" data-el="b1">
                <div class="to">{m.broadcast.to} {m.broadcast.group}</div>
                <p class="bc-text">{m.broadcast.message}</p>
                <div class="bc-prog"><i data-el="bp"></i></div>
              </div>
            </div>
            <div class="ph-input ph-input-c eg-send" aria-hidden="true">{m.broadcast.send}</div>
          </div>
          <div class="ph-scn" data-panel data-scn="ann" role="tabpanel" id="eg-p3" aria-labelledby="eg-t3">
            <div class="ph-top"><span class="av av-red" aria-hidden="true">{initials(m.announcements.title)}</span><div><b>{m.announcements.title}</b><small>{m.announcements.label}</small></div></div>
            <div class="ph-body">
              <div class="ann" data-el="a1">
                <small>{m.announcements.label}</small>
                <p class="ann-text">{m.announcements.headline}</p>
                <div class="bc-prog eg-prog"><i data-el="ap"></i></div>
                <small data-el="a2"><b class="tn fnum" style={`--to:${readNum}`}></b>{readRest}</small>
              </div>
              <ul class="eg-readers">
                {m.announcements.readers.map((r, i) => (<li data-el={`r${i + 1}`}><span class="eg-av" aria-hidden="true">{r.name[0]}</span><b>{r.name}</b><small>{r.when}</small></li>))}
              </ul>
            </div>
          </div>
        </div>
      </div>
      {
        scenes.map((k, i) => (
          <div class:list={['bubble-out', 'pop', `bo-${bubblePos[k]}`, { on: i === 0 }]} data-bubble={k} data-depth={bubbleDepth[k]} aria-hidden="true">
            <b>{bubbles[k][0]}</b>
            <div>{bubbles[k][1]}</div>
          </div>
        ))
      }
      <span class="badge-demo">{c.demoNote}</span>
    </div>
    <div class="eg-tabs" role="tablist" aria-label={m.gridLabel}>
      {
        tabs.map((label, i) => (
          <button class="eg-tab" type="button" role="tab" id={`eg-t${i}`} aria-controls={`eg-p${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>
            <span class="hd">
              <strong>{label}</strong>
              <em>{`0${i + 1}`}</em>
            </span>
            <span class="at-bar"><i /></span>
          </button>
        ))
      }
    </div>
  </div>
</EngageHero>

<section class="show impact eg-stage" id="ways" data-section aria-labelledby="ways-title">
  <div class="wrap">
    <div class="panel reading rv">
      <h2 class="t-title" id="ways-title">{m.gridLabel}</h2>
      <div class="bento eg-bento" data-tilt>
        <article class="bt eg-a rv" style="--i:0">
          <h3>{m.chat.title}</h3>
          <p>{m.chat.sub}</p>
          <div class="shot" aria-hidden="true">
            <div class="org-rows">
              <div class="org-hd"><b>{m.chat.name}</b><span>{m.chat.status}</span></div>
              <div class="eg-bub in">{m.chat.m1}<span>{m.chat.times[0]}</span></div>
              <div class="eg-bub me">{m.chat.m2}<span>{m.chat.times[1]}</span></div>
              <div class="eg-bub in">{m.chat.m3}<span>{m.chat.times[2]}</span></div>
            </div>
          </div>
        </article>
        <article class="bt eg-b rv" style="--i:1">
          <h3>{m.feed.title}</h3>
          <p>{m.feed.sub}</p>
          <div class="shot" aria-hidden="true">
            <div class="org-rows">
              <div class="org-hd"><b>{m.feed.group}</b><span>{m.feed.time}</span></div>
              <div class="eg-photo" style="--img:url(/home/img/night-huddle-800.webp)"></div>
              <p class="eg-line"><b>{m.feed.author}</b> {m.feed.post}</p>
              <p class="eg-react"><span><EIcon name="heart" size={14} /> {m.feed.likes}</span><span><EIcon name="chat" size={14} /> {m.feed.comments}</span></p>
            </div>
          </div>
        </article>
        <article class="bt eg-c rv" style="--i:2">
          <h3>{m.broadcast.title}</h3>
          <p>{m.broadcast.sub}</p>
          <div class="shot" aria-hidden="true">
            <div class="org-rows">
              <div class="org-hd"><b>{m.broadcast.window}</b><span>{m.broadcast.to} {m.broadcast.group}</span></div>
              <p class="eg-line">{m.broadcast.message}</p>
              <p class="eg-foot"><span class="eg-pill">{m.broadcast.send}</span></p>
            </div>
          </div>
        </article>
        <article class="bt eg-d rv" style="--i:3">
          <h3>{m.announcements.title}</h3>
          <p>{m.announcements.sub}</p>
          <div class="shot" aria-hidden="true">
            <div class="org-rows">
              <div class="org-hd"><b>{m.announcements.label}</b><span>{m.announcements.progress}</span></div>
              <p class="eg-line"><b>{m.announcements.headline}</b></p>
              <div class="bc-prog"><i style="transform:scaleX(.75)"></i></div>
              {m.announcements.readers.map((r, k) => (<div class="org-row org-row-2" style={`--k:${k}`}><b>{r.name}</b><span>{r.when}</span></div>))}
            </div>
          </div>
        </article>
      </div>
      <p class="dnote">{m.privacy}</p>
      <p class="dnote">{c.demoNote}</p>
    </div>

    <div class="eg-fam glass rv">
      <p>{m.families.text}</p>
      <a class="eg-link" href={hrefFor('guardian', locale)}>{m.families.link}<EIcon name="arrow-right" size={18} /></a>
    </div>
  </div>
</section>

<AlsoInAria locale={locale} items={m.also} />
<EngageFinal locale={locale} demoHref={contactHref(locale, 'demo')} />

<script>
  import '../../scripts/engage/messaging';
</script>
