---
import type { Locale } from '../../i18n';
import { useEngage } from '../../i18n/pages/engage';
import { hrefFor } from '../../data/nav';
import { site } from '../../data/site';
import { contactHref } from './links';
import Photo from '../ui/Photo.astro';
import Phone from '../ui/Phone.astro';
import FinalCta from '../home/FinalCta.astro';
import FeatureHero from './FeatureHero.astro';
import AlsoInAria from './AlsoInAria.astro';
import EIcon from './EIcon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const e = useEngage(locale);
const m = e.messaging;
const c = e.common;
---

<FeatureHero
  eyebrow={m.eyebrow}
  title={m.title}
  sub={m.sub}
  ctas={[
    { label: c.startFree, href: site.signUp },
    { label: c.bookDemo, href: contactHref(locale, 'demo'), kind: 'secondary' },
  ]}
>
  <div slot="media" class="fh__fill">
    <Photo
      slot="m2-engage"
      ratio="3/2"
      sizes="(max-width: 1024px) 94vw, 720px"
      widths={[480, 800, 1200]}
      alt={m.photoAlt}
      eager
      priority="high"
      locale={locale}
    />
  </div>
</FeatureHero>

<section class="section section--surface bento" aria-labelledby="bento-title">
  <div class="container">
    <h2 id="bento-title" class="sr-only">{m.gridLabel}</h2>
    <div class="bento__grid">
      <article class="bt" data-reveal style="--reveal-i:0">
        <h3 class="bt__title">{m.chat.title}</h3>
        <p class="bt__sub">{m.chat.sub}</p>
        <div class="bt__demo" aria-hidden="true">
          <Phone class="bt__phone">
            <div class="chat chat--seq" data-chat>
              <div class="chat__head">
                <EIcon name="chevron-left" size={16} />
                <span class="avatar">D</span>
                <div>
                  <p class="chat__name">{m.chat.name}</p>
                  <p class="chat__status">{m.chat.status}</p>
                </div>
              </div>
              <div class="chat__body">
                <div class="bubble bubble--in"><p>{m.chat.m1}</p><span>{m.chat.times[0]}</span></div>
                <div class="bubble bubble--out"><p>{m.chat.m2}</p><span>{m.chat.times[1]}</span></div>
                <div class="bubble bubble--in"><p>{m.chat.m3}</p><span>{m.chat.times[2]}</span></div>
              </div>
              <div class="chat__input">
                <span class="chat__plus"><EIcon name="plus" size={14} /></span>
                <span class="chat__field">{m.chat.placeholder}</span>
                <EIcon name="send" size={16} />
              </div>
            </div>
          </Phone>
        </div>
      </article>

      <article class="bt" data-reveal style="--reveal-i:1">
        <h3 class="bt__title">{m.feed.title}</h3>
        <p class="bt__sub">{m.feed.sub}</p>
        <div class="bt__demo" aria-hidden="true">
          <Phone class="bt__phone">
            <div class="chat">
              <p class="feed__title">{m.feed.screenTitle}</p>
              <article class="post">
                <header class="post__head">
                  <span class="avatar">D</span>
                  <div>
                    <p class="chat__name">{m.feed.group}</p>
                    <p class="chat__status">{m.feed.author} · {m.feed.time}</p>
                  </div>
                </header>
                <p class="post__text">{m.feed.post}</p>
                <div class="post__photo"><i></i><i></i><i></i><i></i><b></b></div>
                <p class="post__react">
                  <span><EIcon name="heart" size={16} /><span class="num">{m.feed.likes}</span></span>
                  <span><EIcon name="chat" size={16} />{m.feed.comments}</span>
                </p>
              </article>
            </div>
          </Phone>
        </div>
      </article>

      <article class="bt" data-reveal style="--reveal-i:2">
        <h3 class="bt__title">{m.broadcast.title}</h3>
        <p class="bt__sub">{m.broadcast.sub}</p>
        <div class="bt__demo bt__demo--flat" aria-hidden="true">
          <div class="win">
            <div class="win__bar"><i></i><i></i><i></i></div>
            <div class="win__body">
              <p class="win__title">{m.broadcast.window}</p>
              <p class="win__to">
                <span class="win__label">{m.broadcast.to}</span>
                <span class="win__select">{m.broadcast.group}<EIcon name="chevron-down" size={16} /></span>
              </p>
              <p class="win__text">{m.broadcast.message}</p>
              <p class="win__foot"><span class="win__send">{m.broadcast.send}</span></p>
            </div>
          </div>
        </div>
      </article>

      <article class="bt" data-reveal style="--reveal-i:3">
        <h3 class="bt__title">{m.announcements.title}</h3>
        <p class="bt__sub">{m.announcements.sub}</p>
        <div class="bt__demo bt__demo--flat" aria-hidden="true">
          <div class="ann">
            <p class="ann__label"><EIcon name="mail" size={16} />{m.announcements.label}</p>
            <h4 class="ann__title">{m.announcements.headline}</h4>
            <p class="ann__body">{m.announcements.body}</p>
            <div class="ann__bar"><span style="width:75%"></span></div>
            <p class="ann__count">{m.announcements.progress}</p>
            <ul class="ann__list">
              {
                m.announcements.readers.map((r) => (
                  <li>
                    <span class="avatar">{r.name[0]}</span>
                    <span class="ann__name">{r.name}</span>
                    <span class="ann__when"><i></i>{r.when}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </article>
    </div>

    <p class="demo-note bento__note">{m.privacy}</p>
    <p class="demo-note bento__note bento__note--tight">{c.demoNote}</p>
  </div>
</section>

<section class="fam" aria-label={m.families.link}>
  <div class="container fam__row">
    <p class="fam__text">{m.families.text}</p>
    <a class="link link-arrow" href={hrefFor('guardian', locale)}>
      {m.families.link}
      <EIcon name="arrow-right" size={18} />
    </a>
  </div>
</section>

<AlsoInAria locale={locale} items={m.also} />
<FinalCta locale={locale} demoHref={contactHref(locale, 'demo')} />

<style>
  .bento {
    padding-block: clamp(40px, 5vw, 64px);
  }
  .bento__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
  }
  .bt {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 24px 24px 0;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--bg);
    box-shadow: 0 1px 2px rgb(8 19 43 / 0.04);
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s var(--ease-out);
  }
  .bt:hover {
    transform: translateY(-2px);
    box-shadow: var(--shadow-pop);
  }
  .bt__title {
    font-size: 22px;
    line-height: 28px;
  }
  .bt__sub {
    margin-top: 2px;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 24px;
  }
  .bt__demo {
    container-type: inline-size;
    flex: 1;
    min-height: 372px;
    margin-top: 20px;
    overflow: hidden;
  }
  .bt__demo--flat {
    padding-bottom: 24px;
  }
  .bt :global(.bt__phone) {
    --phone-w: min(100cqw, 262px);
    margin-inline: auto;
  }
  .bt :global(.phone__bezel) {
    box-shadow: 0 0 0 1px rgb(255 255 255 / 0.12) inset;
  }
  .bt :global(.phone__screen) {
    aspect-ratio: auto;
    height: 408px;
    background: var(--bg);
  }

  .chat {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-height: 0;
    padding: 0 0.9em 0.9em;
  }
  .chat__head {
    display: flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.7em 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9em;
  }
  .chat__name {
    font-weight: 600;
    font-size: 0.95em;
    line-height: 1.2;
  }
  .chat__status {
    color: var(--ink-2);
    font-size: 0.8em;
  }
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    background: var(--cyan-tint);
    color: var(--cyan-ink);
    font-size: 0.85em;
    font-weight: 700;
  }
  .chat__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 0.7em;
    padding-top: 0.9em;
    min-height: 0;
  }
  .bubble {
    max-width: 84%;
    font-size: 0.86em;
  }
  .bubble p {
    padding: 0.6em 0.8em;
    border-radius: 0.9em;
  }
  .bubble span {
    display: block;
    margin-top: 0.2em;
    color: var(--ink-3);
    font-size: 0.8em;
  }
  .bubble--in {
    align-self: flex-start;
  }
  .bubble--in p {
    background: var(--surface);
  }
  .bubble--out {
    align-self: flex-end;
    text-align: right;
  }
  .bubble--out p {
    background: var(--cyan-tint);
    text-align: left;
  }
  html.js .chat--seq .bubble {
    transition:
      opacity 0.3s var(--ease-out),
      transform 0.3s var(--ease-out);
  }
  html.js .chat--seq:not(.is-playing):not(.is-done) .bubble {
    opacity: 0;
    transform: translateY(8px);
  }
  html.js .chat--seq.is-playing .bubble:not(.is-in) {
    opacity: 0;
    transform: translateY(8px);
  }
  @media (prefers-reduced-motion: reduce) {
    html.js .chat--seq .bubble,
    html.js .chat--seq:not(.is-playing):not(.is-done) .bubble,
    html.js .chat--seq.is-playing .bubble:not(.is-in) {
      opacity: 1;
      transform: none;
      transition: none;
    }
    .bt {
      transition: none;
    }
    .bt:hover {
      transform: none;
    }
  }
  .chat__input {
    display: flex;
    align-items: center;
    gap: 0.6em;
    color: var(--ink-3);
    font-size: 0.78em;
  }
  .chat__plus {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.2em;
    height: 2.2em;
    border: 1px solid var(--line);
    border-radius: 50%;
  }
  .chat__field {
    flex: 1;
    padding: 0.7em 1em;
    border: 1px solid var(--line);
    border-radius: 2em;
    background: var(--surface);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .feed__title {
    padding: 0.7em 0;
    border-bottom: 1px solid var(--line);
    font-size: 0.9em;
    font-weight: 600;
    text-align: center;
  }
  .post {
    display: grid;
    gap: 0.7em;
    margin-top: 0.8em;
    font-size: 0.9em;
  }
  .post__head {
    display: flex;
    align-items: center;
    gap: 0.6em;
  }
  .post__text {
    line-height: 1.35;
  }
  .post__photo {
    position: relative;
    height: 13.5em;
    overflow: hidden;
    border-radius: 0.7em;
    background: linear-gradient(160deg, #c9794e, #a95a36);
  }
  /* Track lanes and a baton drawn in CSS: a stand-in for the team photo. */
  .post__photo i {
    position: absolute;
    left: -10%;
    right: -10%;
    height: 2px;
    background: rgb(255 255 255 / 0.7);
    transform: rotate(-12deg);
  }
  .post__photo i:nth-child(1) {
    top: 20%;
  }
  .post__photo i:nth-child(2) {
    top: 42%;
  }
  .post__photo i:nth-child(3) {
    top: 64%;
  }
  .post__photo i:nth-child(4) {
    top: 86%;
  }
  .post__photo b {
    position: absolute;
    left: 34%;
    top: 46%;
    width: 34%;
    height: 0.55em;
    border-radius: 1em;
    background: #00bef3;
    transform: rotate(-24deg);
  }
  .post__react {
    display: flex;
    align-items: center;
    gap: 1.2em;
    color: var(--ink-2);
    font-size: 0.85em;
  }
  .post__react > span {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
  }
  .post__react :global(svg) {
    flex: none;
  }
  .post__react > span:first-child :global(svg) {
    color: #e0457b;
  }

  .win {
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    font-size: 15px;
  }
  .win__bar {
    display: flex;
    gap: 6px;
    padding: 10px 12px;
    border-bottom: 1px solid var(--line);
    background: var(--surface);
  }
  .win__bar i {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }
  .win__bar i:nth-child(1) {
    background: #ff6159;
  }
  .win__bar i:nth-child(2) {
    background: #ffbd2e;
  }
  .win__bar i:nth-child(3) {
    background: #28c840;
  }
  .win__body {
    display: grid;
    gap: 14px;
    padding: 16px;
  }
  .win__title {
    font-family: var(--font-display);
    font-size: 18px;
    font-weight: 600;
  }
  .win__to {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .win__label {
    color: var(--ink-2);
  }
  .win__select {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: space-between;
    padding: 8px 10px;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--surface);
  }
  .win__text {
    min-height: 112px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: 8px;
  }
  .win__foot {
    display: flex;
    justify-content: flex-end;
  }
  .win__send {
    padding: 10px 28px;
    border-radius: var(--radius-ctl);
    background: var(--btn-bg);
    color: var(--btn-ink);
    font-weight: 600;
  }

  .ann {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 10px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--bg);
    font-size: 15px;
    line-height: 22px;
  }
  .ann__label {
    display: flex;
    align-items: center;
    gap: 8px;
    color: var(--cyan-ink);
    font-size: 14px;
    font-weight: 600;
  }
  .ann__title {
    margin: 2px 0 0;
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 23px;
    font-weight: 600;
    color: var(--ink);
  }
  .ann__body {
    color: var(--ink-2);
  }
  .ann__bar {
    height: 8px;
    margin-top: 4px;
    overflow: hidden;
    border-radius: 4px;
    background: var(--surface-2);
  }
  .ann__bar span {
    display: block;
    height: 100%;
    border-radius: 4px;
    background: var(--cyan);
  }
  .ann__count {
    color: var(--ink-2);
    font-size: 14px;
  }
  .ann__list {
    display: grid;
    gap: 10px;
    margin-top: 4px;
  }
  .ann__list li {
    display: grid;
    grid-template-columns: 30px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
  }
  .ann__list .avatar {
    width: 30px;
    height: 30px;
    font-size: 13px;
  }
  .ann__name {
    min-width: 0;
    font-weight: 500;
  }
  .ann__when {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink-2);
    font-size: 13px;
    white-space: nowrap;
  }
  .ann__when i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--mint);
  }

  /* Four columns leave the card about 190 to 280px wide: the read time moves under the name instead of being cut off. */
  @container (max-width: 260px) {
    .ann__list li {
      grid-template-columns: 30px minmax(0, 1fr);
      row-gap: 0;
    }
    .ann__list .avatar {
      grid-row: span 2;
    }
    .ann__when {
      grid-column: 2;
    }
  }

  .bento__note {
    margin-top: 28px;
    text-align: center;
  }
  .bento__note--tight {
    margin-top: 4px;
  }

  .fam {
    padding-block: 36px 0;
  }
  .fam__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px 32px;
    padding: 20px 28px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
  }
  .fam__text {
    font-size: 19px;
    line-height: 28px;
  }

  @media (max-width: 1180px) {
    .bento__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 640px) {
    .bento__grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .bt {
      padding-inline: 18px;
    }
  }
</style>

<script>
  // Chat bubbles arrive one after another, 300 ms apart, the first time the tile scrolls into view.
  const chat = document.querySelector<HTMLElement>('[data-chat]');
  if (chat) {
    const bubbles = Array.from(chat.querySelectorAll<HTMLElement>('.bubble'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const showAll = () => {
      bubbles.forEach((b) => b.classList.add('is-in'));
      chat.classList.add('is-done');
    };
    if (reduced || !('IntersectionObserver' in window)) {
      showAll();
    } else {
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((en) => en.isIntersecting)) return;
          io.disconnect();
          chat.classList.add('is-playing');
          bubbles.forEach((b, i) => window.setTimeout(() => b.classList.add('is-in'), 300 * (i + 1)));
          window.setTimeout(showAll, 300 * (bubbles.length + 1));
        },
        { threshold: 0.4 },
      );
      io.observe(chat);
    }
  }
</script>
