---
import '../../styles/engage/home-showcase.css';
import '../../styles/engage/integrations.css';
import type { Locale } from '../../i18n';
import { useEngage } from '../../i18n/pages/engage';
import { site } from '../../data/site';
import { contactHref } from './links';
import Photo from '../ui/Photo.astro';
import EngageHero from './EngageHero.astro';
import EngageFinal from './EngageFinal.astro';
import AlsoInAria from './AlsoInAria.astro';
import EIcon from './EIcon.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const e = useEngage(locale);
const g = e.integrations;
const bars = [86, 64, 74];
---

<EngageHero
  variant="orbit"
  eyebrow={g.eyebrow}
  title={g.title}
  sub={g.sub}
  ctas={[{ label: g.ctaPrimary, href: site.signUp }]}
>
  <div slot="after">
    <p class="live__coming">{g.coming}</p>
  </div>

  <div slot="media" class="media-frame eg-ih" aria-hidden="true">
    <img class="eg-ih__bg" src="/home/img/panel-wrist-closeup-800.webp" alt="" width="800" height="1200" loading="eager" decoding="async" />
    <div class="vid-shade"></div>
    <span class="eg-ih__live"><i class="dot-live"></i>{g.liveLabel}</span>
    <div class="int-orbit eg-ih__orbit">
      <i class="ring-path"></i>
      <div class="hub">
        <svg viewBox="0 0 48 48" fill="none" aria-hidden="true"><ellipse cx="24" cy="24" rx="20" ry="10.5" transform="rotate(-24 24 24)" stroke="#00BEF3" stroke-width="2.6"></ellipse><ellipse cx="24" cy="23" rx="9" ry="5.6" stroke="#08132B" stroke-width="4"></ellipse><circle cx="40" cy="9.5" r="3.6" fill="#00BEF3"></circle><circle cx="7.5" cy="31" r="3.6" fill="#8B5CF6"></circle></svg>
      </div>
      <div class="sat sat-a">
        <span class="ic ic-apple"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-4.5-9-9.5C1.6 8 4 4 7.5 4c2 0 3.5 1.2 4.5 2.6C13 5.2 14.5 4 16.5 4 20 4 22.4 8 21 11.5 19 16.5 12 21 12 21z" fill="#FF2D55"></path></svg></span>{g.sources[0].name}
      </div>
      <div class="sat sat-b">
        <span class="ic ic-hc"><svg width="22" height="22" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 21s-7-4.5-9-9.5C1.6 8 4 4 7.5 4c2 0 3.5 1.2 4.5 2.6C13 5.2 14.5 4 16.5 4 20 4 22.4 8 21 11.5 19 16.5 12 21 12 21z" fill="none" stroke="#1A73E8" stroke-width="2.4"></path></svg></span>{g.sources[1].name}
      </div>
      {g.rows.map((r, i) => (<span class="eg-dchip" data-from={i % 2 === 0 ? 'a' : 'b'}><EIcon name={r.icon as 'moon'} size={18} />{r.label}</span>))}
    </div>
  </div>
</EngageHero>

<section class="show impact eg-stage eg-int" data-section aria-labelledby="live-title">
  <div class="wrap">
    <h2 id="live-title" class="d d3 eg-stage-title lines"><span><span>{g.liveLabel}</span></span></h2>
    <ul class="eg-int__grid" data-tilt>
      {
        g.sources.map((s, i) => (
          <li class="eg-tile eg-src rv" style={`--i:${i}`}>
            <header class="eg-src__head">
              <span class="eg-src__tile"><EIcon name="phone" size={24} /></span>
              <div class="eg-src__name">
                <h3>{s.name}</h3>
                <p>{s.platform}</p>
              </div>
              <span class="eg-pill"><EIcon name="check" size={14} />{g.live}</span>
            </header>
            <ul class="eg-src__rows">
              {g.rows.map((r, n) => (<li style={`--k:${n};--w:${bars[n]}%`}><EIcon name={r.icon as 'moon'} size={20} /><span>{r.label}</span><i aria-hidden="true"></i></li>))}
            </ul>
          </li>
        ))
      }
      <li class="eg-tile eg-src eg-src--files rv" style="--i:2">
        <header class="eg-src__head">
          <span class="eg-src__tile"><EIcon name="file" size={24} /></span>
          <div class="eg-src__name"><h3>{g.import.title}</h3></div>
        </header>
        <div class="eg-drop">
          <ul class="eg-drop__files">
            {g.import.formats.map((f, n) => (<li class="fnum" style={`--k:${n}`}><EIcon name="file" size={18} />{f}</li>))}
          </ul>
          <p>{g.import.body}</p>
        </div>
      </li>
    </ul>

    <article class="panel reading eg-mine rv" aria-labelledby="mine-title">
      <div class="eg-mine__copy">
        <h2 id="mine-title" class="t-title">{g.dataTitle}</h2>
        <ul class="eg-mine__list">
          {g.data.map((d, i) => (<li class="rv" style={`--i:${i + 1}`}><span><EIcon name={(['users', 'download'] as const)[i]} size={22} /></span>{d}</li>))}
        </ul>
      </div>
      <div class="eg-mine__photo rv">
        <div class="eg-mine__clip">
          <Photo slot="f9-integrations" ratio="4/3" sizes="(max-width: 1024px) 90vw, 520px" widths={[480, 800, 1200]} alt={g.photoAlt} locale={locale} />
        </div>
      </div>
    </article>
  </div>
</section>

<AlsoInAria locale={locale} items={g.also} />
<EngageFinal locale={locale} demoHref={contactHref(locale, 'demo')} />

<script>
  import '../../scripts/engage/integrations';
</script>
