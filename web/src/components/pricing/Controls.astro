---
import type { Locale } from '../../i18n';
import { annualDiscountPercent, athleteBands, bandFor, defaultBand } from '../../data/prices';
import { fill } from '../../lib/template';
import type { PricingCopy } from '../../i18n/pages/pricing';

interface Props {
  locale: Locale;
  copy: PricingCopy;
}
const { copy } = Astro.props;
const c = copy.controls;

// The server renders the no-JS default: US, monthly, 100 athletes. The slider holds the band index.
const last = athleteBands.length - 1;
const index = athleteBands.indexOf(defaultBand);
const band = bandFor('us', defaultBand);
const countLabel = band.athletes.toLocaleString('en-US');
const valueText = fill(c.valueText, { athletes: countLabel, coaches: String(band.coaches) });
---

<div class="controls" role="group" aria-label={c.label} data-controls>
  <div class="controls__bill">
    <fieldset class="seg">
      <legend class="sr-only">{c.billingLegend}</legend>
      <i class="seg__thumb" aria-hidden="true"></i>
      <label class="seg__opt">
        <input type="radio" name="pricing-billing" value="monthly" checked data-billing />
        <span class="seg__txt">{c.monthly}</span>
      </label>
      <label class="seg__opt">
        <input type="radio" name="pricing-billing" value="annual" data-billing />
        <span class="seg__txt">{c.annual}</span>
      </label>
    </fieldset>
    <p class="saves">{fill(c.annualSaves, { percent: String(annualDiscountPercent) })}</p>
  </div>

  <div class="roster">
    <label class="roster__label" for="pricing-athletes">
      <span>{c.athletes}</span>
      <b>
        <span data-ath-label>{countLabel}</span>
        <small data-coach-label>{fill(c.coaches, { coaches: String(band.coaches) })}</small>
      </b>
    </label>
    <div class="range" data-range style={`--f:${index / last}`}>
      <input id="pricing-athletes" type="range" min="0" max={last} step="1" value={index} aria-valuetext={valueText} data-athletes />
      <i class="range__trk" aria-hidden="true"></i>
      <i class="range__fil" aria-hidden="true"></i>
      <i class="range__knob" aria-hidden="true"></i>
    </div>
    <div class="ticks" aria-hidden="true" data-ticks>
      {
        athleteBands.map((n, i) => (
          <span class:list={['tk', { on: i === index }]} data-tick={i} style={`--f:${i / last}`}>{n.toLocaleString('en-US')}</span>
        ))
      }
    </div>
  </div>

  <p class="currency">{c.currency}</p>
</div>
<p class="controls-note">{fill(c.noScript, { athletes: String(defaultBand) })}</p>
