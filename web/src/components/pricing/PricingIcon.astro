---
interface Props {
  name: 'users' | 'phone' | 'bars';
  size?: number;
}
const { name, size = 36 } = Astro.props;

const paths = {
  users:
    '<circle cx="9" cy="8" r="3.2"/><path d="M3 19.5c0-3.3 2.7-5.5 6-5.5s6 2.2 6 5.5"/><circle cx="17" cy="9" r="2.6"/><path d="M16.5 14.2c3 0 4.7 1.8 4.7 4.3"/>',
  phone: '<rect x="7" y="2.5" width="10" height="19" rx="2.4"/><path d="M11 18.5h2"/>',
  bars: '<rect x="4" y="12" width="3.4" height="8" rx="0.8"/><rect x="10.3" y="7" width="3.4" height="13" rx="0.8"/><rect x="16.6" y="3.5" width="3.4" height="16.5" rx="0.8"/>',
};
---

<svg
  viewBox="0 0 24 24"
  width={size}
  height={size}
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>
