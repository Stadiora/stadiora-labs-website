---
import type { Locale } from '../../i18n';
import { annualDiscountPercent, free } from '../../data/prices';
import { fill } from '../../lib/template';
import type { PricingCopy } from '../../i18n/pages/pricing';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
  copy: PricingCopy;
}
const { copy } = Astro.props;
// FAQ answers may carry {athletes} (Free limit) and {percent} (annual discount); the table supplies both.
const faqValues = { athletes: String(free.athletes), percent: String(annualDiscountPercent) };
---

<section class="section faq" aria-labelledby="faq-title">
  <div class="container">
    <h2 class="faq__title" id="faq-title" data-reveal>{copy.faq.title}</h2>
    <div class="faq__list" data-reveal>
      {
        copy.faq.items.map((item) => (
          <details class="faq__item">
            <summary class="faq__q">
              <span>{item.q}</span>
              <span class="faq__mark" aria-hidden="true">
                <Icon name="plus" size={22} class="faq__plus" />
                <Icon name="minus" size={22} class="faq__minus" />
              </span>
            </summary>
            <p class="faq__a">{fill(item.a, faqValues)}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: 64px var(--section-pad);
  }
  .faq__title {
    margin-bottom: 20px;
    font-size: 40px;
    line-height: 46px;
  }
  .faq__item {
    border-bottom: 1px solid var(--line);
  }
  .faq__item:first-child {
    border-top: 1px solid var(--line);
  }
  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 64px;
    padding: 12px 4px;
    font-size: 19px;
    font-weight: 500;
    line-height: 26px;
    cursor: pointer;
    list-style: none;
  }
  .faq__q::-webkit-details-marker {
    display: none;
  }
  .faq__q:focus-visible {
    border-radius: 6px;
  }
  .faq__mark {
    display: grid;
    flex: none;
    place-items: center;
    width: 44px;
    height: 44px;
    color: var(--ink-2);
  }
  .faq__mark > :global(svg) {
    grid-area: 1 / 1;
  }
  .faq__item:not([open]) .faq__mark :global(.faq__minus),
  .faq__item[open] .faq__mark :global(.faq__plus) {
    display: none;
  }
  .faq__a {
    max-width: 820px;
    padding: 0 60px 24px 4px;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 26px;
  }

  @media (max-width: 720px) {
    .faq {
      padding-block: 48px var(--section-pad);
    }
    .faq__title {
      font-size: 30px;
      line-height: 36px;
    }
    .faq__q {
      font-size: 17px;
      line-height: 24px;
    }
    .faq__a {
      padding-right: 8px;
      font-size: 16px;
      line-height: 24px;
    }
  }
</style>
