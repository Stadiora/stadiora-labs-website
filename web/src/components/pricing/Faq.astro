---
import type { Locale } from '../../i18n';
import { annualDiscountPercent, free } from '../../data/prices';
import { fill } from '../../lib/template';
import type { PricingCopy } from '../../i18n/pages/pricing';

interface Props {
  locale: Locale;
  copy: PricingCopy;
}
const { copy } = Astro.props;
// FAQ answers may carry {athletes} (Free limit) and {percent} (annual discount); the table supplies both.
const faqValues = { athletes: String(free.athletes), percent: String(annualDiscountPercent) };
---

<section class="sec faq" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <div>
      <p class="eyebrow rv">{copy.faq.eyebrow}</p>
      <h2 class="d d2 lines" id="faq-title">
        <span><span>{copy.faq.heading[0]}</span></span><span><span style="--i:1">{copy.faq.heading[1]}</span></span>
      </h2>
    </div>
    <div class="faq__list rv" data-faq>
      {
        copy.faq.items.map((item, i) => (
          <div class="faq__item">
            <h3 class="faq__h">
              <button class="faq__q" type="button" id={`faq-q-${i}`} aria-expanded="false" aria-controls={`faq-a-${i}`} data-reveal-btn>
                <span>{item.q}</span>
                <i class="pm" aria-hidden="true">+</i>
              </button>
              <span class="faq__static">{item.q}</span>
            </h3>
            <div class="reveal faq__a" id={`faq-a-${i}`}>
              <div>
                <p>{fill(item.a, faqValues)}</p>
              </div>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
