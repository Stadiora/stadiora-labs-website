---
import type { Locale } from '../../i18n';
import { bandFor, defaultBand, free, usd } from '../../data/prices';
import { fill } from '../../lib/template';
import type { PricingCopy } from '../../i18n/pages/pricing';
import Icon from '../ui/Icon.astro';
import { pricingLinks } from './links';

type PlanKey = 'free' | 'core' | 'performance' | 'federations';

interface Props {
  plan: PlanKey;
  locale: Locale;
  copy: PricingCopy;
  /** Position in the row, for the staggered entrance. */
  index: number;
}
const { plan, locale, copy, index } = Astro.props;
const p = copy.plans[plan];
const links = pricingLinks(locale);

// Server-rendered state is always US, monthly, 100 athletes: the no-JS default. The client script
// swaps in the visitor's region and selection; the other region's numbers never reach the HTML.
const band = bandFor('us', defaultBand);
const meta = fill(copy.price.meta, { athletes: band.athletes.toLocaleString('en-US'), coaches: String(band.coaches) });
const amount = plan === 'core' ? usd(band.core.monthly) : plan === 'performance' ? usd(band.performance.monthly) : '';
const freeLine = fill(copy.plans.free.line, { coaches: String(free.coaches), athletes: String(free.athletes) });

const cta = {
  free: { href: links.free, label: copy.plans.free.cta, variant: 'secondary' },
  core: { href: links.core, label: copy.plans.core.cta, variant: 'primary' },
  performance: { href: links.performance, label: copy.plans.performance.cta, variant: 'primary' },
  federations: { href: links.talk, label: copy.plans.federations.cta, variant: 'secondary' },
}[plan];
const headingId = `plan-${plan}`;
---

<li class={`pcard rv pcard--${plan}`} data-plan={plan} style={`--i:${index}`}>
  {plan === 'performance' && <p class="pcard__badge">{copy.plans.performance.badge}</p>}
  <h3 class="pcard__name" id={headingId}>{p.name}</h3>

  <p class:list={['pcard__price num', plan === 'federations' && 'pcard__price--text']}>
    {plan === 'free' && <span class="pcard__amount">{usd(free.monthly)}</span>}
    {plan === 'federations' && <span class="pcard__amount">{copy.plans.federations.price}</span>}
    {(plan === 'core' || plan === 'performance') && <span class="pcard__amount" data-amount={plan}>{amount}</span>}
    {(plan === 'core' || plan === 'performance') && <span class="pcard__unit">{copy.price.unit}</span>}
  </p>

  <div class="pcard__lines">
    {
      (plan === 'core' || plan === 'performance') && (
        <>
          <p data-meta>{meta}</p>
          <p data-billed>{copy.price.billedMonthly}</p>
        </>
      )
    }
    {
      plan === 'free' && (
        <>
          <p>{freeLine}</p>
          <p>{copy.plans.free.sub}</p>
        </>
      )
    }
    {plan === 'federations' && <p>{copy.plans.federations.line}</p>}
  </div>

  <div class="pcard__cta">
    <a
      class={`btn btn--${cta.variant}`}
      href={cta.href}
      aria-describedby={headingId}
    >{cta.label}</a>
  </div>

  <ul class="pcard__checks">
    {
      p.checks.map((item) => (
        <li>
          <Icon name="check" size={18} class="pcard__tick" />
          <span>{item}</span>
        </li>
      ))
    }
  </ul>

  <button class="pcard__use" type="button" aria-pressed={plan === 'core' ? 'true' : 'false'} aria-describedby={headingId} data-use={plan}>
    <i aria-hidden="true"></i>
    <span>{copy.plans.use}</span>
  </button>
</li>
