---
import type { Locale } from '../../i18n';
import { addOns, usd } from '../../data/prices';
import type { PricingCopy } from '../../i18n/pages/pricing';
import PricingIcon from './PricingIcon.astro';
import PriceText from './PriceText.astro';
import Estimate from './Estimate.astro';
import { brandedFee } from './fees';
import { pricingLinks } from './links';

interface Props {
  locale: Locale;
  copy: PricingCopy;
}
const { locale, copy } = Astro.props;
const a = copy.addons;
const links = pricingLinks(locale);
const more = copy.reveal.more;
---

<section class="sec addons" aria-labelledby="addons-title">
  <div class="wrap">
    <div class="sec-head">
      <div>
        <p class="eyebrow rv">{a.title}</p>
        <h2 class="d d2 lines" id="addons-title">
          <span><span>{a.heading[0]}</span></span><span><span style="--i:1">{a.heading[1]}</span></span>
        </h2>
      </div>
    </div>

    <div class="addons__grid">
      <ul class="addons__list">
        <li class="addon rv" data-addon="extra-coach" data-on="false">
          <div class="addon__top">
            <span class="addon__icon addon__icon--cyan"><PricingIcon name="users" size={26} /></span>
            <div class="addon__text">
              <h3 class="addon__name" id="addon-extra-coach-name">{a.extraCoach.name}</h3>
              <p class="addon__price num"><span data-extra-coach>{usd(addOns.extraCoach.us)}</span><span class="addon__unit">{copy.price.unit}</span></p>
            </div>
            <button class="sw" type="button" role="switch" aria-checked="false" aria-label={a.extraCoach.switch} aria-describedby="addon-extra-coach-na" data-sw="coach"><i></i></button>
          </div>
          <div class="addon__sub">
            <button class="addon__more" type="button" aria-expanded="false" aria-controls="addon-extra-coach" data-reveal-btn>
              <span>{more}<span class="sr-only">: {a.extraCoach.name}</span></span><i class="pm" aria-hidden="true">+</i>
            </button>
            <div class="step" role="group" aria-label={a.extraCoach.stepper} data-stepper>
              <button type="button" data-step="-1" aria-label={a.extraCoach.fewer}><span aria-hidden="true">−</span></button>
              <output data-qty aria-live="off">1</output>
              <button type="button" data-step="1" aria-label={a.extraCoach.more}><span aria-hidden="true">+</span></button>
            </div>
          </div>
          <div class="reveal" id="addon-extra-coach">
            <div>
              <p class="reveal__text">{a.extraCoach.body}</p>
              <p class="addon__fact num"><PriceText text={a.extraCoach.priceLine} values={{ amount: usd(addOns.extraCoach.us) }} attrs={{ amount: { 'data-extra-coach': true } }} /></p>
            </div>
          </div>
          <p class="addon__na" id="addon-extra-coach-na" data-coach-note hidden></p>
        </li>

        <li class="addon rv" data-addon="branded-app" data-on="false" style="--i:1">
          <div class="addon__top">
            <span class="addon__icon addon__icon--violet"><PricingIcon name="phone" size={26} /></span>
            <div class="addon__text">
              <h3 class="addon__name" id="addon-branded-app-name">{a.brandedApp.name}</h3>
              <p class="addon__price num"><PriceText text={a.brandedApp.price} values={brandedFee.values} attrs={brandedFee.marks} /></p>
            </div>
            <button class="sw" type="button" role="switch" aria-checked="false" aria-label={a.brandedApp.switch} data-sw="app"><i></i></button>
          </div>
          <div class="addon__sub">
            <button class="addon__more" type="button" aria-expanded="false" aria-controls="addon-branded-app" data-reveal-btn>
              <span>{more}<span class="sr-only">: {a.brandedApp.name}</span></span><i class="pm" aria-hidden="true">+</i>
            </button>
          </div>
          <div class="reveal" id="addon-branded-app">
            <div>
              <p class="reveal__text">{a.brandedApp.body}</p>
              <p class="addon__fact num"><PriceText text={a.brandedApp.priceLine} values={brandedFee.values} attrs={brandedFee.marks} /></p>
              <p class="reveal__action"><a class="btn btn--secondary btn--sm" href={links.talk}>{a.brandedApp.cta}</a></p>
            </div>
          </div>
        </li>

        <li class="addon rv" data-addon="credits" data-on="false" style="--i:2">
          <div class="addon__top">
            <span class="addon__icon addon__icon--mint"><PricingIcon name="bars" size={26} /></span>
            <div class="addon__text">
              <h3 class="addon__name" id="addon-credits-name">{a.credits.name}</h3>
              <p class="addon__price addon__price--text">{a.credits.price}</p>
            </div>
            <button class="sw" type="button" role="switch" aria-checked="false" aria-label={a.credits.switch} data-sw="ai"><i></i></button>
          </div>
          <div class="addon__sub">
            <button class="addon__more" type="button" aria-expanded="false" aria-controls="addon-credits" data-reveal-btn>
              <span>{more}<span class="sr-only">: {a.credits.name}</span></span><i class="pm" aria-hidden="true">+</i>
            </button>
          </div>
          <div class="reveal" id="addon-credits">
            <div>
              <p class="reveal__text">{a.credits.body}</p>
              <p class="reveal__action"><a class="btn btn--secondary btn--sm" href={links.talk}>{a.credits.cta}</a></p>
            </div>
          </div>
        </li>
      </ul>

      <Estimate locale={locale} copy={copy} />
    </div>
  </div>
</section>
