---
import '../../styles/pricing.css';
import type { Locale } from '../../i18n';
import { defaultBand } from '../../data/prices';
import { en, es, type PricingCopy } from '../../i18n/pages/pricing';
import { pricingLinks } from './links';
import PricingHero from './PricingHero.astro';
import PlanCard from './PlanCard.astro';
import AddOns from './AddOns.astro';
import Faq from './Faq.astro';
import PricingFinal from './PricingFinal.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const copy: PricingCopy = locale === 'es' ? es : en;
const links = pricingLinks(locale);

// Text the client script needs to re-render prices and the estimate. No numbers: those live in its own bundle.
const strings = JSON.stringify({
  billedMonthly: copy.price.billedMonthly,
  billedYearly: copy.price.billedYearly,
  meta: copy.price.meta,
  live: copy.price.live,
  liveYearly: copy.price.liveYearly,
  unit: copy.price.unit,
  core: copy.plans.core.name,
  performance: copy.plans.performance.name,
  free: copy.plans.free.name,
  schools: copy.plans.schools.name,
  federations: copy.plans.federations.name,
  federationsPrice: copy.plans.federations.price,
  creditsPrice: copy.addons.credits.price,
  creditsName: copy.addons.credits.name,
  appName: copy.addons.brandedApp.name,
  coachUnavailable: copy.addons.extraCoach.unavailable,
  valueText: copy.controls.valueText,
  coachesLabel: copy.controls.coaches,
  estimate: copy.estimate,
  cta: {
    free: copy.plans.free.cta,
    core: copy.plans.core.cta,
    performance: copy.plans.performance.cta,
    schools: copy.plans.schools.cta,
    federations: copy.plans.federations.cta,
  },
  links: { ...links, federations: links.talk },
});
const plans = ['free', 'core', 'performance', 'schools', 'federations'] as const;
---

<div class="pricing" data-pricing data-region="us" data-billing="monthly" data-athletes={defaultBand} data-strings={strings}>
  <PricingHero locale={locale} copy={copy} />

  <section class="plans-section" data-section aria-labelledby="plans-title">
    <h2 class="sr-only" id="plans-title">{copy.plansTitle}</h2>
    <div class="wrap">
      <ul class="plans">
        {plans.map((plan, index) => <PlanCard plan={plan} locale={locale} copy={copy} index={index} />)}
      </ul>
    </div>
  </section>

  <AddOns locale={locale} copy={copy} />
  <Faq locale={locale} copy={copy} />
  <PricingFinal locale={locale} copy={copy} />

  <p class="sr-only" role="status" aria-live="polite" data-live></p>
</div>

<!-- Failsafe: if the module below has not started after a moment, switch to the fallback. That is not the
     enhanced state: data-ready means the script runs, data-fallback means it does not. In the fallback the
     controls, switches, estimate and reveal buttons are hidden, every reveal is open, and the note explains that
     the prices shown are US, monthly, 100 athletes, so what is on screen always matches what is selected. -->
<script is:inline>
  setTimeout(function () {
    var el = document.querySelector('[data-pricing]');
    if (el && !el.hasAttribute('data-ready')) el.setAttribute('data-fallback', '');
  }, 2500);
</script>
<script>
  import '../../scripts/pricing';
</script>
