---
import type { Locale } from '../../i18n';
import type { PricingCopy } from '../../i18n/pages/pricing';
import Controls from './Controls.astro';

interface Props {
  locale: Locale;
  copy: PricingCopy;
}
const { locale, copy } = Astro.props;
---

<section class="p-hero impact" data-section aria-labelledby="pricing-title">
  <div class="mesh" aria-hidden="true">
    <i class="b b5"></i><i class="b b1"></i><i class="b b2"></i><i class="b b3"></i><i class="b b4"></i><i class="vig"></i>
  </div>
  <div class="orbits" aria-hidden="true">
    <svg viewBox="0 0 1600 800">
      <ellipse cx="800" cy="400" rx="760" ry="250"></ellipse>
      <ellipse class="dash" cx="800" cy="400" rx="620" ry="190"></ellipse>
      <circle class="fdot" r="8" fill="#00BEF3"></circle>
    </svg>
  </div>

  <div class="wrap p-hero__in">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h1 class="d lines" id="pricing-title">
      <span><span>{copy.h1[0]}</span></span><span><span style="--i:1">{copy.h1[1]}</span></span><span><span class="grad-text" style="--i:2">{copy.h1[2]}</span></span>
    </h1>
    <p class="lead rv">{copy.lead}</p>
    <div class="p-hero__controls rv" style="--i:2">
      <Controls locale={locale} copy={copy} />
    </div>
  </div>
</section>
