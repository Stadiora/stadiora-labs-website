---
import SolutionsPage from '../../layouts/SolutionsPage.astro';
import SxHero from '../solutions/SxHero.astro';
import AthleteMorph from '../solutions/AthleteMorph.astro';
import FinalNight from '../solutions/FinalNight.astro';
import AppTile from '../solutions/AppTile.astro';
import { athleteBrands } from '../solutions/athlete-brands';
import { athletes } from '../../i18n/pages/athletes';
import { site } from '../../data/site';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = athletes[locale];

const glyphs = [
  '<path d="M4.5 6h15v14h-15zM4.5 10.5h15M8.5 3.5v4M15.5 3.5v4"/>',
  '<path d="M7 3.5v7a2.5 2.5 0 0 0 5 0v-7M9.5 3.5v17M17 3.5c-2 1.5-3 4-3 7h3v10"/>',
  '<path d="M6 19.5v-8M12 19.5v-15M18 19.5v-11"/>',
  '<path d="M4 5.5h16v10H12l-4.5 3.5V15.5H4z"/>',
];
---

<SolutionsPage locale={locale} path="/solutions/athletes/" title={c.meta.title} description={c.meta.description}>
  <SxHero locale={locale} variant="split" eyebrow={c.eyebrow} title={`${c.titleBefore}${c.titleUnder}`} lead={c.sub} primary={{ label: c.cta.download, href: '#apps' }}>
    <Fragment slot="title">{c.titleBefore}<span class="lane-under">{c.titleUnder}</span></Fragment>
    <ul slot="copy" class="sx-aplabs" data-sx-ap-labels aria-hidden="true">
      {
        c.apps.map((app, i) => (
          <li class:list={['sx-aplab', { on: i === 0 }]} data-ap-lab style={`--bc:${athleteBrands[app.id].c}`}>
            <b><i></i>{app.name}</b>
            <span>{app.status}</span>
          </li>
        ))
      }
    </ul>
    <AthleteMorph copy={c} />
  </SxHero>

  <section id="apps" class="sx-sec" aria-labelledby="apps-h">
    <div class="wrap">
      <div class="sec-head">
        <h2 class="d d2 lines" id="apps-h"><span><span>{c.appsLabel}</span></span></h2>
      </div>
      <div class="sx-apps__grid">
        {c.apps.map((app, i) => <AppTile app={app} copy={c} {locale} index={i} />)}
      </div>
      <p class="demo-note">{c.screenNote}</p>
    </div>
  </section>

  <section class="sx-stage impact" data-section aria-labelledby="every-h">
    <div class="mesh" aria-hidden="true">
      <i class="b b5"></i><i class="b b1"></i><i class="b b2"></i><i class="b b3"></i><i class="b b4"></i><i class="vig"></i>
    </div>
    <div class="orbits" aria-hidden="true">
      <svg viewBox="0 0 1600 800"><ellipse cx="800" cy="400" rx="760" ry="250"></ellipse><ellipse class="dash" cx="800" cy="400" rx="560" ry="170"></ellipse></svg>
    </div>
    <div class="wrap">
      <div class="sec-head">
        <h2 class="d d2 lines" id="every-h"><span><span>{c.every.title}</span></span></h2>
      </div>
      <ul class="sx-every">
        {
          c.every.items.map((label, i) => (
            <li class="pcard rv" style={`--i:${i}`}>
              <svg viewBox="0 0 24 24" width="36" height="36" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={glyphs[i]} />
              <span>{label}</span>
            </li>
          ))
        }
      </ul>
      <div class="strip rv">
        <p class="strip__text"><strong>{c.coach.title}</strong> {c.coach.text}</p>
      </div>
    </div>
  </section>

  <FinalNight title={c.ctaTitle} actions={[{ label: c.cta.download, href: '#apps' }, { label: c.cta.coach, href: site.signUp }]} />
</SolutionsPage>
