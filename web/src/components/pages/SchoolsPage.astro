---
import SolutionsPage from '../../layouts/SolutionsPage.astro';
import SxHero from '../solutions/SxHero.astro';
import Conveyor from '../solutions/Conveyor.astro';
import FinalNight from '../solutions/FinalNight.astro';
import SchoolCards from '../solutions/SchoolCards.astro';
import SchoolConsent from '../solutions/SchoolConsent.astro';
import RegionPrice from '../ui/RegionPrice.astro';
import Icon from '../ui/Icon.astro';
import { common } from '../../i18n/pages/common';
import { schools } from '../../i18n/pages/schools';
import { solutionsFx } from '../../i18n/pages/solutions-fx';
import { schoolsConveyor } from '../solutions/conveyors';
import { contactHref } from '../../lib/links';
import { hrefFor } from '../../data/nav';
import { SHOW_PRICING } from '../../data/site';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = schools[locale];
const k = common[locale];
const fx = solutionsFx[locale];
---

<SolutionsPage locale={locale} path="/solutions/schools/" title={c.meta.title} description={c.meta.description}>
  <SxHero
    locale={locale}
    variant="split"
    eyebrow={c.eyebrow}
    title={c.title}
    lead={c.sub}
    swap={fx.swap.schools}
    primary={{ label: k.bookSchoolCall, href: contactHref(locale, 'call') }}
    secondary={SHOW_PRICING ? { label: k.seePricing, href: hrefFor('pricing', locale) } : { label: k.talkToUs, href: contactHref(locale, 'question') }}
  >
    <Conveyor variant="mini" blocks={schoolsConveyor.blocks} laneA={schoolsConveyor.laneA} laneB={schoolsConveyor.laneB} />
  </SxHero>

  <SchoolCards copy={c} />

  <SchoolConsent copy={c} />

  <section class="sx-sec strip-section" aria-label={c.pricing.lead}>
    <div class="wrap">
      <div class="strip rv">
        <p class="strip__text">
          <strong>{c.pricing.lead}</strong>{SHOW_PRICING ? <RegionPrice price="coreFrom" text={c.pricing.text} /> : c.pricing.quote}
        </p>
        <div class="strip__actions">
          {SHOW_PRICING && <a class="link link-arrow" href={hrefFor('pricing', locale)}>{c.pricing.link}<Icon name="arrow-right" /></a>}
          <a class="btn btn--primary btn--lg" href={contactHref(locale, 'call')}>{c.pricing.cta}</a>
        </div>
      </div>
    </div>
  </section>

  <FinalNight
    title={k.ctaTitle}
    actions={[
      { label: k.bookSchoolCall, href: contactHref(locale, 'call') },
      SHOW_PRICING ? { label: k.seePricing, href: hrefFor('pricing', locale) } : { label: k.talkToUs, href: contactHref(locale, 'question') },
    ]}
  />
</SolutionsPage>

<style>
  .strip-section {
    padding-block: clamp(48px, 6vw, 80px);
  }
</style>
