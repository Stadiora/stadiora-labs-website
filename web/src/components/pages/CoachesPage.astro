---
import SolutionsPage from '../../layouts/SolutionsPage.astro';
import SxHero from '../solutions/SxHero.astro';
import CoachClip from '../solutions/CoachClip.astro';
import FinalNight from '../solutions/FinalNight.astro';
import DayWithAria from '../solutions/DayWithAria.astro';
import CoachTools from '../solutions/CoachTools.astro';
import RegionPrice from '../ui/RegionPrice.astro';
import { common } from '../../i18n/pages/common';
import { coaches } from '../../i18n/pages/coaches';
import { solutionsFx } from '../../i18n/pages/solutions-fx';
import { contactHref } from '../../lib/links';
import { hrefFor } from '../../data/nav';
import { free } from '../../data/prices';
import { fill } from '../../lib/template';
import { site } from '../../data/site';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = coaches[locale];
const k = common[locale];
const fx = solutionsFx[locale];
// The Free plan's limits come from the shared price table; the copy holds {tokens}.
const freeLimits = { coaches: String(free.coaches), athletes: String(free.athletes) };
---

<SolutionsPage locale={locale} path="/solutions/coaches/" title={c.meta.title} description={fill(c.meta.description, freeLimits)}>
  <SxHero
    locale={locale}
    variant="split"
    eyebrow={c.eyebrow}
    title={c.title}
    lead={c.sub}
    swap={fx.swap.coaches}
    primary={{ label: k.startFree, href: site.signUp }}
    secondary={{ label: k.seePricing, href: hrefFor('pricing', locale) }}
  >
    <CoachClip copy={c} {locale} />
  </SxHero>

  <DayWithAria copy={c} {locale} />
  <CoachTools copy={c} {locale} />

  <section class="sx-sec strip-section" aria-label={c.free.lead}>
    <div class="wrap">
      <div class="strip rv">
        <p class="strip__text"><strong>{c.free.lead}</strong>{fill(c.free.text, freeLimits)}</p>
        <div class="strip__actions">
          <span class="strip__price"><RegionPrice price="coreFrom" text={c.free.core} /></span>
          <a class="btn btn--primary btn--lg" href={site.signUp}>{k.startFree}</a>
        </div>
      </div>
    </div>
  </section>

  <FinalNight title={k.ctaTitle} actions={[{ label: k.startFree, href: site.signUp }, { label: k.bookCall, href: contactHref(locale, 'call') }]} />
</SolutionsPage>

<style>
  .strip-section {
    padding-block: clamp(48px, 6vw, 80px);
  }
  .strip__price {
    color: var(--ink-2);
    font-size: 17px;
  }
</style>
