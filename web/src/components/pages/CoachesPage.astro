---
import Page from '../../layouts/Page.astro';
import FeatureHero from '../solutions/FeatureHero.astro';
import DayWithAria from '../solutions/DayWithAria.astro';
import CoachTools from '../solutions/CoachTools.astro';
import CtaBand from '../ui/CtaBand.astro';
import RegionPrice from '../ui/RegionPrice.astro';
import Photo from '../ui/Photo.astro';
import { common, altFor } from '../../i18n/pages/common';
import { coaches } from '../../i18n/pages/coaches';
import { contactHref } from '../../lib/links';
import { hrefFor } from '../../data/nav';
import { site } from '../../data/site';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = coaches[locale];
const k = common[locale];
---

<Page locale={locale} path="/solutions/coaches/" title={c.meta.title} description={c.meta.description}>
  <FeatureHero
    eyebrow={c.eyebrow}
    title={c.title}
    sub={c.sub}
    primary={{ label: k.startFree, href: site.signUp }}
    secondary={{ label: k.seePricing, href: hrefFor('pricing', locale) }}
  >
    <div class="fhero__photo">
      <Photo slot="s2-coaches" ratio="4/3" sizes="(max-width: 1100px) 92vw, 680px" alt={altFor('s2-coaches', locale)} eager />
    </div>
  </FeatureHero>

  <DayWithAria copy={c} {locale} />
  <CoachTools copy={c} {locale} />

  <section class="strip-section" aria-label={c.free.lead}>
    <div class="container">
      <div class="strip">
        <p class="strip__text"><strong>{c.free.lead}</strong>{c.free.text}</p>
        <div class="strip__actions">
          <span class="strip__price"><RegionPrice price="coreFrom" text={c.free.core} /></span>
          <a class="btn btn--primary btn--lg" href={site.signUp}>{k.startFree}</a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title={k.ctaTitle} actions={[{ label: k.startFree, href: site.signUp }, { label: k.bookDemo, href: contactHref(locale, 'demo') }]} />
</Page>

<style>
  .strip-section {
    padding-block: 72px;
  }
  .strip__price {
    color: var(--ink-2);
    font-size: 17px;
  }
  @media (max-width: 720px) {
    .strip-section {
      padding-block: 48px;
    }
  }
</style>
