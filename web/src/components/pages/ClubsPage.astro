---
import SolutionsPage from '../../layouts/SolutionsPage.astro';
import SxHero from '../solutions/SxHero.astro';
import Conveyor from '../solutions/Conveyor.astro';
import FinalNight from '../solutions/FinalNight.astro';
import SquadWeek from '../solutions/SquadWeek.astro';
import RegionPrice from '../ui/RegionPrice.astro';
import Icon from '../ui/Icon.astro';
import { clubsConveyor } from '../solutions/conveyors';
import { common } from '../../i18n/pages/common';
import { clubs } from '../../i18n/pages/clubs';
import { solutionsFx } from '../../i18n/pages/solutions-fx';
import { contactHref } from '../../lib/links';
import { hrefFor } from '../../data/nav';
import { site } from '../../data/site';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = clubs[locale];
const k = common[locale];
const fx = solutionsFx[locale];
---

<SolutionsPage locale={locale} path="/solutions/teams-and-clubs/" title={c.meta.title} description={c.meta.description}>
  <SxHero
    locale={locale}
    variant="split"
    eyebrow={c.eyebrow}
    title={c.title}
    lead={c.sub}
    primary={{ label: k.bookCall, href: contactHref(locale, 'call') }}
    secondary={{ label: k.seePricing, href: hrefFor('pricing', locale) }}
  >
    <Conveyor variant="grid" {...clubsConveyor} />
  </SxHero>

  <SquadWeek copy={c} fx={fx.clubs} />

  <section class="sx-sec focus" aria-labelledby="focus-title">
    <div class="wrap">
      <h2 class="d d2 lines" id="focus-title"><span><span>{c.focus}</span></span></h2>
      <ul class="focus__cols">
        {
          c.cols.map((col, i) => (
            <li class="pcard rv" style={`--i:${i}`}>
              <h3 class="pcard__title">{col.title}</h3>
              <p class="focus__text">{col.text}</p>
              {col.soon && (
                <p class="focus__soon">
                  <strong>{col.soon.name}</strong> · <span class="focus__tag">{col.soon.tag}</span> <span class="focus__soon-note">({col.soon.text})</span>
                </p>
              )}
            </li>
          ))
        }
      </ul>
      <div class="strip rv">
        <p class="strip__text"><RegionPrice price="coreFrom" text={c.price.text} /></p>
        <div class="strip__actions">
          <a class="link link-arrow" href={hrefFor('pricing', locale)}>{c.price.link}<Icon name="arrow-right" /></a>
          <a class="link link-arrow" href={contactHref(locale, 'question')}>{c.ask}<Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
  </section>

  <FinalNight title={k.ctaTitle} actions={[{ label: c.cta.primary, href: contactHref(locale, 'call') }, { label: c.cta.secondary, href: site.signUp }]} />
</SolutionsPage>

<style>
  .focus__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-block: clamp(32px, 4vw, 56px);
  }
  .focus__text {
    margin-top: 12px;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 26px;
  }
  .focus__soon {
    margin-top: 14px;
    font-size: 16px;
    line-height: 24px;
  }
  .focus__tag {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--cyan-tint);
    color: var(--cyan-ink);
    font-size: 14px;
    font-weight: 600;
  }
  .focus__soon-note {
    color: var(--ink-2);
  }
  @media (max-width: 1100px) {
    .focus__cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
