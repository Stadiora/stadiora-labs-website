---
import Page from '../../layouts/Page.astro';
import FeatureHero from '../solutions/FeatureHero.astro';
import SquadWeek from '../solutions/SquadWeek.astro';
import CtaBand from '../ui/CtaBand.astro';
import RegionPrice from '../ui/RegionPrice.astro';
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';
import { common } from '../../i18n/pages/common';
import { clubs } from '../../i18n/pages/clubs';
import { contactHref } from '../../lib/links';
import { hrefFor } from '../../data/nav';
import { site } from '../../data/site';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = clubs[locale];
const k = common[locale];
---

<Page locale={locale} path="/solutions/teams-and-clubs/" title={c.meta.title} description={c.meta.description}>
  <FeatureHero
    eyebrow={c.eyebrow}
    title={c.title}
    sub={c.sub}
    primary={{ label: k.bookDemo, href: contactHref(locale, 'demo') }}
    secondary={{ label: k.seePricing, href: hrefFor('pricing', locale) }}
  >
    <div class="mosaic">
      <div class="mosaic__cell mosaic__cell--big">
        <Photo slot="h2-academies-big" ratio="4/5" sizes="(max-width: 1100px) 60vw, 440px" {locale} eager />
      </div>
      <div class="mosaic__cell mosaic__cell--top">
        <Photo slot="h2-academies-tile-sq" ratio="1/1" sizes="(max-width: 1100px) 40vw, 360px" {locale} eager />
      </div>
      <div class="mosaic__cell mosaic__cell--bottom">
        <Photo slot="h2-academies-tile-45" ratio="4/5" sizes="(max-width: 1100px) 40vw, 360px" {locale} eager />
      </div>
    </div>
  </FeatureHero>

  <SquadWeek copy={c} />

  <section class="focus" aria-labelledby="focus-title">
    <div class="container">
      <p class="focus__line" id="focus-title">{c.focus}</p>
      <ul class="focus__cols">
        {
          c.cols.map((col, i) => (
            <li class="pcard" data-reveal style={`--reveal-i:${i}`}>
              <h2 class="pcard__title">{col.title}</h2>
              <p class="focus__text">{col.text}</p>
              {col.soon && (
                <p class="focus__soon">
                  <strong>{col.soon.name}</strong> · <span class="focus__tag">{col.soon.tag}</span> <span class="focus__soon-note">({col.soon.text})</span>
                </p>
              )}
            </li>
          ))
        }
      </ul>
      <div class="strip">
        <p class="strip__text"><RegionPrice price="coreFrom" text={c.price.text} /></p>
        <div class="strip__actions">
          <a class="link link-arrow" href={hrefFor('pricing', locale)}>{c.price.link}<Icon name="arrow-right" /></a>
          <a class="link link-arrow" href={contactHref(locale, 'question')}>{c.ask}<Icon name="arrow-right" /></a>
        </div>
      </div>
    </div>
  </section>

  <CtaBand title={k.ctaTitle} actions={[{ label: c.cta.primary, href: contactHref(locale, 'demo') }, { label: c.cta.secondary, href: site.signUp }]} />
</Page>

<style>
  .mosaic {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 10px;
    height: clamp(300px, 34vw, 440px);
  }
  .mosaic__cell {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--surface-2);
  }
  .mosaic__cell--big {
    grid-row: 1 / 3;
  }
  .mosaic__cell :global(.photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .mosaic__cell--top :global(.photo) {
    object-position: 50% 72%;
  }
  .mosaic__cell--bottom :global(.photo) {
    object-position: 50% 52%;
  }
  .focus {
    padding-block: 48px 72px;
  }
  .focus__line {
    color: var(--ink);
    font-family: var(--font-display);
    font-size: clamp(22px, 2.4vw, 30px);
    font-weight: 600;
    line-height: 1.25;
  }
  .focus__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-block: 28px 32px;
  }
  .focus__text {
    margin-top: 12px;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 26px;
  }
  .focus__soon {
    margin-top: 14px;
    font-size: 16px;
    line-height: 24px;
  }
  .focus__tag {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--cyan-tint);
    color: var(--cyan-ink);
    font-size: 14px;
    font-weight: 600;
  }
  .focus__soon-note {
    color: var(--ink-2);
  }
  @media (max-width: 1100px) {
    .mosaic {
      height: clamp(260px, 56vw, 420px);
    }
    .focus__cols {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  @media (max-width: 720px) {
    .focus {
      padding-block: 40px 56px;
    }
  }
</style>
