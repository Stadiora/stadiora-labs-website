---
import SolutionsPage from '../../layouts/SolutionsPage.astro';
import SxHero from '../solutions/SxHero.astro';
import FinalNight from '../solutions/FinalNight.astro';
import AboutWindow from '../solutions/AboutWindow.astro';
import PersonCard from '../company/PersonCard.astro';
import { about } from '../../i18n/pages/about';
import { altFor } from '../../i18n/pages/common';
import LogoMarquee from '../ui/LogoMarquee.astro';
import { useDict, type Locale } from '../../i18n';
import { hrefFor } from '../../data/nav';
import { investorsHref } from '../../lib/links';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = about[locale];
const t = useDict(locale);
const icons = {
  science: 'M9 3h6M10 3v6.2L4.6 18.4A2 2 0 0 0 6.3 21.4h11.4a2 2 0 0 0 1.7-3L14 9.2V3M7.5 15h9',
  access: 'M4 20V13M10 20V9M16 20V5M22 20H2',
};
// The mission copy is "Our mission: make elite-level ..."; the label before the colon becomes the small line above it.
const [missionLabel, ...missionRest] = c.mission.split(/:\s+/);
const missionText = missionRest.join(': ');
---

<SolutionsPage locale={locale} path="/about/" title={c.meta.title} description={c.meta.description}>
  <SxHero locale={locale} variant="split" id="about-hero" eyebrow={c.eyebrow} title={c.title} lead={c.sub}>
    <AboutWindow alt={altFor('c1-about-track', locale)} />
  </SxHero>

  <section class="sx-stage sx-mission impact" data-section aria-labelledby="mission-h">
    <div class="orbits" aria-hidden="true">
      <svg viewBox="0 0 1600 800">
        <ellipse cx="800" cy="400" rx="760" ry="260"></ellipse>
        <ellipse class="dash" cx="800" cy="400" rx="600" ry="200"></ellipse>
        <ellipse cx="800" cy="400" rx="440" ry="140"></ellipse>
        <circle class="fdot fdot--a" r="9" fill="#00BEF3"></circle>
        <circle class="fdot fdot--b" r="7" fill="#8B5CF6"></circle>
      </svg>
    </div>
    <div class="wrap">
      <p class="d sx-mission__line lines" id="mission-h">
        <span><span>{missionLabel && missionText ? <><em class="sx-mission__lead">{missionLabel}:</em> {missionText}</> : c.mission}</span></span>
      </p>
      <div class="sx-values">
        {
          c.values.map((v, i) => (
            <div class="pcard sx-value rv" style={`--i:${i}`}>
              <svg viewBox="0 0 24 24" width="44" height="44" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                {v.id === 'science' && <path d={icons.science} />}
                {v.id === 'access' && <path d={icons.access} />}
                {v.id === 'coaches' && (
                  <>
                    <circle cx="12" cy="6.5" r="2.7" />
                    <circle cx="5.2" cy="9.2" r="2.1" />
                    <circle cx="18.8" cy="9.2" r="2.1" />
                    <path d="M7.6 20v-3.4a4.4 4.4 0 0 1 8.8 0V20M1.6 17v-1.5a3.4 3.4 0 0 1 4.2-3.3M22.4 17v-1.5a3.4 3.4 0 0 0-4.2-3.3" />
                  </>
                )}
              </svg>
              <div>
                <h2>{v.title}</h2>
                <p>{v.text}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="sx-sec sx-team" aria-labelledby="team-title">
    <div class="wrap">
      <div class="sx-team__head">
        <h2 id="team-title" class="d lines"><span><span>{c.team.title}</span></span></h2>
        <p class="rv">{c.team.hint}</p>
      </div>
      <ul class="sx-team__grid">
        {
          c.team.people.map((person, i) => (
            <li class="rv" style={`--i:${i % 4}`}>
              <PersonCard {person} linkLabel={c.team.linkLabel} closeLabel={c.team.close} />
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="sx-partners" aria-labelledby="partners-label">
    <div class="wrap sx-partners__inner">
      <div class="sx-partners__count">
        <p id="partners-label">{t.logos.label}</p>
        <p class="sx-partners__num num d">{t.logos.count}</p>
      </div>
      <LogoMarquee class="sx-partners__list" surface="theme" host label={t.logos.listLabel} />
    </div>
  </section>

  <FinalNight
    title={c.work.title}
    actions={[
      { label: c.work.contact, href: hrefFor('contact', locale) },
      { label: c.work.investors, href: investorsHref },
    ]}
  />
</SolutionsPage>

<script>
  import '../../scripts/team-popover';
</script>
