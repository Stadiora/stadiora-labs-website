---
import SolutionsPage from '../../layouts/SolutionsPage.astro';
import SxHero from '../solutions/SxHero.astro';
import FinalNight from '../solutions/FinalNight.astro';
import Photo from '../ui/Photo.astro';
import { caseStudies } from '../../i18n/pages/caseStudies';
import { common } from '../../i18n/pages/common';
import { site } from '../../data/site';
import { contactHref } from '../../lib/links';
import { localePath } from '../../i18n';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = caseStudies[locale];
const k = common[locale];
// There are no real stories yet. Placeholder cards exist only in `astro dev`, never in the built site.
const dev = import.meta.env.DEV;
const storyHref = localePath('/resources/case-studies/sample-story/', locale);
const featured = c.dev.featured;
---

<SolutionsPage locale={locale} path="/resources/case-studies/" title={c.meta.title} description={c.meta.description} noindex>
  <SxHero locale={locale} variant="compact" title={c.title} lead={c.sub}>
    <section slot="below" class="cs" data-outcome-filter aria-label={c.title}>
      <div class="filter">
        <p class="filter__label" id="filter-label">{c.filterLabel}</p>
        <div class="filter__chips" role="group" aria-labelledby="filter-label">
          {
            c.outcomes.map((o, i) => (
              <button class="chip" type="button" data-outcome={o.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                {o.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="stage" data-outcome-stage>
        {
          dev && (
            <div class="grid">
              <article class="story story--featured" data-outcomes={featured.outcome} data-placeholder>
                <div class="story__photo">
                  <Photo slot={featured.slot} ratio="16/9" sizes="(max-width: 900px) 92vw, 720px" {locale} />
                </div>
                <div class="story__body">
                  <div class="story__top">
                    <p class="stamp"><span class="dot dot--amber" aria-hidden="true"></span>{c.dev.stamp}</p>
                    <p class="logo-slot">{c.dev.story.logo}</p>
                  </div>
                  <h2 class="story__title"><a href={storyHref}>{featured.title}</a></h2>
                  <p class="story__meta">{featured.meta}</p>
                  <p class="story__stat"><span class="num">{featured.stat}</span> {featured.label}</p>
                </div>
              </article>
              {c.dev.cards.map((card) => (
                <article class="story" data-outcomes={card.outcome} data-placeholder>
                  <div class="story__photo">
                    <Photo slot={card.slot} ratio="16/9" sizes="(max-width: 900px) 92vw, 420px" {locale} />
                    <p class="stamp stamp--on-photo"><span class="dot dot--amber" aria-hidden="true"></span>{c.dev.stamp}</p>
                  </div>
                  <div class="story__body">
                    <h2 class="story__title"><a href={storyHref}>{card.title}</a></h2>
                    <p class="story__meta">{card.meta}</p>
                    <p class="story__stat"><span class="num">{card.stat}</span> {card.label}</p>
                  </div>
                </article>
              ))}
            </div>
          )
        }

        <div class="empty pcard" data-outcome-empty hidden={dev}>
          <p class="empty__title" data-empty-all>{c.empty.all}</p>
          <p class="empty__title" data-empty-outcome data-template={c.empty.outcome} hidden>
            <span data-empty-label></span> <span class="empty__hint">{c.empty.hint}</span>
          </p>
        </div>
      </div>
    </section>
  </SxHero>

  <section class="sx-sec share-section" aria-label={c.share.title}>
    <div class="wrap">
      <div class="strip share rv">
        <p class="strip__text">{c.share.title}</p>
        <div class="strip__actions">
          <a class="btn btn--secondary btn--lg" href={contactHref(locale, 'question')}>{c.share.cta}</a>
        </div>
      </div>
    </div>
  </section>

  <FinalNight title={k.ctaTitle} actions={[{ label: k.bookCall, href: contactHref(locale, 'call') }, { label: k.startFree, href: site.signUp }]} />
</SolutionsPage>

<style>
  .share-section {
    padding-block: clamp(48px, 6vw, 80px);
  }
  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }
  .filter__label {
    color: #fff;
    font-size: 18px;
    font-weight: 500;
  }
  .filter__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  /* Without JavaScript the chips cannot filter, so they are hidden. */
  :global(html:not(.js)) .filter {
    display: none;
  }
  .chip {
    min-height: 44px;
    padding: 0 20px;
    border: 1.5px solid rgba(255, 255, 255, 0.35);
    border-radius: 999px;
    background: transparent;
    color: #fff;
    font-family: var(--font-body);
    font-size: 16px;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s,
      transform 0.3s var(--e-spring, cubic-bezier(0.34, 1.56, 0.64, 1));
  }
  .chip:hover {
    background: rgba(255, 255, 255, 0.12);
  }
  .chip:active {
    transform: scale(0.96);
  }
  .chip[aria-pressed='true'] {
    border-color: #fff;
    background: #fff;
    color: #08132b;
    font-weight: 600;
  }
  .stage {
    margin-top: 28px;
    transition: opacity 0.2s ease;
  }
  .stage.is-fading {
    opacity: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .story {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 24px;
    background: rgba(9, 18, 40, 0.58);
    -webkit-backdrop-filter: blur(16px);
    backdrop-filter: blur(16px);
    color: #fff;
  }
  .story[hidden] {
    display: none;
  }
  .story--featured {
    grid-column: 1 / -1;
    flex-direction: row;
  }
  .story--featured .story__photo {
    flex: 1.35;
    min-height: 260px;
  }
  .story--featured .story__photo :global(.photo) {
    position: absolute;
    inset: 0;
  }
  .story--featured .story__body {
    flex: 1;
    padding: 28px;
  }
  .story__photo {
    position: relative;
    min-width: 0;
    overflow: hidden;
  }
  .story__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 24px 24px;
  }
  .story__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .story__title {
    font-size: 24px;
    line-height: 30px;
  }
  .story__title a {
    color: inherit;
    text-decoration: none;
  }
  .story__title a:hover {
    text-decoration: underline;
  }
  .story__meta {
    color: #c4cedd;
    font-size: 16px;
  }
  .story__stat {
    margin-top: auto;
    padding-top: 12px;
    color: #c4cedd;
    font-size: 16px;
  }
  .story__stat .num {
    margin-right: 6px;
    color: #fff;
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
  }
  .stamp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #fff;
    font-size: 14px;
  }
  .stamp--on-photo {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 12px;
    border-radius: 8px;
    background: rgba(4, 10, 26, 0.85);
  }
  .logo-slot {
    padding: 14px 18px;
    border: 1.5px dashed #8d99ae;
    border-radius: 8px;
    color: #c4cedd;
    font-size: 14px;
  }
  .empty {
    display: grid;
    place-items: center;
    min-height: 200px;
    text-align: center;
  }
  .empty:hover,
  .empty:focus-within {
    transform: none;
    box-shadow: none;
  }
  .empty[hidden] {
    display: none;
  }
  .empty__title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.3;
  }
  .empty__hint {
    display: block;
    margin-top: 6px;
    color: #c4cedd;
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 400;
  }
  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .story--featured {
      flex-direction: column;
    }
    .story--featured .story__photo {
      flex: none;
      min-height: 0;
    }
    .story--featured .story__photo :global(.photo) {
      position: static;
    }
  }
  @media (max-width: 720px) {
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .chip {
      flex: 1 1 auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage,
    .chip {
      transition: none;
    }
  }
</style>

<script>
  import '../../scripts/outcome-filter';
</script>
