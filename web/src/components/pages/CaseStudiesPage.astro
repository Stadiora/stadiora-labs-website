---
import Page from '../../layouts/Page.astro';
import Photo from '../ui/Photo.astro';
import { caseStudies } from '../../i18n/pages/caseStudies';
import { contactHref } from '../../lib/links';
import { localePath } from '../../i18n';
import type { Locale } from '../../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = caseStudies[locale];
// There are no real stories yet. Placeholder cards exist only in `astro dev`, never in the built site.
const dev = import.meta.env.DEV;
const storyHref = localePath('/resources/case-studies/sample-story/', locale);
const featured = c.dev.featured;
---

<Page locale={locale} path="/resources/case-studies/" title={c.meta.title} description={c.meta.description} noindex>
  <section class="cs-head">
    <div class="container">
      <h1 class="cs-head__title">{c.title}</h1>
      <p class="cs-head__sub">{c.sub}</p>
    </div>
  </section>

  <section class="cs" data-outcome-filter aria-label={c.title}>
    <div class="container">
      <div class="filter">
        <p class="filter__label" id="filter-label">{c.filterLabel}</p>
        <div class="filter__chips" role="group" aria-labelledby="filter-label">
          {
            c.outcomes.map((o, i) => (
              <button class="chip" type="button" data-outcome={o.id} aria-pressed={i === 0 ? 'true' : 'false'}>
                {o.label}
              </button>
            ))
          }
        </div>
      </div>

      <div class="stage" data-outcome-stage>
        {
          dev && (
            <div class="grid">
              <article class="story story--featured" data-outcomes={featured.outcome} data-placeholder>
                <div class="story__photo">
                  <Photo slot={featured.slot} ratio="16/9" sizes="(max-width: 900px) 92vw, 720px" {locale} />
                </div>
                <div class="story__body">
                  <div class="story__top">
                    <p class="stamp"><span class="dot dot--amber" aria-hidden="true"></span>{c.dev.stamp}</p>
                    <p class="logo-slot">{c.dev.story.logo}</p>
                  </div>
                  <h2 class="story__title"><a href={storyHref}>{featured.title}</a></h2>
                  <p class="story__meta">{featured.meta}</p>
                  <p class="story__stat"><span class="num">{featured.stat}</span> {featured.label}</p>
                </div>
              </article>
              {c.dev.cards.map((card) => (
                <article class="story" data-outcomes={card.outcome} data-placeholder>
                  <div class="story__photo">
                    <Photo slot={card.slot} ratio="16/9" sizes="(max-width: 900px) 92vw, 420px" {locale} />
                    <p class="stamp stamp--on-photo"><span class="dot dot--amber" aria-hidden="true"></span>{c.dev.stamp}</p>
                  </div>
                  <div class="story__body">
                    <h2 class="story__title"><a href={storyHref}>{card.title}</a></h2>
                    <p class="story__meta">{card.meta}</p>
                    <p class="story__stat"><span class="num">{card.stat}</span> {card.label}</p>
                  </div>
                </article>
              ))}
            </div>
          )
        }

        <div class="empty pcard" data-outcome-empty hidden={dev}>
          <p class="empty__title" data-empty-all>{c.empty.all}</p>
          <p class="empty__title" data-empty-outcome data-template={c.empty.outcome} hidden>
            <span data-empty-label></span> <span class="empty__hint">{c.empty.hint}</span>
          </p>
        </div>
      </div>

      <div class="strip share">
        <p class="strip__text">{c.share.title}</p>
        <div class="strip__actions">
          <a class="btn btn--secondary btn--lg" href={contactHref(locale, 'question')}>{c.share.cta}</a>
        </div>
      </div>
    </div>
  </section>
</Page>

<style>
  .cs-head {
    padding-block: 48px 8px;
  }
  .cs-head__title {
    font-size: clamp(36px, 4.6vw, 60px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .cs-head__sub {
    margin-top: 12px;
    color: var(--ink-2);
    font-size: clamp(18px, 1.7vw, 24px);
    line-height: 1.4;
  }
  .cs {
    padding-block: 24px 80px;
  }
  .filter {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }
  .filter__label {
    font-size: 18px;
    font-weight: 500;
  }
  .filter__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  /* Without JavaScript the chips cannot filter, so they are hidden. */
  :global(html:not(.js)) .filter {
    display: none;
  }
  .chip {
    min-height: 44px;
    padding: 0 20px;
    border: 1.5px solid var(--btn-line);
    border-radius: var(--radius-ctl);
    background: var(--bg);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 16px;
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .chip:hover {
    background: var(--surface);
  }
  .chip[aria-pressed='true'] {
    border-color: var(--btn-bg);
    background: var(--btn-bg);
    color: var(--btn-ink);
    font-weight: 500;
  }
  .stage {
    margin-top: 28px;
    transition: opacity 0.2s ease;
  }
  .stage.is-fading {
    opacity: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
  }
  .story {
    display: flex;
    flex-direction: column;
    min-width: 0;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--bg);
  }
  .story[hidden] {
    display: none;
  }
  .story--featured {
    grid-column: 1 / -1;
    flex-direction: row;
  }
  .story--featured .story__photo {
    flex: 1.35;
    min-height: 260px;
  }
  .story--featured .story__photo :global(.photo) {
    position: absolute;
    inset: 0;
  }
  .story--featured .story__body {
    flex: 1;
    padding: 28px;
  }
  .story__photo {
    position: relative;
    min-width: 0;
    overflow: hidden;
  }
  .story__body {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 20px 24px 24px;
  }
  .story__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }
  .story__title {
    font-size: 24px;
    line-height: 30px;
  }
  .story__title a {
    color: inherit;
    text-decoration: none;
  }
  .story__title a:hover {
    text-decoration: underline;
  }
  .story__meta {
    color: var(--ink-2);
    font-size: 16px;
  }
  .story__stat {
    margin-top: auto;
    padding-top: 12px;
    color: var(--ink-2);
    font-size: 16px;
  }
  .story__stat .num {
    margin-right: 6px;
    color: var(--ink);
    font-size: 40px;
    font-weight: 700;
    line-height: 1;
  }
  .stamp {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    font-size: 14px;
  }
  .stamp--on-photo {
    position: absolute;
    top: 12px;
    left: 12px;
    padding: 4px 12px;
    border-radius: 8px;
    background: var(--bg);
  }
  .logo-slot {
    padding: 14px 18px;
    border: 1.5px dashed var(--ink-3);
    border-radius: 8px;
    color: var(--ink-2);
    font-size: 14px;
  }
  .empty {
    display: grid;
    place-items: center;
    min-height: 200px;
    text-align: center;
  }
  .empty[hidden] {
    display: none;
  }
  .empty__title {
    font-family: var(--font-display);
    font-size: 24px;
    font-weight: 600;
    line-height: 1.3;
  }
  .empty__hint {
    display: block;
    margin-top: 6px;
    color: var(--ink-2);
    font-family: var(--font-body);
    font-size: 17px;
    font-weight: 400;
  }
  .share {
    margin-top: 32px;
  }
  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .story--featured {
      flex-direction: column;
    }
    .story--featured .story__photo {
      flex: none;
      min-height: 0;
    }
    .story--featured .story__photo :global(.photo) {
      position: static;
    }
  }
  @media (max-width: 720px) {
    .cs-head {
      padding-block: 32px 4px;
    }
    .cs {
      padding-bottom: 56px;
    }
    .grid {
      grid-template-columns: minmax(0, 1fr);
    }
    .chip {
      flex: 1 1 auto;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .stage {
      transition: none;
    }
  }
</style>

<script>
  import '../../scripts/outcome-filter';
</script>
