---
import { Image } from 'astro:assets';
import anthony from '../../assets/team/anthony.webp';
import ian from '../../assets/team/ian.webp';
import karla from '../../assets/team/karla.webp';
import joel from '../../assets/team/joel.webp';
import Icon from '../ui/Icon.astro';
import type { Person } from '../../i18n/pages/about';

interface Props {
  person: Person;
  linkLabel: string;
  closeLabel: string;
}
const { person, linkLabel, closeLabel } = Astro.props;
const portraits = { anthony, ian, karla, joel };
const portrait = person.portrait ? portraits[person.portrait] : undefined;
const initials = person.name
  .replace(/^Dr\.\s+/, '')
  .split(/\s+/)
  .filter((_, i, all) => i === 0 || i === all.length - 1)
  .map((word) => word[0])
  .join('')
  .toUpperCase();
---

<details class="person" data-person>
  <summary class="person__summary">
    <span class="person__avatar" aria-hidden="true">
      {portrait ? <Image src={portrait} alt="" width={128} height={128} densities={[1, 2]} loading="lazy" /> : <span>{initials}</span>}
    </span>
    <span class="person__id">
      <span class="person__name">{person.name}</span>
      <span class="person__role">{person.role}</span>
    </span>
    <Icon name="chevron-down" size={18} class="person__chev" />
  </summary>
  <div class="person__pop">
    <p class="person__bio">{person.bio}</p>
    <div class="person__foot">
      <a class="link-arrow" href={person.href} target="_blank" rel="noopener noreferrer">
        {linkLabel}<span class="sr-only"> · {person.name}</span>
        <Icon name="arrow-right" size={16} />
      </a>
      <button class="person__close" type="button" data-person-close>{closeLabel}</button>
    </div>
  </div>
</details>

<style>
  .person {
    position: relative;
    min-width: 0;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--bg);
  }
  .person[open] {
    z-index: 3;
    border-color: var(--cyan-ink);
  }
  .person__summary {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 16px 18px;
    height: 100%;
    border-radius: inherit;
    cursor: pointer;
    list-style: none;
  }
  .person__summary::-webkit-details-marker {
    display: none;
  }
  .person__summary:focus-visible {
    outline: 2px solid var(--cyan-ink);
    outline-offset: 2px;
  }
  .person__avatar {
    flex: none;
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    overflow: hidden;
    border-radius: 50%;
    background: var(--cyan-tint);
    color: var(--cyan-ink);
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 600;
  }
  .person__avatar :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .person__id {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .person__name {
    font-size: 18px;
    font-weight: 600;
    line-height: 24px;
  }
  .person__role {
    color: var(--ink-2);
    font-size: 16px;
    line-height: 22px;
  }
  .person :global(.person__chev) {
    flex: none;
    color: var(--ink-3);
    transition: transform 0.2s;
  }
  .person[open] :global(.person__chev) {
    transform: rotate(180deg);
  }
  .person__pop {
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    left: 0;
    padding: 18px 20px;
    border: 1px solid var(--line);
    border-radius: var(--radius-card);
    background: var(--bg);
    box-shadow: 0 12px 32px rgb(0 0 0 / 0.14);
  }
  .person__bio {
    color: var(--ink);
    font-size: 16px;
    line-height: 24px;
  }
  .person__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 14px;
  }
  .person__close {
    min-height: 44px;
    padding: 0 8px;
    border: 0;
    background: none;
    color: var(--ink-2);
    font-family: var(--font-body);
    font-size: 16px;
    cursor: pointer;
  }
  .person__close:hover {
    color: var(--ink);
    text-decoration: underline;
  }
  .person__foot :global(.link-arrow) {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
  }
  @media (prefers-reduced-motion: reduce) {
    .person :global(.person__chev) {
      transition: none;
    }
  }
</style>
