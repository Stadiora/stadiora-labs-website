---
import { site } from '../../data/site';
import { hrefFor } from '../../data/nav';
import type { Locale } from '../../i18n';
import { coachCommon } from '../../i18n/pages/coach-common';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const c = coachCommon[locale].cta;
const demoHref = `${hrefFor('contact', locale)}?topic=demo`;
---

<section class="band cta" aria-labelledby="cta-title">
  <div class="container cta__row">
    <h2 id="cta-title" class="cta__title h-lane">{c.title}</h2>
    <div class="cta__actions">
      <a class="btn btn--lg btn--white" href={site.signUp}>{c.coach}</a>
      <a class="btn btn--lg btn--on-band" href={demoHref}>{c.demo}</a>
    </div>
  </div>
</section>

<style>
  .cta {
    padding-block: 72px 64px;
    background: var(--band);
    color: var(--band-ink);
  }
  .cta__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 32px 48px;
  }
  .cta__title {
    flex: 1 1 380px;
    color: var(--band-ink);
    font-size: clamp(34px, 4vw, 56px);
    line-height: 1.08;
    letter-spacing: -0.02em;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  @media (max-width: 720px) {
    .cta {
      padding-block: 56px 48px;
    }
    .cta__actions {
      width: 100%;
      flex-direction: column;
    }
    .cta__actions .btn {
      width: 100%;
    }
  }
</style>
