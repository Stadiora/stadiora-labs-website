---
import '../../styles/coach.css';
import '../../styles/coach/cf.css';
import CoachIcon from './CoachIcon.astro';

interface Item {
  title: string;
  body: string;
  icon?: string;
  /** Violet sparkle for AI rows. */
  ai?: boolean;
}
interface Props {
  /** Unique id prefix. */
  id: string;
  items: Item[];
  /** Index that is open first. */
  open?: number;
  /** Accessible name for the group of rows. */
  label: string;
  /** Clip in public/home/media shown behind the screens (WebM + MP4 + WebP poster). */
  backdrop?: string;
  /** Wider stage column. */
  wide?: boolean;
}
const { id, items, open = 0, label, backdrop, wide = false } = Astro.props;

// Each screen is rendered twice: once in the stage beside the rows (wide screens) and once inside
// the open row (narrow screens). Screens are illustrations: no ids, nothing focusable.
const screens = await Promise.all(items.map((_, i) => Astro.slots.render(`screen-${i}`)));
---

<div class:list={['acc', { 'acc--wide': wide }]} data-accordion role="group" aria-label={label}>
  <div class="acc__list">
    {
      items.map((item, i) => (
        <div class="acc__item" data-open={i === open ? '' : undefined}>
          <h3 class="acc__h">
            <button
              type="button"
              class="acc__btn"
              id={`${id}-h-${i}`}
              aria-expanded={i === open ? 'true' : 'false'}
              aria-controls={`${id}-p-${i}`}
            >
              {item.icon && (
                <span class="acc__icon" aria-hidden="true">
                  <CoachIcon name={item.icon as any} size={22} />
                </span>
              )}
              <span class="acc__title">{item.title}</span>
              {item.ai && (
                <span class="acc__ai" aria-hidden="true">
                  <CoachIcon name="sparkle" size={18} />
                </span>
              )}
              <span class="acc__pm" aria-hidden="true" />
            </button>
          </h3>
          <div class="acc__panel" id={`${id}-p-${i}`} role="region" aria-labelledby={`${id}-h-${i}`}>
            <div class="acc__panel-in">
              <p class="acc__body">{item.body}</p>
              <div class="acc__inline" aria-hidden="true" set:html={screens[i]} />
            </div>
          </div>
        </div>
      ))
    }
  </div>
  <div class="acc__stage media-frame" aria-hidden="true">
    {
      backdrop && (
        <>
          <video muted playsinline loop preload="none" data-clip data-poster={`/home/media/${backdrop}.webp`} tabindex="-1">
            <source src={`/home/media/${backdrop}.webm`} type="video/webm" />
            <source src={`/home/media/${backdrop}.mp4`} type="video/mp4" />
          </video>
          <div class="vid-shade"></div>
        </>
      )
    }
    <div class="acc__plate xf reading">
      {screens.map((html, i) => <div class="acc__screen" data-active={i === open ? '' : undefined} set:html={html} />)}
    </div>
    <slot name="overlay" />
  </div>
</div>

<style>
  .acc {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(28px, 4.5vw, 72px);
    align-items: center;
  }
  .acc--wide {
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
  }
  .acc__list {
    display: grid;
    gap: 10px;
  }
  .acc__item {
    position: relative;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    transition:
      background-color 0.3s,
      border-color 0.3s,
      box-shadow 0.3s;
  }
  .acc__item::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 4px;
    background: var(--ac);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.35s var(--e-out);
  }
  .acc__item[data-open] {
    border-color: color-mix(in srgb, var(--ac) 55%, var(--line));
    background: var(--surface);
    box-shadow: 0 24px 50px -30px color-mix(in srgb, var(--ac) 80%, transparent);
  }
  .acc__item[data-open]::before {
    transform: none;
  }
  .acc__h {
    margin: 0;
    font-size: inherit;
    line-height: inherit;
  }
  .acc__btn {
    display: flex;
    align-items: center;
    gap: 14px;
    width: 100%;
    min-height: 68px;
    padding: 14px 20px 14px 24px;
    border: 0;
    border-radius: 0;
    background: none;
    color: var(--ink);
    font-family: var(--f-display);
    font-size: clamp(18px, 1.5vw, 21px);
    font-weight: 700;
    line-height: 1.2;
    text-align: left;
    cursor: pointer;
  }
  .acc__btn:hover .acc__title {
    color: var(--ac-ink);
  }
  .acc__btn:focus-visible {
    outline-offset: -3px;
    border-radius: var(--r-md);
  }
  .acc__icon {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    background: color-mix(in srgb, var(--ac) 16%, transparent);
    color: var(--ac-ink);
  }
  .acc__title {
    flex: 1;
    min-width: 0;
    transition: color 0.2s;
  }
  .acc__ai {
    display: grid;
    flex: none;
    color: var(--violet-ink);
  }
  .acc__pm {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
    color: var(--ink-2);
  }
  .acc__pm::before,
  .acc__pm::after {
    content: '';
    position: absolute;
    left: 1px;
    right: 1px;
    top: 8px;
    height: 2px;
    border-radius: 1px;
    background: currentColor;
    transition:
      transform 0.25s var(--e-out),
      opacity 0.25s;
  }
  .acc__pm::after {
    transform: rotate(90deg);
  }
  .acc__item[data-open] .acc__pm::after {
    transform: rotate(0);
    opacity: 0;
  }

  .acc__panel {
    display: grid;
    grid-template-rows: 0fr;
    visibility: hidden;
    transition:
      grid-template-rows 0.3s var(--e-out),
      visibility 0s linear 0.3s;
  }
  .acc__item[data-open] .acc__panel {
    grid-template-rows: 1fr;
    visibility: visible;
    transition-delay: 0s;
  }
  .acc__panel-in {
    min-height: 0;
    overflow: hidden;
  }
  .acc__body {
    padding: 0 24px 22px 78px;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 26px;
  }
  .acc__inline {
    display: none;
  }

  /* Without JavaScript every row stays open and the first screen is shown. */
  :global(html:not(.js)) .acc__panel {
    grid-template-rows: 1fr;
    visibility: visible;
  }

  /* The stage is a dark media frame; the screens float over the clip and follow the page theme. */
  .acc__stage {
    min-width: 0;
    padding: clamp(24px, 3.4vw, 52px);
    border-radius: var(--r-xl);
    background: #040a1a;
    box-shadow: 0 50px 110px -50px color-mix(in srgb, var(--ac) 70%, transparent);
  }
  .acc__stage > video {
    opacity: 0.85;
  }
  .acc__plate {
    position: relative;
    z-index: 2;
    align-items: center;
    justify-items: center;
    background: none;
  }
  .acc__screen {
    width: 100%;
    min-width: 0;
    display: grid;
    justify-items: center;
  }
  .acc__screen[data-active] {
    animation: accIn 0.7s var(--e-out) both;
  }
  @keyframes accIn {
    from {
      transform: translateY(26px) scale(0.96);
      filter: blur(6px);
    }
    to {
      transform: none;
      filter: none;
    }
  }

  @media (max-width: 960px) {
    .acc,
    .acc--wide {
      grid-template-columns: minmax(0, 1fr);
    }
    .acc__stage {
      display: none;
    }
    .acc__inline {
      display: grid;
      justify-items: center;
      padding: 4px 16px 24px;
    }
    .acc__body {
      padding-inline: 20px;
    }
    .acc__btn {
      padding-inline: 20px 16px;
    }
  }
</style>

<script>
  import '../../scripts/accordion';
</script>
