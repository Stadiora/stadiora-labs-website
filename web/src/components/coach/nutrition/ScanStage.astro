---
import Photo from '../../ui/Photo.astro';
import CoachIcon from '../CoachIcon.astro';
import type { Locale } from '../../../i18n';
import type { NutritionCopy } from '../../../i18n/pages/nutrition';

interface Props {
  locale: Locale;
  meal: NutritionCopy['hero']['meal'];
  snap: string;
}
const { locale, meal, snap } = Astro.props;
const split = (v: string) => ({ n: Number.parseFloat(v), unit: v.replace(/[\d.,\s]+/, '') });
const macros = meal.macros.map((m) => ({ ...m, ...split(m.value) }));
---

<!-- Decorative: a phone aims at a plate, a scan line sweeps it, and the estimate counts up. The same numbers are
     plain text in the hero card and the list beside this stage. -->
<div class="ns" data-cf-stage="scan" aria-hidden="true">
  <div class="ns__phone" data-depth="10">
    <div class="ns__screen">
      <Photo slot="f2-nutrition" alt="" ratio="3/4" sizes="260px" widths={[320, 480]} locale={locale} class="ns__photo" />
      <i class="ns__brk ns__brk--a"></i><i class="ns__brk ns__brk--b"></i><i class="ns__brk ns__brk--c"></i><i class="ns__brk ns__brk--d"></i>
      <i class="ns__line"></i>
      <span class="ns__snap"><CoachIcon name="camera" size={16} />{snap}</span>
    </div>
  </div>
  <div class="ns__read cf-panel reading rv" style="--i:2">
    <div class="ns__head">
      <span class="ns__label">{meal.label}</span>
      <span class="ns__est">{meal.badge}</span>
    </div>
    <p class="ns__kcal"><span class="count" style={`--to:${meal.kcal};--cd:1.6s`}></span> <span class="ns__unit">{meal.unit}</span></p>
    <ul class="ns__macros">
      {
        macros.map((m, i) => (
          <li style={`--pc:${m.pct / 100};--k:${i}`}>
            <span class="ns__name">{m.name}</span>
            <span class="ns__bar"><i></i></span>
            <span class="ns__val">
              <span class="count" style={`--to:${m.n};--cd:${1.2 + i * 0.2}s`} />
              {m.unit && <span> {m.unit}</span>}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .ns {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(16px, 3vw, 40px);
  }
  .ns__phone {
    width: clamp(190px, 22vw, 250px);
    padding: 9px;
    border-radius: 38px;
    background: #0b1224;
    box-shadow:
      0 40px 90px -30px color-mix(in srgb, var(--ac) 55%, #000),
      inset 0 0 0 1.5px rgb(255 255 255 / 0.14);
    translate: 0 var(--py, 0px);
  }
  .ns__screen {
    position: relative;
    overflow: hidden;
    aspect-ratio: 9 / 17;
    border-radius: 30px;
    background: #000;
  }
  .ns__screen :global(.ns__photo) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto !important;
    object-fit: cover;
    object-position: 50% 40%;
    animation: nsPan 8s ease-in-out infinite alternate;
  }
  .ns__screen :global(picture) {
    display: contents;
  }
  .ns__brk {
    position: absolute;
    width: 26px;
    height: 26px;
    border: 3px solid #fff;
    opacity: 0.9;
  }
  .ns__brk--a {
    left: 14%;
    top: 22%;
    border-right: 0;
    border-bottom: 0;
    border-radius: 8px 0 0 0;
  }
  .ns__brk--b {
    right: 14%;
    top: 22%;
    border-left: 0;
    border-bottom: 0;
    border-radius: 0 8px 0 0;
  }
  .ns__brk--c {
    left: 14%;
    bottom: 26%;
    border-right: 0;
    border-top: 0;
    border-radius: 0 0 0 8px;
  }
  .ns__brk--d {
    right: 14%;
    bottom: 26%;
    border-left: 0;
    border-top: 0;
    border-radius: 0 0 8px 0;
  }
  .ns__line {
    position: absolute;
    left: 12%;
    right: 12%;
    top: 22%;
    height: 3px;
    border-radius: 3px;
    background: var(--ac);
    box-shadow:
      0 0 18px 4px color-mix(in srgb, var(--ac) 70%, transparent),
      0 0 60px 14px color-mix(in srgb, var(--ac) 30%, transparent);
    animation: nsScan 4s ease-in-out infinite;
  }
  .ns__snap {
    position: absolute;
    left: 50%;
    bottom: 5%;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border-radius: 999px;
    background: #fff;
    color: #08132b;
    font: 700 13px/1 var(--f-text);
    translate: -50% 0;
    white-space: nowrap;
  }
  .ns__read {
    padding: clamp(16px, 2vw, 24px);
  }
  .ns__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
  }
  .ns__label {
    font: 600 15px/1.2 var(--f-text);
    color: var(--ink);
  }
  .ns__est {
    padding: 3px 10px;
    border-radius: 999px;
    background: color-mix(in srgb, var(--ac) 22%, transparent);
    color: var(--ink);
    font: 600 12px/18px var(--f-text);
  }
  .ns__kcal {
    margin: 6px 0 14px;
    font: 900 clamp(44px, 5vw, 68px) / 1 var(--f-display);
    font-variation-settings: 'wdth' 70;
    font-stretch: 70%;
    letter-spacing: -0.01em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .ns__unit {
    font-size: 0.34em;
    color: var(--ink-2);
    letter-spacing: 0.02em;
  }
  .ns__macros {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ns__macros li {
    display: grid;
    grid-template-columns: minmax(70px, 1fr) 1.4fr auto;
    align-items: center;
    gap: 10px;
    font-size: 14px;
    color: var(--ink-2);
  }
  .ns__val {
    min-width: 52px;
    text-align: right;
    color: var(--ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .ns__bar {
    height: 8px;
    overflow: hidden;
    border-radius: 8px;
    background: color-mix(in srgb, var(--ink) 12%, transparent);
  }
  .ns__bar i {
    display: block;
    height: 100%;
    border-radius: 8px;
    background: linear-gradient(90deg, var(--ac), color-mix(in srgb, var(--ac) 55%, #fff));
    transform-origin: left;
    transform: scaleX(var(--pc));
  }
  :global(html.js) .ns__read.rv .ns__bar i {
    transform: scaleX(0);
    transition: transform 1.3s var(--e-out) calc(0.4s + var(--k) * 0.15s);
  }
  :global(html.js) .ns__read.rv.in .ns__bar i {
    transform: scaleX(var(--pc));
  }
  @keyframes nsScan {
    0%,
    100% {
      top: 22%;
      opacity: 0.2;
    }
    12% {
      opacity: 1;
    }
    50% {
      top: 72%;
      opacity: 1;
    }
    62% {
      opacity: 0.2;
    }
  }
  @keyframes nsPan {
    from {
      scale: 1;
    }
    to {
      scale: 1.1;
    }
  }
  @media (max-width: 720px) {
    .ns {
      grid-template-columns: minmax(0, 1fr);
      justify-items: center;
    }
    .ns__read {
      width: 100%;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .ns__read.rv .ns__bar i {
      transform: scaleX(var(--pc));
    }
    .ns__line,
    .ns__screen :global(.ns__photo) {
      animation: none;
    }
  }
</style>
