---
import Icon from '../ui/Icon.astro';

// Extra line icons for the Coach pages. Names the foundation Icon already has fall through to it.
const own = {
  shoe: '<path d="M3 17v-6l3.5.5L9 8l3 2.5c1.5 1.2 3.4 1.8 5.3 1.8 2 0 3.7 1.5 3.7 3.5V17z"/><path d="M3 20h18"/>',
  'clipboard-check': '<rect x="5" y="4.5" width="14" height="16.5" rx="2"/><path d="M9 4.5h6V7H9z"/><path d="M8.5 13.5l2.5 2.5 4.5-5"/>',
  bars: '<path d="M5 20v-8M12 20V5M19 20v-5"/>',
  target: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/><path d="M12 12h.01"/>',
  lotus:
    '<path d="M12 18.5c-3.5-1.5-5-4.5-5-8 3 .3 4.7 2 5 3.5.3-1.5 2-3.2 5-3.5 0 3.5-1.5 6.5-5 8z"/><path d="M12 13.5c-1.5-2-1.5-5.5 0-8 1.5 2.5 1.5 6 0 8zM4 14c1.5 3 4.5 4.5 8 4.5s6.5-1.5 8-4.5"/>',
  info: '<circle cx="12" cy="12" r="8.5"/><path d="M12 11v5M12 7.8v.2"/>',
  barcode: '<path d="M4 6v12M7 6v12M10 6v12M14 6v12M17 6v12M20 6v12"/>',
  camera: '<path d="M4 8.5h3L8.5 6h7L17 8.5h3v10H4z"/><circle cx="12" cy="13" r="3.2"/>',
  search: '<circle cx="11" cy="11" r="6.5"/><path d="M16 16l4.5 4.5"/>',
  list: '<path d="M9 6.5h11M9 12h11M9 17.5h11M4.5 6.5h.01M4.5 12h.01M4.5 17.5h.01"/>',
  home: '<path d="M4 11 12 4l8 7v9h-5v-6H9v6H4z"/>',
  users:
    '<circle cx="9" cy="8.5" r="3.2"/><path d="M3 19.5c.5-3.2 3-5 6-5s5.5 1.8 6 5M16 5.5a3.2 3.2 0 0 1 0 6M18 14.8c1.8.6 3 2.2 3.4 4.7"/>',
  file: '<path d="M6.5 3.5h7l4 4v13h-11z"/><path d="M13.5 3.5v4h4"/>',
  upload: '<path d="M12 16V5M7.5 9.5 12 5l4.5 4.5M5 19.5h14"/>',
  calendar: '<rect x="4" y="5.5" width="16" height="14.5" rx="2"/><path d="M4 10h16M8.5 3.5v4M15.5 3.5v4"/>',
  plate: '<circle cx="12" cy="12" r="8.5"/><circle cx="12" cy="12" r="4.5"/>',
} as const;

type OwnName = keyof typeof own;
type SharedName = Parameters<typeof Icon>[0]['name'];

interface Props {
  name: OwnName | SharedName;
  size?: number;
  class?: string;
}
const { name, size = 20, class: cls } = Astro.props;
const mine = name in own;
---

{
  mine ? (
    <svg
      viewBox="0 0 24 24"
      width={size}
      height={size}
      fill="none"
      stroke="currentColor"
      stroke-width="1.75"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
      focusable="false"
      class={cls}
      set:html={own[name as OwnName]}
    />
  ) : (
    <Icon name={name as SharedName} size={size} class={cls} />
  )
}
