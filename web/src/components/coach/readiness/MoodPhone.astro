---
import Phone from '../../ui/Phone.astro';
import PhoneHead from './PhoneHead.astro';
import type { ReadinessCopy } from '../../../i18n/pages/readiness';

interface Props {
  copy: ReadinessCopy['calm']['cards'][number]['screen'];
}
const { copy } = Astro.props;
const faces = copy.faces ?? [];
const picked = copy.picked ?? 0;
// Mouth curvature per face, from very low to great.
const mouths = ['M8 16.2c1-1.6 2.4-2.4 4-2.4s3 .8 4 2.4', 'M8.5 15.6c.9-.9 2-1.3 3.5-1.3s2.6.4 3.5 1.3', 'M9 15h6', 'M8.5 14.4c.9.9 2 1.3 3.5 1.3s2.6-.4 3.5-1.3', 'M8 13.6c1 1.6 2.4 2.4 4 2.4s3-.8 4-2.4'];
---

<Phone>
  <div class="op">
    <PhoneHead title={copy.title} />
    <p class="op__prompt">{copy.prompt}</p>
    <ul class="op__faces">
      {
        faces.map((_, i) => (
          <li class:list={['op__face', { 'is-on': i === picked }]}>
            <svg viewBox="0 0 24 24" width="100%" height="100%" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M9 9.6v.3M15 9.6v.3" />
              <path d={mouths[i]} />
            </svg>
          </li>
        ))
      }
    </ul>
    <p class="op__picked">{faces[picked]}</p>
  </div>
</Phone>

<style>
  .op {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: 0.2em 1em 1.2em;
    font-size: 0.95em;
  }
  .op__prompt {
    margin: 0.6em 0 1.4em;
    color: var(--ink);
    font-family: var(--font-display);
    font-size: 1.35em;
    font-weight: 600;
    line-height: 1.25;
  }
  .op__faces {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0.4em;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .op__face {
    aspect-ratio: 1;
    color: var(--ink-3);
  }
  .op__face.is-on {
    border-radius: 50%;
    background: var(--cyan-tint);
    color: var(--cyan-ink);
    box-shadow: 0 0 0 0.2em var(--cyan-tint);
  }
  .op__picked {
    margin-top: 1.2em;
    color: var(--ink);
    font-weight: 600;
    text-align: center;
  }
</style>
