---
import CoachIcon from '../CoachIcon.astro';

interface Props {
  title: string;
  /** Show the back chevron used on detail screens. */
  back?: boolean;
}
const { title, back = true } = Astro.props;
---

<!-- Screen title bar inside a phone. Em-sized, so it scales with --phone-w. -->
<div class="ph">
  <span class="ph__side">{back && <CoachIcon name="chevron-left" size={14} />}</span>
  <span class="ph__title">{title}</span>
  <span class="ph__side"></span>
</div>

<style>
  .ph {
    display: grid;
    grid-template-columns: 2em 1fr 2em;
    align-items: center;
    padding: 0.3em 0.9em 0.5em;
    color: var(--ink-3);
  }
  .ph__side {
    display: inline-flex;
  }
  .ph__title {
    color: var(--ink);
    font-size: 1.05em;
    font-weight: 600;
    text-align: center;
  }
</style>
