---
import '../../styles/coach/cf.css';
import { hrefFor } from '../../data/nav';
import type { ItemId } from '../../data/site';
import { useDict, type Locale } from '../../i18n';
import { coachCommon } from '../../i18n/pages/coach-common';
import Icon from '../ui/Icon.astro';

interface Props {
  locale: Locale;
  ids: readonly ItemId[];
}
const { locale, ids } = Astro.props;
const t = useDict(locale);
const common = coachCommon[locale];
const items = t.nav.items as Record<string, { name: string; desc: string }>;
---

<section class="cf-sec cf-sec--tight" aria-labelledby="aia-title">
  <div class="wrap">
    <h2 id="aia-title" class="t-title rv">{common.also}</h2>
    <ul class="cf-also__list">
      {
        ids.map((id, i) => (
          <li class="rv" style={`--i:${i}`}>
            <a class="cf-also__card" href={hrefFor(id, locale)}>
              <span>
                <span class="cf-also__name">{items[id].name}</span>
                <span class="cf-also__desc">{items[id].desc}</span>
              </span>
              <Icon name="arrow-right" size={22} />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>
