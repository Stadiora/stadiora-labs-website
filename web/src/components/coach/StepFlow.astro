---
import '../../styles/coach.css';

interface Step {
  title: string;
  line: string;
}
interface Props {
  steps: Step[];
  /** "Step" / "Paso", read before each title by screen readers. */
  stepWord: string;
  /** open: numbered heads joined by a dotted line; card: each step in its own bordered card. */
  variant?: 'open' | 'card';
  label?: string;
}
const { steps, stepWord, variant = 'open', label } = Astro.props;
---

<ol class:list={['sf', `sf--${variant}`]} data-reveal aria-label={label}>
  {
    steps.map((step, i) => (
      <li class="sf__step" style={`--i:${i}`}>
        <div class="sf__head">
          <span class="sf__num num" aria-hidden="true">
            {i + 1}
          </span>
          <h3 class="sf__title">
            <span class="sr-only">{stepWord} {i + 1}: </span>
            {step.title}
          </h3>
          {variant === 'open' && i < steps.length - 1 && <span class="sf__dots" aria-hidden="true" />}
        </div>
        <div class="sf__screen">
          <slot name={`step-${i}`} />
        </div>
        <p class="sf__line">{step.line}</p>
      </li>
    ))
  }
</ol>

<style>
  .sf {
    display: grid;
    grid-template-columns: repeat(var(--sf-cols, 3), minmax(0, 1fr));
    grid-template-rows: auto 1fr auto;
    column-gap: clamp(20px, 3vw, 40px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .sf__step {
    display: grid;
    grid-template-rows: subgrid;
    grid-row: span 3;
    min-width: 0;
  }
  .sf__head {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 44px;
  }
  .sf__num {
    display: grid;
    flex: none;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid color-mix(in srgb, var(--ac, var(--cyan)) 70%, transparent);
    border-radius: 50%;
    background: color-mix(in srgb, var(--ac, var(--cyan)) 24%, transparent);
    color: var(--ink);
    font-size: 18px;
    font-weight: 700;
    box-shadow: 0 0 24px -4px color-mix(in srgb, var(--ac, var(--cyan)) 70%, transparent);
  }
  .sf__title {
    font: 700 22px/28px var(--f-display, var(--font-display));
    color: var(--ink);
  }
  .sf__screen {
    display: grid;
    flex: 1;
    align-items: start;
    margin-top: 20px;
  }
  .sf__line {
    margin-top: 16px;
    color: var(--ink-2);
    font-size: 17px;
    line-height: 26px;
  }

  /* Connector: drawn left to right once when the list scrolls in, then a light keeps travelling along it. */
  .sf__dots {
    position: relative;
    flex: 1 1 24px;
    min-width: 24px;
    height: 2px;
    margin: 0 -32px 0 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--ac, var(--cyan)), color-mix(in srgb, var(--ac, var(--cyan)) 10%, transparent));
  }
  .sf__dots::after {
    content: '';
    position: absolute;
    left: 0;
    top: -3px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    box-shadow: 0 0 14px 2px var(--ac, var(--cyan));
    animation: sfRun 3.6s var(--e-inout, ease-in-out) infinite;
    animation-delay: calc(var(--i, 0) * 0.9s + 1.4s);
    opacity: 0;
  }
  @keyframes sfRun {
    0% {
      left: 0;
      opacity: 0;
    }
    12% {
      opacity: 1;
    }
    70% {
      left: calc(100% - 8px);
      opacity: 1;
    }
    80%,
    100% {
      left: calc(100% - 8px);
      opacity: 0;
    }
  }
  :global(html.js) .sf[data-reveal] .sf__dots {
    clip-path: inset(-8px 100% -8px 0);
    transition: clip-path 0.7s var(--e-out, ease-out) calc(var(--i, 0) * 220ms + 300ms);
  }
  :global(html.js) .sf[data-reveal] .sf__step {
    opacity: 0;
    translate: 0 18px;
    transition:
      opacity 0.6s var(--e-out, ease-out) calc(var(--i, 0) * 160ms),
      translate 0.6s var(--e-out, ease-out) calc(var(--i, 0) * 160ms);
  }
  :global(html.js) .sf[data-reveal].is-in .sf__dots {
    clip-path: inset(-8px 0);
  }
  :global(html.js) .sf[data-reveal].is-in .sf__step {
    opacity: 1;
    translate: 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .sf[data-reveal] .sf__dots {
      clip-path: inset(-8px 0);
    }
    :global(html.js) .sf[data-reveal] .sf__step {
      opacity: 1;
      translate: 0 0;
    }
    .sf__dots::after {
      display: none;
    }
  }

  /* Card variant */
  .sf--card {
    column-gap: 16px;
  }
  .sf--card .sf__step {
    padding: 20px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg, var(--radius-card));
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(8px);
  }
  .sf--card .sf__num {
    width: 36px;
    height: 36px;
    font-size: 16px;
  }
  .sf--card .sf__title {
    font-size: 18px;
    line-height: 24px;
  }
  .sf--card .sf__line {
    margin-top: 14px;
    font-size: 15px;
    line-height: 22px;
  }
  .sf--card .sf__screen {
    align-items: center;
  }

  @media (max-width: 960px) {
    .sf {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      row-gap: 40px;
    }
    .sf__step {
      grid-template-rows: auto auto auto;
      grid-row: auto;
    }
    .sf__dots {
      display: none;
    }
    .sf--card {
      row-gap: 16px;
    }
  }
</style>
