---
// The closing section of every page in this lane: the night-stadium clip, orbits with two travelling dots, the title
// on two lines (the second one in the brand gradient) and the actions. The words are HTML, never baked into the clip.
interface Action {
  label: string;
  href: string;
  /** Opens the "get the app" chooser. */
  sheet?: boolean;
}
interface Props {
  title: string;
  lead?: string;
  actions: Action[];
}
const { title, lead, actions } = Astro.props;

// Splits the title at the space nearest its middle so both lines carry about the same weight.
const words = title.split(' ');
let cut = Math.ceil(words.length / 2);
if (words.length > 3) {
  let best = Infinity;
  for (let i = 1; i < words.length; i++) {
    const left = words.slice(0, i).join(' ').length;
    const diff = Math.abs(left - (title.length - left));
    if (diff < best) {
      best = diff;
      cut = i;
    }
  }
}
const lines = [words.slice(0, cut).join(' '), words.slice(cut).join(' ')].filter(Boolean);
---

<section class="final sx-final impact media-frame" data-section aria-labelledby="sx-final-h">
  <video muted playsinline loop preload="none" data-clip data-poster="/home/media/night-stadium.webp" aria-hidden="true">
    <source src="/home/media/night-stadium.webm" type="video/webm" />
    <source src="/home/media/night-stadium.mp4" type="video/mp4" />
  </video>
  <div class="orbits" aria-hidden="true">
    <svg viewBox="0 0 1600 800">
      <ellipse cx="800" cy="400" rx="760" ry="260"></ellipse>
      <ellipse class="dash" cx="800" cy="400" rx="600" ry="200"></ellipse>
      <circle class="fdot fdot--a" r="9" fill="#00BEF3"></circle>
      <circle class="fdot fdot--b" r="7" fill="#8B5CF6"></circle>
    </svg>
  </div>
  <div class="wrap">
    <h2 class="d d1 lines" id="sx-final-h">
      {lines.map((l, i) => <span><span class:list={{ 'grad-text': i === 1 }} style={`--i:${i}`}>{l}</span></span>)}
    </h2>
    {lead && <p class="lead rv">{lead}</p>}
    <div class="final-ctas rv" style="--i:2">
      {
        actions.map((a, i) => (
          <a class:list={['btn', i === 0 ? 'btn--white' : 'btn--ghost', 'btn--lg']} href={a.href} data-open-sheet={a.sheet ? '' : undefined}>
            {a.label}
          </a>
        ))
      }
    </div>
  </div>
</section>
