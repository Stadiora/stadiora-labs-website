---
// The consent strip on a dark stage: three plain promises, one card each. The wording is the approved copy in schools.ts.
import type { SchoolsCopy } from '../../i18n/pages/schools';

interface Props {
  copy: SchoolsCopy;
}
const { copy } = Astro.props;
const paths = [
  'M7 3.5h7l4 4v13H7zM14 3.5v4h4M9.5 12h6M9.5 15.5h6',
  'M12 3.5l7 2.8v5.4c0 4.2-2.8 7.4-7 8.8-4.2-1.4-7-4.6-7-8.8V6.3zM9 12l2.2 2.2L15.5 10',
  'M12 3.5l7 2.8v5.4c0 4.2-2.8 7.4-7 8.8-4.2-1.4-7-4.6-7-8.8V6.3zM9.2 9.2l5.6 5.6M14.8 9.2l-5.6 5.6',
];
---

<section class="sx-stage impact consent" data-section aria-labelledby="consent-h">
  <div class="mesh" aria-hidden="true">
    <i class="b b5"></i><i class="b b1"></i><i class="b b2"></i><i class="b b3"></i><i class="b b4"></i><i class="vig"></i>
  </div>
  <div class="orbits" aria-hidden="true">
    <svg viewBox="0 0 1600 800"><ellipse cx="800" cy="400" rx="760" ry="250"></ellipse><ellipse class="dash" cx="800" cy="400" rx="560" ry="170"></ellipse></svg>
  </div>
  <div class="wrap">
    <h2 class="d d2 lines" id="consent-h"><span><span>{copy.consent.title}</span></span></h2>
    <ul class="consent__list">
      {
        copy.consent.lines.map((line, i) => (
          <li class="consent__item pcard rv" style={`--i:${i + 1}`}>
            <span class="consent__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" width="30" height="30" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round">
                <path d={paths[i]} />
              </svg>
            </span>
            <span class="consent__text">{line}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .consent__list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
    margin-top: clamp(32px, 4vw, 56px);
  }
  .consent__item {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    min-height: 220px;
    padding: 28px;
  }
  .consent__icon {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: rgba(0, 190, 243, 0.14);
    color: #5fd8ff;
    box-shadow: inset 0 0 0 1.5px rgba(0, 190, 243, 0.55);
  }
  .consent__text {
    margin-top: auto;
    color: #fff;
    font-family: var(--f-display);
    font-stretch: 88%;
    font-weight: 800;
    font-size: clamp(22px, 2.2vw, 30px);
    line-height: 1.1;
    letter-spacing: -0.01em;
  }
  @media (max-width: 900px) {
    .consent__list {
      grid-template-columns: minmax(0, 1fr);
    }
    .consent__item {
      flex-direction: row;
      align-items: center;
      min-height: 0;
    }
    .consent__text {
      margin-top: 0;
    }
  }
</style>
