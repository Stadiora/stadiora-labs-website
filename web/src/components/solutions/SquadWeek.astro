---
import type { ClubsCopy } from '../../i18n/pages/clubs';
import type { SolutionsFxCopy } from '../../i18n/pages/solutions-fx';
import SquadFeed from './SquadFeed.astro';

interface Props {
  copy: ClubsCopy;
  fx: SolutionsFxCopy['clubs'];
}
const { copy, fx } = Astro.props;
const w = copy.week;

// Mini line chart geometry (viewBox units). The y axis is fixed at 30 to 50 cm.
const box = { left: 30, right: 292, top: 8, bottom: 96 };
const x = (i: number, n: number) => box.left + 12 + ((box.right - box.left - 24) * i) / (n - 1);
const y = (v: number) => box.bottom - ((v - 30) / 20) * (box.bottom - box.top);
const points = (values: number[]) => values.map((v, i) => `${x(i, values.length).toFixed(1)},${y(v).toFixed(1)}`);
const label = (values: number[]) =>
  w.chartLabel.replace('{first}', String(values[0])).replace('{last}', String(values[values.length - 1]));
---

<section class="squad sx-stage impact" data-section aria-labelledby="squad-h">
  <div class="mesh" aria-hidden="true">
    <i class="b b5"></i><i class="b b1"></i><i class="b b2"></i><i class="b b3"></i><i class="b b4"></i><i class="vig"></i>
  </div>
  <div class="orbits" aria-hidden="true">
    <svg viewBox="0 0 1600 800"><ellipse cx="800" cy="400" rx="760" ry="250"></ellipse><ellipse class="dash" cx="800" cy="400" rx="560" ry="170"></ellipse></svg>
  </div>
  <div class="wrap">
    <div class="sq-head">
      <span class="eyebrow">{fx.stageLabel}</span>
      <h2 class="d d2 lines" id="squad-h"><span><span>{fx.stageTitle}</span></span></h2>
      <p class="lead rv">{fx.stageLead}</p>
    </div>
    <div class="sq-grid">
  <div class="sq-main rv" data-tabs>
    <div class="tabs squad__tabs" role="tablist" aria-label={w.tabsLabel}>
      {
        copy.squads.map((s) => (
          <button
            class="tab"
            type="button"
            role="tab"
            id={`squad-tab-${s.id}`}
            aria-controls={`squad-panel-${s.id}`}
            aria-selected={s.id === copy.defaultSquad ? 'true' : 'false'}
            tabindex={s.id === copy.defaultSquad ? 0 : -1}
            data-text={s.label}
          >
            {s.label}
          </button>
        ))
      }
      <span class="tabs__lane" aria-hidden="true"></span>
    </div>

    <div class="squad__card reading xf">
      {
        copy.squads.map((s) => {
          const on = s.id === copy.defaultSquad;
          const pts = points(s.cmj);
          return (
            <div class="squad__panel" role="tabpanel" id={`squad-panel-${s.id}`} aria-labelledby={`squad-tab-${s.id}`} data-active={on ? '' : undefined} inert={!on}>
              <div class="squad__top">
                <h3 class="squad__title">
                  {s.label} · {w.title}
                </h3>
                <p class="squad__range">{w.range}</p>
              </div>
              <div class="squad__tiles">
                <article class="tile">
                  <h4 class="tile__label">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <circle cx="12" cy="12" r="8.5" />
                      <path d="m12 8 3.6 2.6-1.4 4.2H9.8l-1.4-4.2zM12 3.5V8M15.6 10.6l4.2-1.4M14.2 14.8l2.6 3.6M9.8 14.8l-2.6 3.6M8.4 10.6 4.2 9.2" />
                    </svg>
                    {w.fixture}
                  </h4>
                  <p class="tile__big">
                    {s.fixture.day} · vs {s.fixture.opponent}
                  </p>
                  <p class="tile__sub">
                    {s.fixture.time} · {s.fixture.venue}
                  </p>
                </article>

                <article class="tile">
                  <h4 class="tile__label">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M12 4 7 19h10zM9.2 12h5.6M5 19h14" />
                    </svg>
                    {w.practices}
                  </h4>
                  <ul class="tile__rows">
                    {
                      s.practices.map((p) => (
                        <li class="tile__row">
                          <span>{p.day} · {w.practice}</span>
                          <span class="num">{p.time}</span>
                        </li>
                      ))
                    }
                  </ul>
                </article>

                <article class="tile">
                  <h4 class="tile__label">{w.availability}</h4>
                  <ul class="avail">
                    <li><span class="dot" aria-hidden="true"></span><span class="num">{s.available}</span> {w.states.available}</li>
                    <li><span class="dot dot--amber" aria-hidden="true"></span><span class="num">{s.doubtful}</span> {w.states.doubtful}</li>
                    <li><span class="dot dot--muted" aria-hidden="true"></span><span class="num">{s.unavailable}</span> {w.states.unavailable}</li>
                  </ul>
                </article>

                <article class="tile">
                  <h4 class="tile__label">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M4 10v4h3l6 4V6L7 10zM16.5 9a4 4 0 0 1 0 6M7 14l1 5h2.5l-1-4.2" />
                    </svg>
                    {w.announcement}
                  </h4>
                  <p class="tile__big">{s.note}</p>
                  <p class="tile__sub"><span class="num">{s.read}</span> {w.of} <span class="num">{s.total}</span> {w.read}</p>
                </article>

                <article class="tile tile--chart">
                  <h4 class="tile__label">
                    <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M5 19v-6M12 19V5M19 19v-10" />
                    </svg>
                    <span>{w.powerLab}<span class="tile__metric">{w.metric}</span><span class="tile__note">{w.metricNote}</span></span>
                  </h4>
                  <svg class="chart" viewBox="0 0 300 126" role="img" aria-label={label(s.cmj)}>
                    {[30, 40, 50].map((tick) => (
                      <g>
                        <line x1={box.left} x2={box.right} y1={y(tick)} y2={y(tick)} class="chart__grid" />
                        <text x={box.left - 6} y={y(tick) + 4} text-anchor="end" class="chart__tick">{tick}</text>
                      </g>
                    ))}
                    <polyline points={pts.join(' ')} class="chart__line" fill="none" />
                    {pts.map((p) => {
                      const [cx, cy] = p.split(',');
                      return <circle cx={cx} cy={cy} r="3.5" class="chart__dot" />;
                    })}
                    {w.dates.map((d, i) => (
                      <text x={x(i, w.dates.length)} y="118" text-anchor="middle" class="chart__tick">{d}</text>
                    ))}
                  </svg>
                </article>
              </div>
              <p class="demo-note">{copy.demoNote}</p>
            </div>
          );
        })
      }
    </div>
  </div>
  <SquadFeed {copy} {fx} />
    </div>
  </div>
</section>

<style>
  .sq-head {
    display: grid;
    gap: 22px;
    max-width: 860px;
    margin-bottom: clamp(36px, 5vw, 64px);
  }
  .sq-head h2 {
    font-size: var(--fs-d2);
    margin: 0;
  }
  .sq-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(32px, 4vw, 64px);
    align-items: center;
  }
  .sq-main {
    min-width: 0;
  }
  .squad__tabs {
    margin-bottom: 20px;
  }
  .squad__card {
    padding: 28px;
    border: 1px solid var(--line);
    border-radius: 24px;
    background: var(--bg);
    box-shadow: 0 30px 80px -40px rgba(0, 0, 0, 0.7);
  }
  .sq-grid :global(.sq-phone) {
    width: 380px;
    height: 680px;
    display: grid;
    place-items: center;
    border-radius: 32px;
  }
  .squad__panel {
    min-width: 0;
  }
  .squad__top {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 24px;
  }
  .squad__title {
    font-size: 24px;
    line-height: 30px;
  }
  .squad__range {
    color: var(--ink-2);
    font-size: 15px;
  }
  .squad__tiles {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 14px;
    margin-top: 20px;
  }
  .tile {
    grid-column: span 2;
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
    min-height: 168px;
    padding: 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
  }
  .tile__label {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    line-height: 20px;
  }
  .tile__label svg {
    flex: none;
    color: var(--cyan-ink);
  }
  .tile__big {
    margin-top: auto;
    font-size: 19px;
    font-weight: 600;
    line-height: 25px;
  }
  .tile__sub {
    margin-bottom: auto;
    color: var(--ink-2);
    font-size: 16px;
    line-height: 22px;
  }
  .tile__rows {
    display: grid;
    margin-block: auto;
  }
  .tile__row {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    padding-block: 10px;
    font-size: 15px;
  }
  .tile__row .num {
    flex: none;
    white-space: nowrap;
  }
  .tile__row + .tile__row {
    border-top: 1px solid var(--line);
  }
  .avail {
    display: grid;
    gap: 12px;
    margin-block: auto;
    font-size: 16px;
  }
  .avail li {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .tile__metric,
  .tile__note {
    display: block;
    line-height: 20px;
  }
  .tile__metric {
    font-weight: 600;
  }
  .tile__note {
    color: var(--ink-2);
    font-size: 14px;
    font-weight: 400;
  }
  .tile--chart .tile__label {
    align-items: flex-start;
  }
  .chart {
    width: 100%;
    height: auto;
    margin-top: auto;
    overflow: visible;
  }
  .chart__grid {
    stroke: var(--line);
    stroke-width: 1;
  }
  .chart__tick {
    fill: var(--ink-2);
    font-size: 10px;
  }
  .chart__line {
    stroke: var(--cyan-ink);
    stroke-width: 2;
    stroke-linejoin: round;
  }
  .chart__dot {
    fill: var(--cyan-ink);
  }

  .tile--chart {
    grid-column: span 4;
  }
  @media (max-width: 1100px) {
    .sq-grid {
      grid-template-columns: minmax(0, 1fr);
      justify-items: stretch;
    }
    .sq-grid :global(.sq-phone) {
      justify-self: center;
      max-width: 100%;
    }
  }
  @media (max-width: 900px) {
    .squad__tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .tile {
      grid-column: auto;
    }
    .tile--chart {
      grid-column: span 2;
    }
  }
  @media (max-width: 720px) {
    .sq-grid :global(.sq-phone) {
      width: 100%;
      height: 640px;
    }
    .squad__card {
      padding: 16px;
    }
    .squad__tiles {
      grid-template-columns: minmax(0, 1fr);
    }
    .tile {
      min-height: 0;
    }
    .tile--chart {
      grid-column: auto;
    }
  }
</style>

<script>
  import '../../scripts/tabs';
</script>
