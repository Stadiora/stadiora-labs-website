---
import type { ApiCopy } from '../../i18n/pages/api';

interface Props {
  copy: ApiCopy;
}
const t = Astro.props.copy.caps;
const it = t.items;
const colors = ['#00BEF3', '#34D399', '#FF4D5E', '#8B5CF6', '#00BEF3', '#34D399'];
const num = (i: number) => String(i + 1).padStart(2, '0');
const wave = 'M0,60 L40,60 L52,60 L60,30 L70,88 L80,18 L90,70 L100,60 L150,60 L162,60 L170,34 L180,84 L190,22 L200,66 L210,60 L300,60';
---

<section class="cap impact" id="capabilities" data-section aria-labelledby="cap-h">
  <div class="cap-pin" data-cap>
    <div class="cap-sticky">
      <div class="wrap cap-head">
        <div>
          <p class="eyebrow">{t.eyebrow}</p>
          <h2 class="d d2 lines" id="cap-h"><span><span>{t.h2[0]}</span></span><span><span style="--i:1" class="grad-text">{t.h2[1]}</span></span></h2>
        </div>
        <p class="lead rv">{t.lead}</p>
      </div>
      <div class="cap-viewport">
        <ol class="cap-track" data-cap-track>
          <li class="cc" style={`--c:${colors[0]}`} data-api-stage="card">
            <div class="cc-top"><span class="cc-n">{num(0)}</span><span class="cc-tag">{t.planned} · {it[0].tag}</span></div>
            <div class="cc-viz viz-gauge" aria-hidden="true">
              <svg viewBox="0 0 200 110"><path class="g-bg" d="M15,100 A85,85 0 0 1 185,100" pathLength="100"></path><path class="g-fg" d="M15,100 A85,85 0 0 1 185,100" pathLength="100"></path></svg>
              <b class="g-n">54</b>
              <div class="g-tiers">{t.tiers.map((x, i) => <span class={i === 1 ? 'on' : undefined}>{x}</span>)}</div>
            </div>
            <h3 class="cc-name">{it[0].name}</h3>
            <p class="cc-desc">{it[0].desc}</p>
          </li>
          <li class="cc" style={`--c:${colors[1]}`} data-api-stage="card">
            <div class="cc-top"><span class="cc-n">{num(1)}</span><span class="cc-tag">{t.planned} · {it[1].tag}</span></div>
            <div class="cc-viz viz-pulse" aria-hidden="true">
              <svg viewBox="0 0 300 100" preserveAspectRatio="none"><path class="p-bg" d={wave}></path><path class="p-fg" pathLength="100" d={wave}></path></svg>
              <div class="p-out"><span>{it[1].today}</span><b>{it[1].out}</b></div>
            </div>
            <h3 class="cc-name">{it[1].name}</h3>
            <p class="cc-desc">{it[1].desc}</p>
          </li>
          <li class="cc" style={`--c:${colors[2]}`} data-api-stage="card">
            <div class="cc-top"><span class="cc-n">{num(2)}</span><span class="cc-tag">{t.planned} · {it[2].tag}</span></div>
            <div class="cc-viz viz-bars" aria-hidden="true">
              <div class="bars"><i style="--h:38%"></i><i style="--h:44%"></i><i style="--h:40%"></i><i style="--h:52%"></i><i style="--h:47%"></i><i style="--h:58%"></i><i class="spike" style="--h:94%"></i></div>
              <span class="flag">{it[2].flag}</span>
            </div>
            <h3 class="cc-name">{it[2].name}</h3>
            <p class="cc-desc">{it[2].desc}</p>
          </li>
          <li class="cc" style={`--c:${colors[3]}`} data-api-stage="card">
            <div class="cc-top"><span class="cc-n">{num(3)}</span><span class="cc-tag">{t.planned} · {it[3].tag}</span></div>
            <div class="cc-viz viz-steps" aria-hidden="true">
              <ol class="steps"><li>1</li><li>2</li><li>3</li><li>4</li><li>5</li></ol>
              <div class="st-out"><span>{it[3].stage}</span><b class="go">{it[3].go}</b></div>
            </div>
            <h3 class="cc-name">{it[3].name}</h3>
            <p class="cc-desc">{it[3].desc}</p>
          </li>
          <li class="cc" style={`--c:${colors[4]}`} data-api-stage="card">
            <div class="cc-top"><span class="cc-n">{num(4)}</span><span class="cc-tag">{t.planned} · {it[4].tag}</span></div>
            <div class="cc-viz viz-queue" aria-hidden="true">
              <ul class="q">{it[4].queue?.map((r, i) => <li style={`--r:${i}`}><i>{r[0]}</i>{r[1]}<span>{r[2]}</span></li>)}</ul>
            </div>
            <h3 class="cc-name">{it[4].name}</h3>
            <p class="cc-desc">{it[4].desc}</p>
          </li>
          <li class="cc" style={`--c:${colors[5]}`} data-api-stage="card">
            <div class="cc-top"><span class="cc-n">{num(5)}</span><span class="cc-tag">{t.planned} · {it[5].tag}</span></div>
            <div class="cc-viz viz-trend" aria-hidden="true">
              <svg viewBox="0 0 300 110" preserveAspectRatio="none"><rect class="t-band" x="0" y="38" width="300" height="30"></rect><path class="t-fg" pathLength="100" d="M0,70 C20,64 30,40 50,46 S80,72 100,60 S130,30 150,40 S180,66 200,52 S240,28 260,36 S290,48 300,44"></path></svg>
              <div class="t-axis">{it[5].months?.map((m) => <span>{m}</span>)}</div>
            </div>
            <h3 class="cc-name">{it[5].name}</h3>
            <p class="cc-desc">{it[5].desc}</p>
          </li>
        </ol>
      </div>
      <div class="wrap cap-foot" aria-hidden="true"><span class="cap-count"><b data-cap-i>01</b> / 06</span><i class="cap-bar"><b></b></i><span class="cap-note">{t.note}</span></div>
    </div>
  </div>
</section>
