---
import { Image } from 'astro:assets';
import wordmark from '../../assets/brand/wordmark-white.png';
import { localePath, useDict, type Locale } from '../../i18n';
import { site } from '../../data/site';
import { appLinks, hrefFor, platformColumns, resourceItems, solutionItems } from '../../data/nav';
import Photo from '../ui/Photo.astro';
import Icon from '../ui/Icon.astro';
import LangSwitch from './LangSwitch.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const t = useDict(locale);
const home = localePath('/', locale);
const appStores: Record<string, { label: string; href: string }[]> = {
  run: [
    { label: t.apps.store.ios, href: site.stores.runIos },
    { label: t.apps.store.android, href: site.stores.runAndroid },
  ],
  fitmg: [
    { label: t.apps.store.android, href: site.stores.fitmgAndroid },
    { label: t.apps.store.iosBeta, href: site.stores.fitmgIosBeta },
  ],
};
---

<div class="nav-scrim" data-nav-scrim></div>
<header class="nav" data-nav>
  <div class="nav__bar">
    <a class="nav__logo" href={home} aria-label={t.a11y.homeLink}>
      <svg class="nav__mark" viewBox="0 0 48 48" fill="none" aria-hidden="true" focusable="false">
        <g class="nav__orbit">
          <ellipse cx="24" cy="24" rx="20" ry="10.5" transform="rotate(-24 24 24)" stroke="#00BEF3" stroke-width="2.4"></ellipse>
          <circle cx="40" cy="9.5" r="3.6" fill="#00BEF3"></circle>
          <circle cx="7.5" cy="31" r="3.6" fill="#8B5CF6"></circle>
          <circle cx="31" cy="37.2" r="3.1" fill="#00BEF3"></circle>
        </g>
        <ellipse cx="24" cy="23" rx="9" ry="5.6" stroke="#fff" stroke-width="4"></ellipse>
      </svg>
      <Image src={wordmark} alt="" width={74} height={22} densities={[1, 2]} format="webp" class="nav__word" loading="eager" />
    </a>

    <nav class="nav__menu" id="nav-menu" aria-label={t.a11y.mainNav} data-nav-menu>
      <ul class="nav__list">
        <li class="nav__item" data-mega-item>
          <button class="nav__trigger" type="button" aria-expanded="false" aria-controls="mega-platform" data-mega-trigger>
            <span>{t.nav.platform}</span><span class="pm" aria-hidden="true"></span>
          </button>
          <div class="mega mega--platform" id="mega-platform" data-mega-panel>
            <div class="mega__body">
              <div class="mega__cols">
                {
                  platformColumns.map((col, i) => (
                    <div class="mega__col" style={`--i:${i}`}>
                      <div class="mega__photo">
                        <Photo slot={col.photo} ratio="16/10" sizes="280px" widths={[280, 560]} locale={locale} />
                      </div>
                      <p class="mega__label">{t.nav.groups[col.key]}</p>
                      <ul>
                        {col.items.map((id) => (
                          <li>
                            <a class="mega__link" href={hrefFor(id, locale)} data-mega-link>
                              <span class="mega__name">{t.nav.items[id].name}</span>
                              <span class="mega__desc">{t.nav.items[id].desc}</span>
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
            </div>
            <div class="mega__foot">
              <span>{t.nav.newToAria}</span>
              <a class="link link-arrow" href={site.signUp} data-mega-link>{t.nav.startFree}<Icon name="arrow-right" size={18} /></a>
            </div>
          </div>
        </li>

        <li class="nav__item" data-mega-item>
          <button class="nav__trigger" type="button" aria-expanded="false" aria-controls="mega-solutions" data-mega-trigger>
            <span>{t.nav.solutions}</span><span class="pm" aria-hidden="true"></span>
          </button>
          <div class="mega mega--solutions" id="mega-solutions" data-mega-panel>
            <div class="mega__body">
              <div class="mega__cols mega__cols--2">
                <div class="mega__col">
                  <p class="mega__label">{t.nav.groups.audiences}</p>
                  <ul>
                    {
                      solutionItems.map((id) => (
                        <li>
                          <a class="mega__link" href={hrefFor(id, locale)} data-mega-link>
                            <span class="mega__name">{t.nav.items[id].name}</span>
                            <span class="mega__desc">{t.nav.items[id].desc}</span>
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
                <div class="mega__col">
                  <p class="mega__label">{t.nav.groups.apps}</p>
                  <ul>
                    {
                      appLinks.map((app) => (
                        <li class="mega__app">
                          <span class="mega__name">{t.nav.apps[app.key].name}</span>
                          <span class="mega__desc">{t.nav.apps[app.key].status}</span>
                          {app.live && (
                            <span class="mega__stores">
                              {appStores[app.key].map((s) => (
                                <a class="link" href={s.href} rel="noopener" data-mega-link>
                                  {s.label}
                                </a>
                              ))}
                            </span>
                          )}
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </div>
            <div class="mega__foot">
              <span>{t.nav.newToAria}</span>
              <a class="link link-arrow" href={site.signUp} data-mega-link>{t.nav.startFree}<Icon name="arrow-right" size={18} /></a>
            </div>
          </div>
        </li>

        <li class="nav__item">
          <a class="nav__link" href={hrefFor('pricing', locale)} aria-current={path === '/pricing/' ? 'page' : undefined}>{t.nav.pricing}</a>
        </li>

        <li class="nav__item" data-mega-item>
          <button class="nav__trigger" type="button" aria-expanded="false" aria-controls="mega-resources" data-mega-trigger>
            <span>{t.nav.resources}</span><span class="pm" aria-hidden="true"></span>
          </button>
          <div class="mega mega--resources" id="mega-resources" data-mega-panel>
            <div class="mega__body">
              <div class="mega__cols mega__cols--1">
                <div class="mega__col">
                  <p class="mega__label">{t.nav.groups.learn}</p>
                  <ul>
                    {
                      resourceItems.map((id) => (
                        <li>
                          <a class="mega__link" href={hrefFor(id, locale)} data-mega-link>
                            <span class="mega__name">{t.nav.items[id].name}</span>
                            <span class="mega__desc">{t.nav.items[id].desc}</span>
                          </a>
                        </li>
                      ))
                    }
                  </ul>
                </div>
              </div>
            </div>
            <div class="mega__foot">
              <span>{t.nav.newToAria}</span>
              <a class="link link-arrow" href={site.signUp} data-mega-link>{t.nav.startFree}<Icon name="arrow-right" size={18} /></a>
            </div>
          </div>
        </li>
      </ul>

      <div class="nav__drawer-extras">
        <a class="btn btn--secondary nav__drawer-signin" href={site.signIn}>{t.nav.signIn}</a>
        <div class="nav__drawer-row">
          <LangSwitch locale={locale} path={path} />
          <ThemeToggle locale={locale} />
        </div>
      </div>
    </nav>

    <div class="nav__actions">
      <a class="nav__signin" href={site.signIn}>{t.nav.signIn}</a>
      <a class="btn btn--primary nav__cta" href={site.signUp}>{t.nav.startFree}</a>
      <span class="nav__bar-only"><LangSwitch locale={locale} path={path} /></span>
      <span class="nav__bar-only"><ThemeToggle locale={locale} /></span>
      <button
        class="nav__burger"
        type="button"
        aria-expanded="false"
        aria-controls="nav-menu"
        aria-label={t.a11y.openMenu}
        data-label-open={t.a11y.openMenu}
        data-label-close={t.a11y.closeMenu}
        data-nav-burger
      >
        <Icon name="menu" size={24} class="nav__burger-open" />
        <Icon name="x" size={24} class="nav__burger-close" />
      </button>
    </div>
  </div>
</header>

<style>
  .nav-scrim {
    position: fixed;
    inset: 0;
    z-index: 90;
    background: var(--scrim);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    opacity: 0;
    transition: opacity 0.2s ease;
    pointer-events: none;
  }
  .nav-scrim[data-on] {
    opacity: 1;
    pointer-events: auto;
  }

  /* The Floodlight bar: a floating glass pill that is dark in both themes. color-scheme: dark makes every
     light-dark() token below resolve to its dark value, so the mega panels and controls follow without overrides. */
  .nav {
    --nav-cur: var(--nav-h);
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 100;
    display: flex;
    justify-content: center;
    padding: 18px var(--gutter) 0;
    color: #fff;
    color-scheme: dark;
    pointer-events: none;
    transition: padding 0.45s var(--e-out);
  }
  :global(html[data-scrolled]) .nav {
    --nav-cur: var(--nav-h-compact);
    padding-top: 12px;
  }
  .nav__bar {
    position: relative;
    display: flex;
    align-items: center;
    gap: 28px;
    width: 100%;
    max-width: var(--maxw);
    height: 64px;
    padding: 0 10px 0 18px;
    pointer-events: auto;
    transition:
      max-width 0.6s var(--e-inout),
      height 0.45s var(--e-out);
  }
  /* The glass lives on a pseudo-element so backdrop-filter does not become the containing block of the
     fixed mobile drawer. Over the home hero it is invisible until the page scrolls. The shadow stays light:
     text resting just below the bar sits in it, and a heavier one pulls small copy under 4.5:1. */
  .nav__bar::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: 22px;
    background: var(--nav-bg);
    -webkit-backdrop-filter: blur(18px) saturate(1.6);
    backdrop-filter: blur(18px) saturate(1.6);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 10px 30px -16px rgb(0 0 0 / 0.35);
    transition:
      opacity 0.45s,
      border-radius 0.45s var(--e-out);
  }
  :global(html:not([data-scrolled]) body[data-hero]) .nav__bar::before {
    opacity: 0;
  }
  :global(html[data-scrolled]) .nav__bar {
    max-width: 1120px;
    height: 56px;
  }
  :global(html[data-scrolled]) .nav__bar::before {
    border-radius: var(--r-pill);
  }
  /* Scroll progress: a gradient line along the bottom of the compact pill; nav.ts sets --progress. */
  .nav__bar::after {
    content: '';
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 0;
    height: 2px;
    border-radius: 2px;
    background: var(--grad-brand);
    transform-origin: 0 50%;
    transform: scaleX(var(--progress, 0));
    opacity: 0;
    transition: opacity 0.3s;
  }
  :global(html[data-scrolled]) .nav__bar::after {
    opacity: 1;
  }
  .nav__logo {
    flex: none;
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 44px;
    line-height: 0;
    border-radius: 12px;
  }
  .nav__mark {
    width: 40px;
    height: 40px;
    flex: none;
    transition: transform 0.6s var(--e-spring);
  }
  .nav__orbit {
    transform-origin: 24px 24px;
    animation: nav-orbit 16s linear infinite;
  }
  @keyframes nav-orbit {
    to {
      transform: rotate(360deg);
    }
  }
  .nav__logo :global(.nav__word) {
    width: 74px;
    height: auto;
    transform-origin: 0 50%;
    transition:
      opacity 0.3s,
      transform 0.45s var(--e-out),
      width 0.45s var(--e-out);
  }
  :global(html[data-scrolled]) .nav__mark {
    transform: rotate(-360deg) scale(0.9);
  }
  :global(html[data-scrolled]) .nav__logo :global(.nav__word) {
    width: 0;
    opacity: 0;
    transform: translateX(-12px) scale(0.9);
  }

  /* While the mobile drawer is open the page behind it does not scroll (nav.ts also marks it inert). */
  :global(html[data-scroll-lock]) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }

  .nav__menu {
    flex: 1;
    min-width: 0;
  }
  .nav__list {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 4px;
  }
  .nav__trigger,
  .nav__link {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 14px;
    border: 0;
    border-radius: var(--r-pill);
    background: none;
    color: rgb(255 255 255 / 0.86);
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 500;
    text-decoration: none;
    cursor: pointer;
    white-space: nowrap;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .nav__trigger:hover,
  .nav__link:hover,
  .nav__trigger[aria-expanded='true'] {
    background: rgb(255 255 255 / 0.1);
    color: #fff;
  }
  .nav__link[aria-current='page']::after {
    content: '';
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 5px;
    height: var(--lane);
    border-radius: 3px;
    background: var(--grad-brand);
  }
  .pm {
    position: relative;
    display: inline-block;
    width: 11px;
    height: 11px;
    color: var(--ink-2);
  }
  .pm::before,
  .pm::after {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 100%;
    height: 1.5px;
    margin-top: -0.75px;
    background: currentColor;
    transition: transform 0.2s var(--ease-out);
  }
  .pm::after {
    transform: rotate(90deg);
  }
  [aria-expanded='true'] > .pm::after {
    transform: rotate(0deg);
  }

  .nav__actions {
    flex: none;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav__signin {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 12px;
    border-radius: var(--r-pill);
    color: rgb(255 255 255 / 0.86);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    transition:
      background-color 0.2s,
      color 0.2s;
  }
  .nav__signin:hover {
    background: rgb(255 255 255 / 0.1);
    color: #fff;
  }
  .nav__cta {
    min-height: 44px;
    padding: 0 20px;
    font-size: 14px;
  }
  .nav__bar-only {
    display: contents;
  }
  .nav__burger {
    display: none;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 0;
    border-radius: 50%;
    background: rgb(255 255 255 / 0.1);
    color: #fff;
    cursor: pointer;
  }
  .nav__burger :global(.nav__burger-close) {
    display: none;
  }
  .nav__burger[aria-expanded='true'] :global(.nav__burger-open) {
    display: none;
  }
  .nav__burger[aria-expanded='true'] :global(.nav__burger-close) {
    display: block;
  }
  .nav__drawer-extras {
    display: none;
  }

  /* Mega panels (desktop): dark glass, 28px radius. They sit under the bar, which is their positioning context. */
  .mega {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    width: min(1200px, calc(100vw - 2 * var(--gutter)));
    display: flex;
    flex-direction: column;
    /* Fits the space under the fixed header: the columns scroll, the footer CTA stays in view. */
    max-height: calc(100vh - var(--nav-cur) - 22px);
    max-height: calc(100dvh - var(--nav-cur) - 22px);
    border: 0;
    border-radius: 28px;
    background: rgb(5 11 26 / 0.94);
    -webkit-backdrop-filter: blur(24px);
    backdrop-filter: blur(24px);
    box-shadow:
      0 0 0 1px rgb(255 255 255 / 0.08),
      0 40px 100px -20px rgb(0 0 0 / 0.7);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: translate(-50%, -10px) scale(0.985);
    transform-origin: 50% 0;
    transition:
      opacity 0.22s var(--e-out),
      transform 0.32s var(--e-out),
      visibility 0s linear 0.32s;
  }
  .mega::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: -16px;
    height: 16px;
  }
  .mega[data-open] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0);
    transition:
      opacity 0.22s var(--e-out),
      transform 0.32s var(--e-out),
      visibility 0s;
  }
  .mega--solutions {
    width: min(760px, calc(100vw - 2 * var(--gutter)));
  }
  .mega--resources {
    width: 400px;
  }
  .mega__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    scrollbar-width: thin;
    padding: 22px 22px 14px;
    border-radius: 28px 28px 0 0;
  }
  .mega__cols {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
  }
  .mega__cols--2 {
    grid-template-columns: repeat(2, 1fr);
  }
  .mega__cols--1 {
    grid-template-columns: 1fr;
  }
  .mega__col {
    padding: 12px;
    border-radius: 20px;
    background: rgb(255 255 255 / 0.03);
    transition: background-color 0.2s;
  }
  .mega__col:hover {
    background: rgb(255 255 255 / 0.07);
  }
  .mega__photo {
    overflow: hidden;
    border-radius: 14px;
    margin-bottom: 14px;
    opacity: 0;
    transition: opacity 0.25s ease calc(var(--i, 0) * 40ms);
  }
  .mega[data-open] .mega__photo {
    opacity: 1;
  }
  .mega__label {
    margin-bottom: 8px;
    color: var(--ink-3);
    font-size: 12px;
    line-height: 16px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .mega__link,
  .mega__app {
    display: flex;
    flex-direction: column;
    gap: 2px;
    padding: 9px 10px;
    margin-inline: -10px;
    border-radius: var(--radius-ctl);
    text-decoration: none;
    color: var(--ink);
  }
  .mega__link {
    min-height: 44px;
  }
  .mega__link:hover,
  .mega__link:focus-visible {
    background: rgb(255 255 255 / 0.08);
  }
  .mega__name {
    font-size: 14px;
    line-height: 20px;
    font-weight: 600;
    color: var(--ink);
  }
  .mega__desc {
    font-size: 13px;
    line-height: 18px;
    color: #a9b4c6;
  }
  .mega__stores {
    display: flex;
    gap: 16px;
    margin-top: 4px;
  }
  .mega__stores :global(.link) {
    display: inline-flex;
    align-items: center;
    min-height: 32px;
    font-size: 14px;
  }
  .mega__foot {
    flex: none;
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 22px 22px;
    padding: 6px 16px;
    border-radius: 16px;
    background: linear-gradient(90deg, rgb(0 190 243 / 0.14), rgb(139 92 246 / 0.14));
    color: #fff;
    font-size: 14px;
  }
  .mega__foot :global(.link) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
  }

  /* Desktop bar (the longest labels are Spanish: Plataforma, Soluciones, Iniciar sesión, Empieza gratis).
     From 1280px the bar fits with room to spare, so the wordmark stays; below 1280px the drawer takes over.
     nav.ts matches the same 1280px edge. evidence.mjs measures the bar every 5px from 1025 to 1440 in EN and ES,
     so a longer label that no longer fits fails the check. */
  @media (min-width: 1280px) {
    .nav__menu {
      min-width: max-content;
    }
  }
  @media (min-width: 1280px) and (max-width: 1439.98px) {
    .nav__bar {
      gap: 16px;
    }
    .nav__trigger,
    .nav__link {
      padding: 0 12px;
    }
  }

  /* Mobile: the same markup becomes a full-height drawer with accordion groups. */
  @media (max-width: 1279.98px) {
    .nav__burger {
      display: grid;
    }
    .nav__bar {
      justify-content: space-between;
    }
    .nav__signin,
    .nav__bar-only {
      display: none;
    }
    .nav__cta {
      min-height: 44px;
      padding: 0 16px;
      font-size: 14px;
    }
    /* The bar's own controls stay above the full-screen drawer. */
    .nav__logo,
    .nav__actions {
      position: relative;
      z-index: 100;
    }
    .nav[data-menu-open] .nav__bar::before {
      opacity: 0;
    }
    .nav__menu {
      position: fixed;
      inset: 0;
      z-index: 99;
      display: none;
      flex: none;
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: calc(var(--nav-cur) + 8px) max(var(--gutter), calc((100vw - 640px) / 2)) 32px;
      background: var(--night);
    }
    .nav[data-menu-open] .nav__menu {
      display: block;
    }
    .nav__list {
      display: block;
    }
    .nav__item {
      border-bottom: 1px solid var(--line);
    }
    .nav__trigger,
    .nav__link {
      width: 100%;
      justify-content: space-between;
      min-height: 56px;
      padding: 0 4px;
      font-family: var(--f-display);
      font-size: 30px;
      font-weight: 900;
      font-stretch: 62%;
      text-transform: uppercase;
      letter-spacing: 0;
      border-radius: 0;
    }
    .nav__trigger:hover,
    .nav__link:hover,
    .nav__trigger[aria-expanded='true'] {
      background: none;
    }
    .nav__link[aria-current='page']::after {
      left: 4px;
      right: auto;
      width: 40px;
      bottom: 6px;
    }
    .mega,
    .mega--solutions,
    .mega--resources {
      position: static;
      display: none;
      width: auto;
      max-height: none;
      padding: 0 0 12px;
      border: 0;
      border-radius: 0;
      background: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
      box-shadow: none;
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
      transform: none;
      transition: none;
    }
    .mega[data-open] {
      display: block;
      transform: none;
    }
    .mega__body {
      overflow: visible;
      padding: 0;
      border-radius: 0;
    }
    .mega::before,
    .mega__photo {
      display: none;
    }
    .mega__cols,
