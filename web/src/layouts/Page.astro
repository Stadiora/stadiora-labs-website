---
// Wrapper for the solutions, resources and company pages: the shared base plus the page-level styles.
import '../styles/pages.css';
import Base from './Base.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  path: string;
  title: string;
  description: string;
  noindex?: boolean;
}
const props = Astro.props;
---

<Base {...props}>
  <slot />
</Base>
