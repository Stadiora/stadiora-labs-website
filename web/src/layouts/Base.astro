---
import '../styles/global.css';
import archivoUrl from '../assets/fonts/archivo-var.woff2?url';
import interUrl from '../assets/fonts/inter-var.woff2?url';
import { localePath, locales, useDict, type Locale } from '../i18n';
import { site } from '../data/site';
import Nav from '../components/layout/Nav.astro';
import Footer from '../components/layout/Footer.astro';

interface Props {
  locale: Locale;
  /** Path without a locale prefix, e.g. `/`. */
  path: string;
  title?: string;
  description?: string;
  ogImage?: string;
  /** Keeps the page out of search results. Case-study pages use it until a real story ships. */
  noindex?: boolean;
  /** Full-bleed dark hero under the floating nav (the home page): the page gets no top padding. */
  hero?: boolean;
  /** No canonical, hreflang or og:url: the 404 page answers many URLs, so it has no address of its own. */
  bare?: boolean;
  /** Languages this page exists in. The legal pages are English only, so they get no `es` alternate. */
  langs?: readonly Locale[];
}

const { locale, path, title, description, ogImage, noindex = false, hero = false, bare = false, langs = locales } = Astro.props;
const t = useDict(locale);
const pageTitle = title ?? t.meta.title;
const pageDescription = description ?? t.meta.description;
const abs = (p: string) => new URL(p, site.origin).toString();
const canonical = abs(localePath(path, locale));
const alternates = langs.map((l) => ({ lang: l, href: abs(localePath(path, l)) }));
// One OG card per page type and language (scripts/og.mjs): the first path segment picks the type.
const ogType = path === '/' ? 'home' : (({ platform: 'platform', solutions: 'solutions', pricing: 'pricing' }) as Record<string, string>)[path.split('/')[1]] ?? 'company';
const image = abs(ogImage ?? `/og/${ogType}-${locale}.png`);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.origin,
  logo: abs('/logos/stadiora-labs.png'),
  sameAs: [site.linkedin],
  contactPoint: Object.entries(site.contacts).map(([region, contact]) => ({
    '@type': 'ContactPoint',
    contactType: 'sales',
    name: contact.name,
    email: contact.email,
    telephone: contact.tel,
    areaServed: region === 'us' ? 'US' : 'Latin America',
    availableLanguage: ['en', 'es'],
  })),
};
---

<!doctype html>
<html lang={locale} data-locale={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <meta name="color-scheme" content="light dark" />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {!bare && <link rel="canonical" href={canonical} />}
    {!bare && alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={a.href} />)}
    {!bare && <link rel="alternate" hreflang="x-default" href={alternates[0].href} />}

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    {!bare && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={t.meta.ogImageAlt} />
    <meta property="og:locale" content={t.meta.locale} />
    {langs.filter((l) => l !== locale).map((l) => <meta property="og:locale:alternate" content={useDict(l).meta.locale} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={t.meta.ogImageAlt} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="preload" href={archivoUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interUrl} as="font" type="font/woff2" crossorigin />

    <!-- Sets html.js and the theme before first paint, so there is no flash. -->
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var t = null;
        try {
          t = localStorage.getItem('theme');
        } catch (e) {}
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        d.setAttribute('data-theme', t);
      })();
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-hero={hero ? '' : undefined}>
    <a class="skip-link" href="#main">{t.a11y.skip}</a>
    <Nav locale={locale} path={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer locale={locale} path={path} />
    <script>
      import '../scripts/theme';
      import '../scripts/reveal';
    </script>
  </body>
</html>
